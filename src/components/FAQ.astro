---
/**
 * FAQ.astro — Accessible accordion FAQ
 * Uses native <details>/<summary> — zero JS, works without JavaScript
 * Matches FAQPage schema structure exactly
 */
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = 'Frequently Asked Questions' } = Astro.props;

const PlusIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
  stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>`;
---

<section class="faq-section" aria-label="Frequently asked questions">
  <h2>{title}</h2>
  {items.map((item, i) => (
    <details class="faq-item" open={i === 0}>
      <summary class="faq-question">
        <span>{item.q}</span>
        <span class="faq-icon"><Fragment set:html={PlusIcon} /></span>
      </summary>
      <div class="faq-answer">
        <p set:html={item.a} />
      </div>
    </details>
  ))}
</section>
