---
/**
 * Base.astro — Master layout
 * Every page passes: title, description, slug, schema (array of JSON-LD objects),
 * citationSentence, pageType ('calculator' | 'home' | 'article')
 */
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  slug: string;
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  slug,
  schema = [],
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

const navItems = [
  { href: 'marketing-roi-calculator', label: 'ROI Calc', icon: 'trend' },
  { href: 'marketing-budget-calculator', label: 'Budget', icon: 'card' },
  { href: 'conversion-rate-calculator', label: 'Conversion', icon: 'refresh' },
  { href: 'email-marketing-roi-calculator', label: 'Email ROI', icon: 'mail' },
  { href: 'marketing-salary-calculator', label: 'Salary', icon: 'briefcase' },
];

const iconSvgs = {
  trend: '<polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="14 7 21 7 21 14"></polyline>',
  card: '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line>',
  refresh: '<polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>',
  mail: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22 6 12 13 2 6"></polyline>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>',
};

const siteUrl   = 'https://freemarketingcalculator.com'; // ← replace before deploy
const canonical = `${siteUrl}/${slug ? slug + '/' : ''}`;
const ogUrl     = canonical;

// Merge Organisation schema into every page's JSON-LD array
const orgSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#org`,
  "name": "Free Marketing Calculators",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/logo.svg`
  },
  "description": "Free marketing calculators for ROI, budget, salary, conversion rate, and more.",
  "sameAs": [
    "https://www.linkedin.com/company/marketcalcs",
    "https://twitter.com/marketcalcs"
  ]
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "Free Marketing Calculators",
  "url": siteUrl,
  "publisher": { "@id": `${siteUrl}/#org` }
};

const fullSchema = {
  "@context": "https://schema.org",
  "@graph": [orgSchema, websiteSchema, ...schema]
};

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="Dbj3G7byAbkR1vo2xlW2YY8mhTy-BuOJ0TAEyNlIxB8" />
  <!-- Bing Webmaster Tools verification -->
  <meta name="msvalidate.01" content="B0B744590B03AB0EF8CBFEC64AEBE8AC" />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="Free Marketing Calculators" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />

  <!-- Inter font — self-hosted subset for performance (swap to avoid FOIT) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" /></noscript>

  <!-- Global styles injected via Astro import in frontmatter -->

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- AdSense: add script here after approval -->
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HRKELF4XYB"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HRKELF4XYB');
  </script>
</head>

<body>
  <div class="page-wrap">

    <!-- ===== SITE HEADER ===== -->
    <header class="site-header" role="banner" id="site-top">
      <div class="container">
        <a href="/" class="site-logo" aria-label="Free Marketing Calculators home">
          <!-- Checkmark growth-line mark -->
          <svg width="28" height="28" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0">
            <rect width="40" height="40" rx="9" fill="#E0A02B"/>
            <path d="M9 27 L16 18 L21 22 L31 10" stroke="#12141C" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="31" cy="10" r="2.4" fill="#12141C"/>
          </svg>
          <span class="logo-text">Free<span class="logo-accent">Marketing</span>Calc</span>
        </a>
        <nav aria-label="Main navigation" class="site-nav-wrap">
          <ul class="site-nav">
            {navItems.map(item => (
              <li class={slug === item.href ? 'is-active' : ''}>
                <a href={`/${item.href}/`} aria-current={slug === item.href ? 'page' : undefined}>
                  <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconSvgs[item.icon]}></svg>
                  <span class="nav-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/marketing-roi-calculator/" class="btn-nav-cta">Try ROI Calculator</a>
          <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span></span><span></span><span></span>
          </button>
        </nav>

        <!-- Mobile menu drawer -->
        <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
          <ul class="mobile-nav">
            <li><a href="/">🏠 All Calculators</a></li>
            <li><a href="/marketing-roi-calculator/">📈 ROI / ROMI Calculator</a></li>
            <li><a href="/marketing-budget-calculator/">💰 Budget Calculator</a></li>
            <li><a href="/conversion-rate-calculator/">🔄 Conversion Rate Calculator</a></li>
            <li><a href="/email-marketing-roi-calculator/">✉️ Email ROI Calculator</a></li>
            <li><a href="/social-media-budget-calculator/">📱 Social Media Budget</a></li>
            <li><a href="/digital-marketing-calculator/">📊 Digital Marketing Metrics</a></li>
            <li><a href="/roas-calculator/">📣 ROAS Calculator</a></li>
            <li><a href="/cac-calculator/">🎯 CAC Calculator</a></li>
            <li><a href="/marketing-salary-calculator/">🏆 Salary Calculator</a></li>
            <li><a href="/marketing-agency-valuation-calculator/">🏢 Agency Valuation</a></li>
            <li><a href="/marketing-automation-roi-calculator/">⚡ Automation ROI</a></li>
            <li><a href="/inbound-marketing-calculator/">🎯 Inbound Marketing</a></li>
            <li class="mobile-nav__divider"></li>
            <li><a href="/blog/">📖 Blog & Guides</a></li>
            <li><a href="/marketing-budget-benchmarks/">📊 2026 Benchmarks</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ===== SITE FOOTER ===== -->
    <footer class="site-footer" role="contentinfo">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-logo" aria-label="Free Marketing Calculators home">
              <svg width="22" height="22" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0">
                <rect width="40" height="40" rx="9" fill="#E0A02B"/>
                <path d="M9 27 L16 18 L21 22 L31 10" stroke="#12141C" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
              <span class="logo-text">Free<span class="logo-accent">Marketing</span>Calc</span>
            </a>
            <p class="footer-blurb">15 free marketing calculators. No signup, no email gate, updated for 2026.</p>
            <div class="footer-social">
              <a href={orgSchema.sameAs[0]} aria-label="LinkedIn" rel="noopener" target="_blank">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
              <a href={orgSchema.sameAs[1]} aria-label="X (Twitter)" rel="noopener" target="_blank">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
              </a>
            </div>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Calculators</p>
            <ul class="footer-links">
              <li><a href="/marketing-roi-calculator/">ROI Calculator</a></li>
              <li><a href="/roas-calculator/">ROAS Calculator</a></li>
              <li><a href="/cac-calculator/">CAC Calculator</a></li>
              <li><a href="/marketing-budget-calculator/">Budget Calculator</a></li>
              <li><a href="/">View all 15 →</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Company</p>
            <ul class="footer-links">
              <li><a href="/about/">About</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/marketing-budget-benchmarks/">2026 Benchmarks</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Legal</p>
            <ul class="footer-links">
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/sitemap-index.xml">Sitemap</a></li>
              <li><a href="/llms.txt" class="footer-llms">llms.txt</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>
            &copy; {new Date().getFullYear()} Free Marketing Calculators &mdash;
            Free marketing calculators, no signup required. Not financial advice.
          </p>
          <a href="#site-top" class="footer-back-to-top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <!-- Toast notification container -->
    <div id="toast-root" class="toast-notification" aria-live="polite"></div>
  </div>

<script>
(function () {
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('mobile-menu');
  if (!toggle || !menu) return;

  function openMenu() {
    menu.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    menu.setAttribute('aria-hidden', 'false');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    menu.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    menu.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('menu-open');
  }

  toggle.addEventListener('click', () => {
    toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
  });

  // Close on nav link click
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  // Close on Escape key
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeMenu();
  });
})();
</script>
</body>
</html>
