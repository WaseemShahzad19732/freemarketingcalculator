---
/**
 * Base.astro — Master layout
 * Every page passes: title, description, slug, schema (array of JSON-LD objects).
 * Header, mobile menu and footer are built from src/data/calculators.js so the
 * calculator list lives in one place.
 */
import '../styles/global.css';
import { categories, catIcons, calculatorCount } from '../data/calculators.js';

interface Props {
  title: string;
  description: string;
  slug: string;
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  slug,
  schema = [],
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

// Page kind drives container width in CSS (tool pages 1040px, everything else 1200px)
const kind =
  slug === '' ? 'home'
  : slug === 'blog' ? 'listing'
  : slug.startsWith('blog/') ? 'article'
  : (slug === 'about' || slug === 'privacy-policy') ? 'doc'
  : 'tool';

const inGuides = slug === 'blog' || slug.startsWith('blog/') || slug === 'marketing-budget-benchmarks';

// Visible breadcrumb mirrors the page's BreadcrumbList schema (when it has one)
const crumbSchema: any = (schema as any[]).find((s) => s && s['@type'] === 'BreadcrumbList');
const crumbs = (crumbSchema?.itemListElement ?? []).map((c: any) => ({
  name: c.name as string,
  path: (() => { try { return new URL(c.item).pathname; } catch { return '/'; } })(),
}));

const siteUrl   = 'https://freemarketingcalculator.com';
const canonical = `${siteUrl}/${slug ? slug + '/' : ''}`;
const ogUrl     = canonical;

// Merge Organisation schema into every page's JSON-LD array
const orgSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#org`,
  "name": "Free Marketing Calculators",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/logo.svg`
  },
  "description": "Free marketing calculators for ROI, budget, salary, conversion rate, and more.",
  "sameAs": [
    "https://www.linkedin.com/company/marketcalcs",
    "https://twitter.com/marketcalcs"
  ]
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "Free Marketing Calculators",
  "url": siteUrl,
  "publisher": { "@id": `${siteUrl}/#org` }
};

const fullSchema = {
  "@context": "https://schema.org",
  "@graph": [orgSchema, websiteSchema, ...schema]
};

const fontHref = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="Dbj3G7byAbkR1vo2xlW2YY8mhTy-BuOJ0TAEyNlIxB8" />
  <!-- Bing Webmaster Tools verification -->
  <meta name="msvalidate.01" content="B0B744590B03AB0EF8CBFEC64AEBE8AC" />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:site_name" content="Free Marketing Calculators" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- JSON-LD structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />

  <!-- Inter is the only webfont (non-render-blocking, swap to avoid invisible text) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={fontHref} />
  <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={fontHref} /></noscript>

  <!-- Global styles injected via Astro import in frontmatter -->

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- AdSense: add script here after approval -->
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HRKELF4XYB"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HRKELF4XYB');
  </script>
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="page-wrap">

    <!-- ===== SITE HEADER ===== -->
    <header class="site-header" role="banner" id="site-top">
      <div class="site-header__bar">
        <a href="/" class="site-logo" aria-label="Free Marketing Calculators home">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#0F1F38"></rect><rect x="8" y="17" width="4" height="7" rx="1" fill="#00C4B3"></rect><rect x="14" y="12" width="4" height="12" rx="1" fill="#00C4B3"></rect><rect x="20" y="7" width="4" height="17" rx="1" fill="#fff"></rect></svg>
          <span>FreeMarketing<span class="logo-accent">Calc</span></span>
        </a>

        <!-- Desktop navigation (hidden below 1024px) -->
        <nav class="nav-desktop" aria-label="Main navigation">
          <details class="mega" id="mega">
            <summary class="nav-btn">
              Calculators
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <div class="mega__panel">
              <div class="mega__grid">
                {categories.map(cat => (
                  <div>
                    <div class="mega__head">
                      <span class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={catIcons[cat.icon]}></path></svg></span>
                      <span class="mega__label">{cat.navName}</span>
                    </div>
                    <ul class="mega__list">
                      {cat.tools.map(tool => (
                        <li>
                          <a class="mega__link" href={tool.href} aria-current={slug === tool.href.replace(/\//g, '') ? 'page' : undefined}>
                            <span class="mega__name">{tool.name.replace(' Calculator', '')}</span>
                            <span class="mega__desc">{tool.navDesc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="mega__foot">
                <div class="mega__foot-inner">
                  <span>Each calculator shows its formula and labels its benchmarks.</span>
                  <a href="/blog/">Read the guides →</a>
                </div>
              </div>
            </div>
          </details>
          <a class="nav-btn" href="/blog/" aria-current={inGuides ? 'page' : undefined}>Guides</a>
          <a class="nav-btn" href="/about/" aria-current={slug === 'about' ? 'page' : undefined}>About</a>
        </nav>
        <a href="/" class="btn-nav-cta">All {calculatorCount} calculators</a>

        <!-- Mobile menu (below 1024px): native details, works without JavaScript -->
        <details class="mnav" id="mnav">
          <summary class="mnav__toggle" aria-label="Menu">
            <svg class="ico-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <svg class="ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </summary>
          <nav class="mnav__panel" aria-label="Mobile navigation">
            <p class="mnav__kicker">Calculators</p>
            {categories.map((cat, i) => (
              <details class="mnav__group" open={i === 0}>
                <summary>
                  <span class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={catIcons[cat.icon]}></path></svg></span>
                  <span class="grow">{cat.navName}</span>
                  <span class="count">{cat.tools.length}</span>
                  <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </summary>
                <ul class="mnav__links">
                  {cat.tools.map(tool => (
                    <li><a href={tool.href}>{tool.name.replace(' Calculator', '')}</a></li>
                  ))}
                </ul>
              </details>
            ))}
            <a class="mnav__link" href="/blog/">Guides</a>
            <a class="mnav__link" href="/marketing-budget-benchmarks/">2026 Benchmarks</a>
            <a class="mnav__link" href="/about/">About</a>
            <a class="mnav__cta" href="/">Browse all {calculatorCount} calculators</a>
            <p class="mnav__note">Free · No signup · Formulas shown</p>
          </nav>
        </details>
      </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="main-content" data-kind={kind}>
      {crumbs.length > 1 && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="container">
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1
                  ? <a href={c.path}>{c.name}</a>
                  : <span aria-current="page">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <!-- ===== SITE FOOTER ===== -->
    <footer class="site-footer" role="contentinfo">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="footer-logo" aria-label="Free Marketing Calculators home">
              <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#00C4B3"></rect><rect x="8" y="17" width="4" height="7" rx="1" fill="#0F1F38"></rect><rect x="14" y="12" width="4" height="12" rx="1" fill="#0F1F38"></rect><rect x="20" y="7" width="4" height="17" rx="1" fill="#0F1F38"></rect></svg>
              <span>FreeMarketing<span class="logo-accent">Calc</span></span>
            </a>
            <p class="footer-blurb">{calculatorCount} free marketing calculators. No signup, no email gate, updated for 2026.</p>
            <div class="footer-social">
              <a href={orgSchema.sameAs[0]} aria-label="LinkedIn" rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
              <a href={orgSchema.sameAs[1]} aria-label="X (Twitter)" rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
              </a>
            </div>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Calculators</p>
            <ul class="footer-links">
              <li><a href="/marketing-roi-calculator/">ROI Calculator</a></li>
              <li><a href="/roas-calculator/">ROAS Calculator</a></li>
              <li><a href="/cac-calculator/">CAC Calculator</a></li>
              <li><a href="/marketing-budget-calculator/">Budget Calculator</a></li>
              <li><a href="/">View all {calculatorCount} →</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Guides</p>
            <ul class="footer-links">
              <li><a href="/marketing-budget-benchmarks/">2026 Benchmarks</a></li>
              <li><a href="/blog/what-is-a-good-marketing-roi/">Good Marketing ROI</a></li>
              <li><a href="/blog/what-is-cpm/">What Is CPM?</a></li>
              <li><a href="/blog/">All guides</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <p class="footer-col__title">Company</p>
            <ul class="footer-links">
              <li><a href="/about/">About</a></li>
              <li><a href="/privacy-policy/">Privacy Policy</a></li>
              <li><a href="/sitemap-index.xml">Sitemap</a></li>
              <li><a href="/llms.txt" class="footer-llms">llms.txt</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>
            &copy; {new Date().getFullYear()} Free Marketing Calculators &mdash;
            Results are estimates for planning, not financial advice.
          </p>
          <a href="#site-top" class="footer-back-to-top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <!-- Toast notification container -->
    <div id="toast-root" class="toast-notification" aria-live="polite"></div>
  </div>

<script>
(function () {
  const mega = document.getElementById('mega');
  const mnav = document.getElementById('mnav');

  // Menus are native <details>; this only adds close-on-outside-click and Escape.
  document.addEventListener('click', (e) => {
    if (mega && mega.open && !mega.contains(e.target)) mega.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    [mega, mnav].forEach((d) => {
      if (d && d.open) { d.open = false; const s = d.querySelector('summary'); if (s) s.focus(); }
    });
  });
  if (mnav && mega) {
    mnav.addEventListener('toggle', () => { if (mnav.open) mega.open = false; });
  }
  // Menu is hidden at desktop widths: make sure it is not left open (it would lock scrolling)
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => {
    if (m.matches && mnav) mnav.open = false;
  });

  // Scrollable tables need to be keyboard-focusable (WCAG 2.1.1)
  function markScrollableTables() {
    document.querySelectorAll('.bench-table-wrap').forEach((el) => {
      const scrolls = el.scrollWidth > el.clientWidth + 1;
      if (scrolls) {
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'region');
        if (!el.hasAttribute('aria-label')) {
          const h = el.closest('section')?.querySelector('h2');
          el.setAttribute('aria-label', (h ? h.textContent.trim() + ' table' : 'Data table') + ' (scrollable)');
        }
      } else if (el.getAttribute('role') === 'region') {
        el.removeAttribute('tabindex'); el.removeAttribute('role');
      }
    });
  }
  markScrollableTables();
  window.addEventListener('resize', markScrollableTables);
})();
</script>
</body>
</html>
