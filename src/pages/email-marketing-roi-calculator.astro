---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'email-marketing-roi-calculator';
const title       = 'Email Marketing ROI Calculator — Free Tool 2026';
const description = 'Calculate email marketing ROI from list size, open rate, click rate, conversion rate, and platform cost. Includes 2026 benchmarks. Free, no signup.';

const platforms = [
  { name: 'Mailchimp',      cost1k: 11, cost5k: 50,  cost10k: 75 },
  { name: 'Klaviyo',        cost1k: 20, cost5k: 60,  cost10k: 100 },
  { name: 'ActiveCampaign', cost1k: 15, cost5k: 49,  cost10k: 79 },
  { name: 'Brevo',          cost1k: 9,  cost5k: 25,  cost10k: 65 },
  { name: 'Constant Contact', cost1k: 12, cost5k: 45, cost10k: 80 },
];

const faqItems = [
  { q: 'What is a good email marketing ROI?', a: 'Email marketing ROI is widely quoted at $36–$42 for every $1 spent, a 3,600–4,200% return. Primary sources checked include Litmus (38:1 in 2018) and the DMA (£42 per £1 in 2019). These are survey-based figures from marketers who measure ROI, so use them as a reference rather than a target.' },
  { q: 'How do I calculate email marketing ROI?', a: 'Email ROI = (Revenue from emails − Email marketing cost) ÷ Email marketing cost × 100. Count platform cost, creative, copywriting and staff time in the cost. Attribute revenue with UTM parameters so the revenue figure comes from tracked email clicks.' },
  { q: 'What is a good email open rate?', a: 'Mailchimp reports an average open rate of 35.63% and a click rate of 2.62% across all users, as of December 2023. Industry averages for opens range from 29.81% for ecommerce to 40.55% for government. Apple Mail Privacy Protection inflates opens, so click rate is a more reliable engagement metric.' },
  { q: 'How do I improve email marketing ROI?', a: 'Segment the list by behaviour and purchase history, clean inactive subscribers regularly, and automate triggered sequences such as welcome, abandoned cart and re-engagement emails. Test subject lines and send times on a portion of the list first. Judge tests by clicks and revenue rather than opens.' },
  { q: 'Why is my email ROI so high or so low?', a: 'A very high ROI usually means only the platform fee was counted as cost. A low ROI usually means a small or unengaged list, weak offers or revenue that is not attributed to email. The worked examples below show the same campaign at 1,550% on platform cost alone and 27% on fully loaded cost.' },
  { q: 'What do I enter for click rate in this calculator?', a: 'The calculator multiplies open rate by click rate, so click rate should be the share of openers who click (click-to-open rate). Mailchimp\'s all-user averages of 35.63% opens and 2.62% clicks per delivered email imply a click-to-open rate of about 7.4%. Using clicks per delivered email in this field understates revenue.' },
  { q: 'Is this calculator free?', a: 'Yes. The calculator is completely free, with no signup and no email required.' },
];

const webAppSchema = { "@type": "WebApplication", "name": title, "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/email-marketing-roi-calculator/", "description": "Computes email marketing ROMI from list size, send frequency, open rate, click rate, conversion rate, and monthly platform cost with 2026 benchmarks.", "featureList": ["Email ROMI calculation", "Platform cost comparison", "2026 benchmarks"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" }, { "@type": "ListItem", "position": 2, "name": "Email Marketing ROI Calculator", "item": "https://freemarketingcalculator.com/email-marketing-roi-calculator/" }] };
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your email list size and number of sends per month." },
{ "@type": "HowToStep", "position": 2, "text": "Enter your open rate and click rate." },
{ "@type": "HowToStep", "position": 3, "text": "Enter conversion rate of clicks, average order value, and monthly platform cost." },
{ "@type": "HowToStep", "position": 4, "text": "Click Calculate \u2014 your monthly revenue, conversions, and full ROMI appear." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Email Marketing ROI Calculator</h1>
      <p class="citation">Email marketing ROI equals (revenue − cost) ÷ cost × 100. This calculator computes it from list size, send frequency, open rate, click rate, conversion rate and monthly platform cost, with benchmarks and a platform cost comparison.</p>
      <div class="meta-badges">
        <span class="badge">✓ Full ROMI calculation</span>
        <span class="badge">✓ Platform cost included</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div><div class="calc-card__title">Email Marketing ROI Calculator</div><div class="calc-card__subtitle">Enter your email campaign metrics</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field-group">
          <div class="field"><label for="em-listsize">Email List Size</label><input type="number" id="em-listsize" placeholder="e.g. 5000" min="0"/></div>
          <div class="field"><label for="em-sends">Sends per Month</label><input type="number" id="em-sends" placeholder="e.g. 4" min="1"/></div>
          <div class="field"><label for="em-openrate">Open Rate (%)</label><div class="input-wrap"><input type="number" id="em-openrate" class="has-suffix" placeholder="e.g. 22" min="0" max="100" step="0.1"/><span class="input-suffix">%</span></div></div>
          <div class="field"><label for="em-ctr">Click Rate (% of opens)</label><div class="input-wrap"><input type="number" id="em-ctr" class="has-suffix" placeholder="e.g. 2.5" min="0" max="100" step="0.1"/><span class="input-suffix">%</span></div><p class="hint">Clicks ÷ opens (click-to-open rate)</p></div>
          <div class="field"><label for="em-cvr">Conversion Rate of Clicks (%)</label><div class="input-wrap"><input type="number" id="em-cvr" class="has-suffix" placeholder="e.g. 5" min="0" max="100" step="0.1"/><span class="input-suffix">%</span></div></div>
          <div class="field"><label for="em-aov">Average Order Value ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="em-aov" class="has-prefix" placeholder="e.g. 150" min="0"/></div></div>
          <div class="field"><label for="em-cost">Monthly Platform Cost ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="em-cost" class="has-prefix" placeholder="e.g. 50" min="0"/></div></div>
        </div>
        <button class="btn-calc" id="em-calc-btn" type="button">Calculate Email ROI</button>
        <div class="result-panel" id="em-result" aria-live="polite">
          <div class="result-panel__label">Email Marketing ROI (ROMI)</div>
          <div class="result-panel__primary" id="em-primary">0%</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="em-revenue">$0</span><span class="result-panel__stat-label">Monthly revenue</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="em-conversions">0</span><span class="result-panel__stat-label">Conversions/mo</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="em-per-sub">$0</span><span class="result-panel__stat-label">Revenue/subscriber</span></div>
          </div>
          <div class="result-verdict" id="em-verdict"></div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">Formula</div>
      <p><strong>Email ROMI = (Monthly Revenue − Platform Cost) ÷ Platform Cost × 100</strong><br/>
      Monthly Revenue = List Size × Sends × Open Rate × Click Rate × Conversion Rate × AOV<br/>
      Widely quoted benchmark: $36–$42 return per $1 spent (Litmus reported 38:1 in 2018)</p>
    </div>

    <section class="bench-section">
      <h2>Email Platform Cost Comparison — 2026</h2>
      <span class="bench-date">Updated October 2026</span>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th>Platform</th><th>~1K subscribers</th><th>~5K subscribers</th><th>~10K subscribers</th></tr></thead>
          <tbody>
            {platforms.map(p => (<tr><td>{p.name}</td><td>${p.cost1k}/mo</td><td>${p.cost5k}/mo</td><td>${p.cost10k}/mo</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="bench-source">Approximate pricing based on standard plans. Prices change — verify on each platform's site.</p>
    </section>


    <!-- TASK 23: Related guide link -->
    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">📖 Is the $36:$1 Email ROI Still Accurate? Read the benchmarks guide →</p>
      <a href="/blog/email-marketing-roi-benchmarks/" class="btn-inline">Read now →</a>
    </div>


    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Email Marketing ROI Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Enter your email list size and number of sends per month. 2. Enter your open rate and click rate (use your ESP's analytics or the 2026 industry benchmarks shown below). 3. Enter conversion rate of clicks, average order value, and monthly platform cost. 4. Click Calculate — your monthly revenue, conversions, and full ROMI appear.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Example: 5,000 subscribers, 4 sends/month, 22% open rate, 2.5% CTR, 5% conversion, $150 AOV, $50 platform cost. Monthly revenue = 5,000 × 4 × 0.22 × 0.025 × 0.05 × $150 = $825. ROMI = ($825 − $50) ÷ $50 × 100 = 1,550%.
      </div>
    </div>


    <section class="prose content-section" aria-labelledby="em-how-heading" style="margin-top: var(--space-8);">
      <h2 id="em-how-heading">How to Calculate Email Marketing ROI</h2>
      <p>Email marketing ROI is the revenue earned from email minus the cost of running it, divided by that cost. The result depends heavily on which costs are counted, so the worked examples below show the same campaign measured two ways.</p>
      <ol class="em-steps">
        <li><strong>Estimate monthly conversions.</strong> List size × sends per month × open rate × click rate (as a share of opens) × conversion rate of clicks.</li>
        <li><strong>Convert to revenue.</strong> Multiply conversions by the average order value.</li>
        <li><strong>Total the cost.</strong> Platform fee, plus creative, copywriting and staff time if a fully loaded ROI is needed.</li>
        <li><strong>Apply the formula.</strong> ROI = (revenue − cost) ÷ cost × 100.</li>
      </ol>
    </section>

    <section class="bench-section" aria-labelledby="em-examples-heading">
      <h2 id="em-examples-heading">Email Marketing ROI: Worked Examples</h2>
      <span class="bench-date">Calculated October 2026</span>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">The same 5,000-subscriber campaign returns 1,550% when only the platform fee counts as cost and 27% when creative and staff time are included. The table uses the calculator's own formula.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th scope="col">Example</th><th scope="col">Inputs</th><th scope="col">Conversions / mo</th><th scope="col">Monthly Revenue</th><th scope="col">Cost</th><th scope="col">ROI</th></tr></thead>
          <tbody>
            <tr><td><strong>1. Platform cost only</strong></td><td>5,000 subscribers, 4 sends, 22% open, 2.5% click, 5% conversion, $150 AOV</td><td>5.5</td><td>$825</td><td>$50</td><td><strong>1,550%</strong></td></tr>
            <tr style="background:var(--off-white)"><td><strong>2. Larger list</strong></td><td>20,000 subscribers, 4 sends, 25% open, 3% click, 4% conversion, $80 AOV</td><td>24</td><td>$1,920</td><td>$150</td><td><strong>1,180%</strong></td></tr>
            <tr><td><strong>3. Fully loaded cost</strong></td><td>Example 1 with $50 platform + $200 creative + $400 staff time</td><td>5.5</td><td>$825</td><td>$650</td><td><strong>27%</strong></td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Inputs are illustrative, not survey data. Example 3 shows why published benchmark ROIs depend on what the cost figure includes.</p>
    </section>

    <section class="bench-section" aria-labelledby="em-bench-heading">
      <h2 id="em-bench-heading">Email Marketing Benchmarks From Named Sources</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">Mailchimp's all-user averages are a 35.63% open rate, a 2.62% click rate and a 0.22% unsubscribe rate, and published ROI figures run from $38 per $1 (Litmus) to £42 per £1 (DMA). Use these to sanity-check the inputs above.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th scope="col">Metric</th><th scope="col">Benchmark</th><th scope="col">Source</th></tr></thead>
          <tbody>
            <tr><td>Average open rate</td><td><strong>35.63%</strong></td><td><a href="https://mailchimp.com/resources/email-marketing-benchmarks/" target="_blank" rel="noopener noreferrer nofollow">Mailchimp, Dec 2023</a></td></tr>
            <tr style="background:var(--off-white)"><td>Average click rate</td><td><strong>2.62%</strong></td><td>Mailchimp, Dec 2023</td></tr>
            <tr><td>Average unsubscribe rate</td><td>0.22%</td><td>Mailchimp, Dec 2023</td></tr>
            <tr style="background:var(--off-white)"><td>Email ROI (survey)</td><td>38:1</td><td><a href="https://www.litmus.com/press/litmus-research-finds-email-marketing-roi-is-38-to-1" target="_blank" rel="noopener noreferrer nofollow">Litmus, 2018</a></td></tr>
            <tr><td>Email ROI (UK survey)</td><td>Just over £42 per £1</td><td><a href="https://dma.org.uk/article/marketer-email-tracker-2019" target="_blank" rel="noopener noreferrer nofollow">DMA, 2019</a></td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Mailchimp's click rate is clicks per delivered email, while this calculator asks for clicks as a share of opens. Full source comparison: <a href="/blog/email-marketing-roi-benchmarks/">Email Marketing ROI Benchmarks</a>.</p>
    </section>

    <div class="related-box">
      <p class="related-box__label">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">The calculator uses the standard ROMI formula, which the <a href="/blog/romi-calculator-formula/">ROMI Formula Guide</a> walks through with worked examples. The <a href="/blog/what-is-a-good-marketing-roi/">What Is a Good Marketing ROI?</a> compares email with other channels, and the <a href="/marketing-roi-calculator/">Marketing ROI Calculator</a> handles multi-channel spend.</p>
      <div class="link-grid"><a href="/blog/romi-calculator-formula/" class="link-tile">ROMI Formula Guide →</a><a href="/blog/what-is-a-good-marketing-roi/" class="link-tile">What Is a Good Marketing ROI? →</a><a href="/marketing-roi-calculator/" class="link-tile">Marketing ROI Calculator →</a><a href="/marketing-automation-roi-calculator/" class="link-tile">Marketing Automation ROI Calculator →</a></div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>
<style>
  .em-steps { counter-reset: step; list-style: none; padding: 0; margin: var(--space-4) 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .em-steps li { position: relative; padding-left: 44px; color: var(--text-mid); line-height: 1.8; }
  .em-steps li::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: 0; width: 30px; height: 30px; background: var(--teal); color: var(--navy); font-weight: 800; font-size: var(--text-sm); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
</style>

<script>
(function(){
  'use strict';
  const btn = document.getElementById('em-calc-btn');
  const result = document.getElementById('em-result');
  if (!btn) return;
  function fmt(n) { return n >= 1000000 ? '$' + (n/1000000).toFixed(2) + 'M' : '$' + Math.round(n).toLocaleString(); }
  btn.addEventListener('click', () => {
    const list   = parseFloat(document.getElementById('em-listsize').value) || 0;
    const sends  = parseFloat(document.getElementById('em-sends').value) || 1;
    const open   = parseFloat(document.getElementById('em-openrate').value) / 100 || 0;
    const ctr    = parseFloat(document.getElementById('em-ctr').value) / 100 || 0;
    const cvr    = parseFloat(document.getElementById('em-cvr').value) / 100 || 0;
    const aov    = parseFloat(document.getElementById('em-aov').value) || 0;
    const cost   = parseFloat(document.getElementById('em-cost').value) || 1;
    if (!list || !aov) return;
    const convs   = list * sends * open * ctr * cvr;
    const revenue = convs * aov;
    const roi     = cost > 0 ? ((revenue - cost) / cost) * 100 : 0;
    const perSub  = list > 0 ? revenue / list : 0;
    document.getElementById('em-primary').textContent    = roi.toFixed(0) + '%';
    document.getElementById('em-revenue').textContent    = fmt(revenue);
    document.getElementById('em-conversions').textContent = Math.round(convs).toLocaleString();
    document.getElementById('em-per-sub').textContent    = '$' + perSub.toFixed(2);
    document.getElementById('em-verdict').textContent    = roi >= 3600 ? '✅ At or above the $36:$1 industry benchmark' : roi >= 1000 ? '🟡 Positive ROI — optimise open rate and CTR for more' : '⚠️ Below average — review subject lines, list quality, and offer';
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
