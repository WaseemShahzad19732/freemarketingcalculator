---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'cpv-calculator';
const title       = 'CPV Calculator — Free Cost Per View Tool (2026)';
const description = 'Free CPV calculator — calculate cost per view, total video ad spend, or total views from any two inputs. With view definitions, formulas and a worked video campaign example.';



const faqItems = [
  { q: 'How do you calculate CPV?', a: 'Divide video ad spend by views measured over the same campaign and dates. Spending $300 for 10,000 qualifying views gives $0.03 per view. Choose the view column before comparing campaigns.' },
  { q: 'What counts as a video ad view?', a: 'The definition depends on the platform, format and metric. Google TrueView uses different thresholds for skippable in-stream, in-feed and Shorts ads. A two-second video-play metric is not interchangeable with a completed view or a billable TrueView view.' },
  { q: 'What is a good CPV?', a: 'There is no universal cutoff. Compare the same view definition, audience, format and objective over comparable periods. Include completion, qualified traffic and conversion outcomes; a low CPV alone does not establish value.' },
  { q: 'Can a CPM campaign have a CPV?', a: 'Yes. CPV can be calculated from spend and reported views even when the purchase is billed per thousand impressions. The calculated CPV does not change the platform billing model.' },
  { q: 'Is this CPV calculator free?', a: 'Yes. Calculate cost per view, spend or views without signup.' },
];

const webAppSchema = { "@type": "WebApplication", "name": "CPV Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/cpv-calculator/", "description": "Free CPV calculator with three modes — calculate cost per view, total spend, or total views. Includes view-definition guidance for YouTube, TikTok, Instagram, LinkedIn, and Facebook.", "featureList": ["CPV from spend + views", "Spend from CPV + views", "Views from spend + CPV", "Video view definitions"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
  { "@type": "ListItem", "position": 2, "name": "CPV Calculator", "item": "https://freemarketingcalculator.com/cpv-calculator/" }
]};
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Select what you want to calculate: CPV, Total Spend, or Total Views." },
{ "@type": "HowToStep", "position": 2, "text": "Enter the two values you already know." },
{ "@type": "HowToStep", "position": 3, "text": "Click Calculate, then review the formula and assumptions below." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">CPV Calculator — Cost Per View</h1>
      <p class="citation">Calculate cost per view, total spend or views for video campaigns. Compare the same watch threshold, format and reporting period, with a worked example and view-definition guide.</p>
      <div class="meta-badges">
        <span class="badge">✓ 3 calculation modes</span>
        <span class="badge">✓ View definitions explained</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">CPV Formula</div>
      <p><strong>CPV = Total Ad Spend ÷ Total Views</strong></p>
      <p style="margin-top: var(--space-2);">Example: $300 spend, 10,000 views → CPV = $300 ÷ 10,000 = <strong>$0.03 per view</strong></p>
      <p style="margin-top: var(--space-2);">Reverse: <strong>Views = Spend ÷ CPV</strong> &nbsp;|&nbsp; <strong>Spend = CPV × Views</strong></p>
    </div>

    <div class="calc-card" id="calculator" style="margin-top: var(--space-6);">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        </div>
        <div><div class="calc-card__title">CPV Calculator</div><div class="calc-card__subtitle">Calculate video ad costs and views</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field">
          <label>Calculate</label>
          <div class="mode-toggle" role="group">
            <button type="button" class="active" id="cpv-mode-cpv">CPV</button>
            <button type="button" id="cpv-mode-spend">Total Spend</button>
            <button type="button" id="cpv-mode-views">Total Views</button>
          </div>
        </div>

        <div id="cpv-inputs-cpv" class="field-group">
          <div class="field"><label for="cpv-spend">Total Ad Spend ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpv-spend" class="has-prefix" placeholder="e.g. 500" min="0"/></div></div>
          <div class="field"><label for="cpv-views">Total Views</label><input type="number" id="cpv-views" placeholder="e.g. 15000" min="0"/></div>
        </div>
        <div id="cpv-inputs-spend" class="field-group" style="display:none">
          <div class="field"><label for="cpv-rate">CPV Rate ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpv-rate" class="has-prefix" placeholder="e.g. 0.05" min="0" step="0.001"/></div></div>
          <div class="field"><label for="cpv-views-b">Target Views</label><input type="number" id="cpv-views-b" placeholder="e.g. 50000" min="0"/></div>
        </div>
        <div id="cpv-inputs-views" class="field-group" style="display:none">
          <div class="field"><label for="cpv-spend-c">Total Ad Spend ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpv-spend-c" class="has-prefix" placeholder="e.g. 1000" min="0"/></div></div>
          <div class="field"><label for="cpv-rate-c">CPV Rate ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpv-rate-c" class="has-prefix" placeholder="e.g. 0.04" min="0" step="0.001"/></div></div>
        </div>

        <button class="btn-calc" id="cpv-calc-btn" type="button">Calculate</button>
        <div class="result-panel" id="cpv-result" aria-live="polite">
          <div class="result-panel__label" id="cpv-rlabel">Cost Per View (CPV)</div>
          <div class="result-panel__primary" id="cpv-primary">$0.000</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpv-s1">—</span><span class="result-panel__stat-label" id="cpv-l1">Ad spend</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpv-s2">—</span><span class="result-panel__stat-label" id="cpv-l2">Views</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpv-s3">—</span><span class="result-panel__stat-label" id="cpv-l3">View definition</span></div>
          </div>
          <div class="result-verdict" id="cpv-verdict"></div>
        </div>
      </div>
    </div>

    <section class="bench-section" aria-labelledby="cpv-bench">
      <h2 id="cpv-bench">Choose the View Definition Before Comparing CPV</h2>
      <p>A video play, a completed view and a billable view can describe different events. Google documents these TrueView criteria for Video views campaigns:</p>
      <div class="bench-table-wrap"><table class="bench-table">
        <thead><tr><th scope="col">YouTube format</th><th scope="col">What qualifies for a TrueView view</th></tr></thead>
        <tbody><tr><td>Skippable in-stream</td><td>30 seconds watched, completion of a shorter ad, or qualifying engagement.</td></tr><tr><td>In-feed</td><td>Thumbnail click, or autoplay watched for 10 seconds (or completion when shorter).</td></tr><tr><td>Shorts</td><td>10 seconds watched (or completion when shorter), or a qualifying interaction.</td></tr></tbody>
      </table></div>
      <p class="bench-source">Source: <a href="https://support.google.com/google-ads/answer/13982458?hl=en">Google Ads: Video views</a>, checked October 22, 2026. For Meta, TikTok, LinkedIn and other platforms, record the exact selected metric and its current definition from your export. A reported play count does not imply CPV billing.</p>
      <h3>One Campaign, Two Different CPVs</h3>
      <p>An illustrative $300 campaign records 30,000 short plays and 10,000 qualifying longer views. Its short-play cost is $0.010, while its longer-view cost is $0.030. Both calculations are correct; they answer different questions. This is why a $0.01 short-play campaign cannot automatically be called three times more efficient.</p>
      <p>When comparing channels, keep the currency, dates, watch threshold and placement visible beside spend and views. Review <a href="/cpm-calculator/">CPM</a> for delivery cost and <a href="/cpc-calculator/">CPC</a> for traffic cost, then judge downstream outcomes.</p>
    </section>

    <div class="related-box">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-4);">Related Calculators</p>
      <div class="link-grid">
        <a href="/cpm-calculator/" class="link-tile">🌐 CPM Calculator</a>
        <a href="/cpc-calculator/" class="link-tile">🖱️ CPC Calculator</a>
        <a href="/digital-marketing-calculator/" class="link-tile">📊 All 5 Metrics at Once</a>
        <a href="/social-media-budget-calculator/" class="link-tile">📱 Social Media Budget</a>
      </div>
    </div>

    <div class="related-box">
      <p class="related-box__label">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">Cost per view sits alongside cost per mille and cost per click. The <a href="/blog/digital-marketing-metrics-guide/">Digital Marketing Metrics Guide</a> compares all three, and the <a href="/blog/what-is-cpm/">What Is CPM?</a> guide covers impression pricing.</p>
      <div class="link-grid"><a href="/blog/digital-marketing-metrics-guide/" class="link-tile">Digital Marketing Metrics Guide →</a><a href="/blog/what-is-cpm/" class="link-tile">What Is CPM? →</a><a href="/cpm-calculator/" class="link-tile">CPM Calculator →</a><a href="/cpc-calculator/" class="link-tile">CPC Calculator →</a></div>
    </div>

    <FAQ items={faqItems} title="CPV Calculator — FAQ" />
  </div>
</Base>

<script>
import { validateCalculator } from '../scripts/calc-validation.js';
(function(){
  'use strict';
  const mBtns = { cpv: document.getElementById('cpv-mode-cpv'), spend: document.getElementById('cpv-mode-spend'), views: document.getElementById('cpv-mode-views') };
  const mInputs = { cpv: document.getElementById('cpv-inputs-cpv'), spend: document.getElementById('cpv-inputs-spend'), views: document.getElementById('cpv-inputs-views') };
  const btn = document.getElementById('cpv-calc-btn');
  const result = document.getElementById('cpv-result');
  if (!btn) return;
  let mode = 'cpv';

  Object.entries(mBtns).forEach(([m, b]) => {
    b.addEventListener('click', () => {
      mode = m;
      Object.values(mBtns).forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      Object.values(mInputs).forEach(i => i.style.display = 'none');
      mInputs[m].style.display = 'grid';
    });
  });

  function getBenchmark(cpv) { return 'Match your report'; }

  btn.addEventListener('click', () => {
    if (!validateCalculator(btn)) return;
    const p = document.getElementById('cpv-primary');
    const rl = document.getElementById('cpv-rlabel');
    const s1 = document.getElementById('cpv-s1'), l1 = document.getElementById('cpv-l1');
    const s2 = document.getElementById('cpv-s2'), l2 = document.getElementById('cpv-l2');
    const s3 = document.getElementById('cpv-s3');
    const v = document.getElementById('cpv-verdict');

    if (mode === 'cpv') {
      const spend = parseFloat(document.getElementById('cpv-spend').value) || 0;
      const views = parseFloat(document.getElementById('cpv-views').value) || 0;
      
      const cpv = spend / views;
      rl.textContent = 'Cost Per View (CPV)';
      p.textContent = '$' + cpv.toFixed(3);
      s1.textContent = '$' + spend.toLocaleString(); l1.textContent = 'Ad spend';
      s2.textContent = views.toLocaleString(); l2.textContent = 'Views';
      s3.textContent = getBenchmark(cpv);
      v.textContent = 'Compare like-for-like view definitions and conversion outcomes. CPV alone does not measure profitability.';
    } else if (mode === 'spend') {
      const rate = parseFloat(document.getElementById('cpv-rate').value) || 0;
      const views = parseFloat(document.getElementById('cpv-views-b').value) || 0;
      
      const spend = rate * views;
      rl.textContent = 'Total Spend Required';
      p.textContent = '$' + spend.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
      s1.textContent = '$' + rate.toFixed(3); l1.textContent = 'CPV rate';
      s2.textContent = views.toLocaleString(); l2.textContent = 'Target views';
      s3.textContent = getBenchmark(rate);
      v.textContent = '🎬 ' + views.toLocaleString() + ' views at $' + rate.toFixed(3) + ' CPV = $' + spend.toLocaleString('en-US', {minimumFractionDigits:2});
    } else {
      const spend = parseFloat(document.getElementById('cpv-spend-c').value) || 0;
      const rate = parseFloat(document.getElementById('cpv-rate-c').value) || 0;
      
      const views = Math.floor(spend / rate);
      rl.textContent = 'Estimated Views';
      p.textContent = views.toLocaleString();
      s1.textContent = '$' + spend.toLocaleString(); l1.textContent = 'Ad spend';
      s2.textContent = '$' + rate.toFixed(3); l2.textContent = 'CPV rate';
      s3.textContent = getBenchmark(rate);
      v.textContent = '🎬 $' + spend.toLocaleString() + ' ÷ $' + rate.toFixed(3) + ' CPV = ' + views.toLocaleString() + ' estimated views';
    }
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
