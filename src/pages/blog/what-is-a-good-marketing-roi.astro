---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';

const slug        = 'blog/what-is-a-good-marketing-roi';
const title       = 'What Is a Good Marketing ROI? Benchmarks by Channel (2026)';
const description = 'A good marketing ROI is commonly 5:1 (500%). See channel ROI from named studies, industry planning targets and both ROI formulas explained.';
const published   = 'July 7, 2026';
const updated     = 'October 8, 2026';
const updatedISO  = '2026-10-08';
const readTime    = '6 min read';

const channelBenchmarks = [
  { channel: 'Email Marketing',       avg: '3,600–4,200%', range: '2,000–8,000%', note: 'Widely quoted as $36–$42 per $1; Litmus reported 38:1 in 2018' },
  { channel: 'SEO / Organic Search',  avg: '275%',   range: '100–600%',     note: 'Compounds over 12+ months; slow to start' },
  { channel: 'Content Marketing',     avg: '300%',   range: '150–500%',     note: 'Long-term asset; ROI improves with age' },
  { channel: 'Paid Search (SEM)',     avg: '200%',   range: '100–400%',     note: 'Depends heavily on CPC and conversion rate' },
  { channel: 'Paid Social Media',     avg: '120%',   range: '50–250%',      note: 'Higher for eCommerce; lower for B2B' },
  { channel: 'Events / Webinars',     avg: '140%',   range: '80–300%',      note: 'Hard to attribute; LTV-dependent' },
  { channel: 'Affiliate Marketing',   avg: '400%',   range: '200–800%',     note: 'Variable; depends on commission structure' },
  { channel: 'Influencer Marketing',  avg: '520%',   range: '200–1,000%',   note: 'Wide variance; micro-influencers outperform' },
  { channel: 'Direct Mail',           avg: '112%',   range: '50–200%',      note: 'Physical mail; B2B performs better than B2C' },
];

const industryBenchmarks = [
  { industry: 'E-commerce / Retail',       target: '400–600%', note: 'High purchase frequency; AOV-dependent' },
  { industry: 'SaaS / Software',           target: '300–500%', note: 'Measured on LTV, not single transaction' },
  { industry: 'B2B Professional Services', target: '200–400%', note: 'Long sales cycles; pipeline attribution difficult' },
  { industry: 'Financial Services',        target: '250–450%', note: 'High CPA offset by high lifetime value' },
  { industry: 'Healthcare',                target: '150–300%', note: 'Compliance constraints limit channel mix' },
  { industry: 'Real Estate',               target: '200–400%', note: 'Single transaction; referral-heavy' },
  { industry: 'Education / e-Learning',    target: '300–500%', note: 'Strong content ROI; evergreen lead gen' },
  { industry: 'Nonprofit',                 target: '150–250%', note: 'Measured as funds raised vs. fundraising cost' },
];

const faqItems = [
  {
    q: 'What is a good marketing ROI?',
    a: 'A good marketing ROI is 5:1 — earning $5 in revenue for every $1 spent on marketing (500%). This is the most widely cited rule of thumb, not a published standard. 10:1 (1,000%) is considered excellent. Anything below 2:1 (200%) is generally not sustainable once overhead costs are factored in.',
  },
  {
    q: 'What is a good marketing ROI percentage?',
    a: 'A good marketing ROI percentage is 500%, which equals a 5:1 return. Percentages above 300% are generally strong, and anything below 100% means the campaign returned less than it cost. Direct-response channels usually target 200–400%, while brand awareness campaigns can run lower. The percentage also depends on whether ROI is measured on revenue or on gross profit, so state the method with the number.',
  },
  {
    q: 'Is a 2% ROI good for marketing?',
    a: 'No. A 2% marketing ROI means you earned $0.02 for every dollar spent — you are operating at a significant loss. A healthy marketing ROI starts at 100% (breaking even plus your money back), with most direct-response channels targeting 200–400%.',
  },
  {
    q: 'What does 22% ROI mean in marketing?',
    a: 'A 22% marketing ROI means you earned $0.22 for every $1 spent — well below the break-even point. Unless this is a pure brand awareness campaign with long-term LTV justification, campaigns at 22% ROI should be paused and restructured.',
  },
  {
    q: 'What is a 1000% return on $1,000?',
    a: 'A 1,000% ROI on a $1,000 investment means you gained $10,000, for a total return of $11,000. The formula: ROI % = (Net Profit ÷ Investment) × 100, so $10,000 ÷ $1,000 × 100 = 1,000%. In marketing, this is achievable: Litmus reported a 38:1 return on email marketing (3,800%) in 2018.',
  },
  {
    q: 'What is the average marketing ROI across all channels?',
    a: 'No single average exists because studies define and attribute ROI differently. First Page Sage\'s client data for 2020 to 2025 reports 748% for B2B SEO and 261% for B2B email, against 36% for B2B paid search. Litmus reported a 38:1 return for email in 2018. Channel mix drives blended ROI, so compare your result with the same channel and the same measurement method.',
  },
  {
    q: 'What is the average marketing ROI by industry?',
    a: 'No published study reports average marketing ROI by industry on a common definition, so industry figures are planning targets rather than averages. The targets in this guide run from 150–250% for nonprofits to 400–600% for e-commerce. Define ROI on gross profit and compare against your own history before adopting an industry target.',
  },
  {
    q: 'How do I calculate marketing ROI?',
    a: 'Basic formula: Marketing ROI = (Revenue from marketing − Marketing cost) ÷ Marketing cost × 100. For a more accurate figure accounting for COGS: ROI = ((Revenue × Gross margin %) − Marketing spend) ÷ Marketing spend × 100. Use our free Marketing ROI Calculator for instant results.',
  },
];

const articleSchema = {
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": "2026-07-07",
  "dateModified": updatedISO,
  "author": {
    "@type": "Person",
    "name": "Waseem Shahzad",
    "url": "https://freemarketingcalculator.com/about/"
  },
  "publisher": { "@id": "https://freemarketingcalculator.com/#org" },
  "mainEntityOfPage": `https://freemarketingcalculator.com/${slug}/`,
  "image": "https://freemarketingcalculator.com/logo.svg"
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map(i => ({
    "@type": "Question",
    "name": i.q,
    "acceptedAnswer": { "@type": "Answer", "text": i.a }
  }))
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://freemarketingcalculator.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": "What Is a Good Marketing ROI?", "item": `https://freemarketingcalculator.com/${slug}/` }
  ]
};
---

<Base title={title} description={description} slug={slug} schema={[articleSchema, faqSchema, breadcrumbSchema]}>

  <!-- HERO -->
  <section class="page-hero" aria-labelledby="article-h1">
    <div class="container">
      <p class="eyebrow">ROI & Performance · {readTime}</p>
      <h1 id="article-h1">What Is a Good Marketing ROI?</h1>
      <p class="citation">
        A good marketing ROI is <strong style="color:var(--teal)">5:1 (500%)</strong> — earning $5 for every $1 spent,
        the rule of thumb most marketers cite. What counts as "good" varies by channel, industry and how ROI is measured.
        Named-study benchmarks are below.
      </p>
      <div class="meta-badges">
        <span class="badge">📅 {published}</span>
        <span class="badge">🔄 Updated {updated}</span>
        <span class="badge">✓ {readTime}</span>
        <span class="badge">✓ Sources cited</span>
      </div>
      <a href="/marketing-roi-calculator/" class="btn-hero-cta">Calculate Your ROI <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="article-layout">

      <!-- ARTICLE BODY -->
      <article class="article-body prose" aria-label="Article content">

        <!-- ANSWER-FIRST BLOCK — AI Overview extraction target -->
        <div class="definition-box" style="margin-top: var(--space-8);">
          <div class="definition-box__label">Quick Answer</div>
          <p>
            A good marketing ROI is <strong>5:1 (500%)</strong> — earning $5 in revenue for every $1
            spent on marketing. This is a widely cited rule of thumb, not a published standard. A 10:1 ratio
            (1,000%) is considered excellent, and anything below 2:1 (200%) is generally not sustainable once
            overhead costs are included. Reported channel ROI varies widely by study: Litmus reported a 38:1
            return on email in 2018, while First Page Sage's 2020 to 2025 client data shows 748% for B2B SEO
            and 36% for B2B paid search.
          </p>
        </div>

        <div class="definition-box" style="margin-top: var(--space-4);">
          <div class="definition-box__label">Key Takeaways</div>
          <ul style="margin: var(--space-2) 0 0 var(--space-5); color: var(--text-mid); line-height: 1.8;">
            <li>A good marketing ROI is 500% (5:1); above 300% is strong and below 100% loses money.</li>
            <li>At 5:1, a business with a gross margin above 20% earns back its marketing spend from gross profit alone.</li>
            <li>Channel ROI differs sharply: First Page Sage reports 748% for B2B SEO and 36% for B2B paid search.</li>
            <li>Litmus reported a 38:1 email return in 2018 from about 400 marketers.</li>
            <li>Measure ROI on gross profit, not revenue, when comparing channels or industries.</li>
          </ul>
        </div>

        
        <p style="margin-top: var(--space-4);">
          <strong>Want to calculate your own marketing ROI instantly?</strong> Use our
          <a href="/marketing-roi-calculator/" style="color: var(--teal-dark); font-weight:700;">free ROMI Calculator</a> —
          enter your campaign revenue and cost, choose basic or gross-profit method, and get your ROI in seconds.
        </p>

        <h2>The Standard Benchmark: 5:1 ROI</h2>
        <p>
          The 5:1 ratio is the most commonly referenced benchmark in marketing: $5 in revenue for every $1 invested.
          It is not a law or a published standard.
        </p>
        <p>
          It became a rule of thumb because the arithmetic works for most businesses. At 5:1, a business with a gross
          margin above 20% earns back its marketing spend from gross profit alone (5 × 20% = 1), and higher margins leave
          a profit on top.
        </p>

        <!-- ROI RANGES TABLE — plain HTML for AIO extraction -->
        <div class="formula-box">
          <p class="formula-title">Marketing ROI Ranges — What They Mean</p>
          <p class="formula-text">ROI = (Revenue from marketing − Marketing cost) ÷ Marketing cost × 100</p>
        </div>

        <div class="bench-table-wrap" style="margin: var(--space-6) 0;">
          <table class="bench-table">
            <thead>
              <tr>
                <th scope="col">ROI Range</th>
                <th scope="col">What It Means</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong style="color:var(--error)">Below 0%</strong></td>
                <td>Spending more than you're earning. Operating at a loss.</td>
                <td>Pause campaign immediately. Review targeting and offer.</td>
              </tr>
              <tr style="background: var(--off-white);">
                <td><strong>0% – 100%</strong></td>
                <td>Breaking even to modest return. Recovering spend but little profit.</td>
                <td>Acceptable for top-of-funnel brand awareness only. Not for direct response.</td>
              </tr>
              <tr>
                <td><strong style="color: #92400e;">100% – 300%</strong></td>
                <td>Positive ROI. Earning $2–$4 per $1 spent.</td>
                <td>Solid baseline. Optimise to push toward 500%+.</td>
              </tr>
              <tr style="background: var(--off-white);">
                <td><strong style="color: var(--success);">300% – 700%</strong></td>
                <td>Strong performance. Above the 5:1 benchmark.</td>
                <td>Scale budget. This channel is working.</td>
              </tr>
              <tr>
                <td><strong style="color: var(--teal);">700%+</strong></td>
                <td>Excellent. Top-quartile performance.</td>
                <td>Protect this channel. Investigate what's driving it and replicate.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2>Why "Good" Depends on the Channel</h2>
        <p>
          The 5:1 benchmark is a useful starting point, but treating it as universal is a mistake.
          Reported ROI differs sharply by channel: First Page Sage's 2020 to 2025 client data shows 748% for
          B2B SEO against 36% for B2B paid search, and Litmus reported a 38:1 return on email in 2018.
          What's "good" depends entirely on which channel you're measuring.
        </p>
        <p>
          The reason for this spread is fundamental economics. Email has near-zero marginal cost
          — once your list is built, sending to 10,000 people costs almost the same as sending to
          1,000. Display advertising has hard per-impression costs that scale linearly. The ROI
          ceiling of each channel is structurally different.
        </p>

        <!-- CHANNEL BENCHMARK TABLE -->
        <section class="bench-section" aria-labelledby="channel-bench-heading">
          <h2 id="channel-bench-heading">Marketing ROI Planning Ranges by Channel — 2026</h2>
          <span class="bench-date">Updated October 2026</span>
          <div class="bench-table-wrap">
            <table class="bench-table">
              <caption class="sr-only">Average marketing ROI by channel, 2026</caption>
              <thead>
                <tr>
                  <th scope="col">Channel</th>
                  <th scope="col">Average ROI</th>
                  <th scope="col">Typical Range</th>
                  <th scope="col">Key Consideration</th>
                </tr>
              </thead>
              <tbody>
                {channelBenchmarks.map((row, i) => (
                  <tr style={i % 2 !== 0 ? 'background: var(--off-white)' : ''}>
                    <td>{row.channel}</td>
                    <td><strong>{row.avg}</strong></td>
                    <td>{row.range}</td>
                    <td style="font-size: var(--text-sm); color: var(--text-mid);">{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="bench-source">
            These ranges are illustrative planning targets for comparison, not survey results.
            Figures from named studies, with their methods, follow in the next section.
          </p>
        </section>

        <!-- NAMED STUDIES -->
        <section class="bench-section" aria-labelledby="named-studies-heading" style="margin-top: var(--space-10);">
          <h2 id="named-studies-heading">Marketing ROI by Channel From Named Studies</h2>
          <span class="bench-date">Data: Q1 2020 to Q4 2025</span>
          <p>
            First Page Sage's client data for 2020 to 2025 reports a 748% average ROI for B2B SEO, 261% for B2B email
            and 36% for B2B paid search, and Litmus reported a 38:1 email return in 2018. Studies differ in
            definitions, samples and attribution, so compare channels within one study rather than across studies.
          </p>
          <div class="bench-table-wrap">
            <table class="bench-table">
              <caption class="sr-only">Marketing ROI by channel, B2B and B2C, First Page Sage 2020 to 2025</caption>
              <thead>
                <tr><th scope="col">Channel</th><th scope="col">B2B ROI</th><th scope="col">B2C ROI</th></tr>
              </thead>
              <tbody>
                <tr><td>SEO</td><td><strong>748%</strong></td><td>721%</td></tr>
                <tr style="background: var(--off-white)"><td>Webinars</td><td><strong>430%</strong></td><td>113%</td></tr>
                <tr><td>Email marketing</td><td><strong>261%</strong></td><td>298%</td></tr>
                <tr style="background: var(--off-white)"><td>LinkedIn (paid)</td><td><strong>229%</strong></td><td>57%</td></tr>
                <tr><td>Influencer marketing</td><td><strong>206%</strong></td><td>689%</td></tr>
                <tr style="background: var(--off-white)"><td>Facebook ads</td><td><strong>87%</strong></td><td>443%</td></tr>
                <tr><td>Online PR</td><td><strong>62%</strong></td><td>156%</td></tr>
                <tr style="background: var(--off-white)"><td>SEM / PPC</td><td><strong>36%</strong></td><td>24%</td></tr>
              </tbody>
            </table>
          </div>
          <p class="bench-source">
            Method: <a href="https://firstpagesage.com/seo-blog/marketing-roi-by-channel/" rel="noopener">First Page Sage, Marketing ROI by Channel</a>
            draws on client campaigns in more than 25 B2B and B2C industries (average campaign length 2.7 years),
            includes a channel only when at least 8 clients supplied data, and credits 60% of each conversion to the
            first-touch channel with the rest split evenly across other channels. Its worked example divides revenue by
            spend, so the percentages appear to be gross revenue-to-spend ratios rather than the net ROI formula used
            in this guide. Email: <a href="https://www.litmus.com/press/litmus-research-finds-email-marketing-roi-is-38-to-1" rel="noopener">Litmus, press release of October 11, 2018</a>,
            based on data from nearly 400 marketers worldwide. Both are agency or vendor data, not audited market-wide averages.
          </p>
        </section>

        <h2>The Problem with Comparing Channels Directly</h2>
        <p>
          Channel ROI figures are not directly comparable because each channel does a different job.
          Email's 3,600–4,200% ROI in the planning table looks astonishing next to paid search's 200%,
          but the two are not competing for the same customers.
        </p>
        <p>
          Email nurtures existing relationships. Paid search acquires brand-new customers at the
          moment of purchase intent. A business with no existing email list has no email marketing ROI
          to speak of. Comparing the two is like comparing the cost of keeping an existing customer
          happy versus the cost of finding a new one.
        </p>
        <p>
          The more useful question is: <strong>what ROI should I expect from this specific channel,
          at this stage of my business, in my industry?</strong>
        </p>

        <!-- INDUSTRY BENCHMARKS TABLE -->
        <section class="bench-section" aria-labelledby="industry-bench-heading">
          <h2 id="industry-bench-heading">What Is a Good Marketing ROI by Industry?</h2>
          <span class="bench-date">Updated October 2026</span>
          <p>
            No published study reports average marketing ROI by industry on a common definition, so the table
            gives planning targets rather than averages.
          </p>
          <div class="bench-table-wrap">
            <table class="bench-table">
              <caption class="sr-only">Good marketing ROI targets by industry, 2026</caption>
              <thead>
                <tr>
                  <th scope="col">Industry</th>
                  <th scope="col">Target ROI Range</th>
                  <th scope="col">Note</th>
                </tr>
              </thead>
              <tbody>
                {industryBenchmarks.map((row, i) => (
                  <tr style={i % 2 !== 0 ? 'background: var(--off-white)' : ''}>
                    <td>{row.industry}</td>
                    <td><strong>{row.target}</strong></td>
                    <td style="font-size: var(--text-sm); color: var(--text-mid);">{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="bench-source">
            Illustrative planning targets for mid-market companies with 12+ months of marketing programme history.
            They are not survey results; check them against your own historical ROI.
          </p>
        </section>

        <h2>The Two Marketing ROI Formulas You Need to Know</h2>
        <p>
          Most ROI discussions use the basic formula — but it overstates performance for
          product businesses by ignoring the cost of what you're selling.
        </p>

        <div class="formula-box">
          <p class="formula-title">Formula 1 — Basic ROMI (Return on Marketing Investment)</p>
          <p class="formula-text">ROMI = (Revenue from marketing − Marketing cost) ÷ Marketing cost × 100</p>
          <div class="formula-example">
            <strong>Example:</strong> Campaign generated $50,000 revenue, cost $10,000.
            ($50,000 − $10,000) ÷ $10,000 × 100 = <strong>400% ROMI</strong>
          </div>
        </div>

        <div class="formula-box" style="margin-top: var(--space-4);">
          <p class="formula-title">Formula 2 — Gross Profit ROI (more accurate for product businesses)</p>
          <p class="formula-text">ROI = ((Revenue × Gross Margin %) − Marketing Spend) ÷ Marketing Spend × 100</p>
          <div class="formula-example">
            <strong>Example:</strong> $200,000 revenue, 60% gross margin, $50,000 marketing spend.
            (($200,000 × 60%) − $50,000) ÷ $50,000 × 100 =
            ($120,000 − $50,000) ÷ $50,000 × 100 = <strong>140% gross-profit ROI</strong>
          </div>
        </div>

        <p>
          Notice how the same campaign goes from looking like a strong performer (400% basic ROMI)
          to a modest one (140% gross-profit ROI) once you account for the cost of goods.
          This is why gross-profit ROI gives a more honest picture — especially for eCommerce
          and physical product businesses with margins below 60%.
        </p>

        <h2>What Causes Low Marketing ROI — and How to Fix It</h2>
        <p>
          Before concluding that a channel "doesn't work," most low-ROI campaigns share common root
          causes that are fixable:
        </p>
        <p>
          <strong>Wrong audience targeting</strong> is the most common culprit in paid channels.
          You're paying to reach people who were never going to buy. Narrow your audience, raise
          your bids on high-intent signals, and exclude irrelevant segments before abandoning the channel.
        </p>
        <p>
          <strong>Poor landing page conversion</strong> means money is being spent to send people
          to a page that doesn't convert. Even a 1% conversion rate improvement at 10,000 monthly
          clicks can add 100 conversions — transforming an unprofitable campaign into a profitable one
          without spending an extra dollar.
        </p>
        <p>
          <strong>Misattribution</strong> is particularly common for SEO and content marketing,
          where value accrues over months. A blog post written in January may drive conversions in
          August — basic last-click attribution won't capture this. Use multi-touch attribution
          or time-lag reports in GA4 before deciding that organic channels aren't working.
        </p>
        <p>
          <strong>Measuring the wrong time window</strong> affects long-cycle channels. A SaaS
          company with a 90-day sales cycle shouldn't judge paid search ROI on 30-day results.
          Match your measurement window to your average time-to-close.
        </p>

        <h2>ROI vs. ROAS — Which Should You Use?</h2>
        <p>
          ROAS (Return on Ad Spend) is often confused with ROI — they measure different things.
        </p>
        <p>
          <strong>ROAS</strong> = Revenue ÷ Ad Spend. It tells you how much revenue each ad
          dollar generates — useful for comparing individual campaigns and ad sets. A 4× ROAS
          means $4 of revenue per $1 of ad spend.
        </p>
        <p>
          <strong>ROI</strong> = (Revenue − All Marketing Costs) ÷ All Marketing Costs × 100.
          It accounts for all costs — agency fees, tools, staff time — not just media spend.
          ROI tells you whether the overall marketing investment is profitable.
        </p>
        <p>
          Use ROAS for optimising campaigns within a channel. Use ROI to evaluate whether the
          channel deserves budget at all. A campaign with a strong ROAS can still have a negative
          ROI if agency fees eat the profit.
        </p>

        <!-- CALCULATOR CTA -->
        <div style="background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%); border-radius: var(--radius-lg); padding: var(--space-8); margin: var(--space-8) 0; color: white; text-align: center;">
          <p style="font-size: var(--text-xl); font-weight: 800; margin-bottom: var(--space-2); letter-spacing: -0.02em;">Calculate Your Marketing ROI</p>
          <p style="color: rgba(255,255,255,.75); margin-bottom: var(--space-6);">
            Enter your campaign revenue and cost. Supports basic ROMI and gross-profit ROI with COGS.
            Includes channel presets and benchmark comparison.
          </p>
          <a
            href="/marketing-roi-calculator/"
            style="display: inline-block; background: var(--teal); color: var(--navy); font-weight: 800; padding: var(--space-3) var(--space-8); border-radius: var(--radius); text-decoration: none; font-size: var(--text-lg);"
          >
            Use the Free ROI Calculator →
          </a>
        </div>

        <h2>What a "Good" Marketing ROI Actually Requires</h2>
        <p>
          Reaching and sustaining a 5:1 ROI isn't an accident — it requires three things working together:
        </p>
        <p>
          <strong>Accurate attribution.</strong> You can only optimise what you can measure. At minimum,
          you need UTM parameters on all links, a properly configured GA4 property, and consistent
          CRM tagging to match leads to revenue. Without this, you'll be optimising based on
          incomplete data and will systematically under-invest in channels that work.
        </p>
        <p>
          <strong>Long enough measurement windows.</strong> SEO, content, and email list building
          all have compounding returns that take 6–12 months to show up in ROI calculations.
          Measuring them at 90 days produces misleadingly low numbers that lead to premature cuts.
        </p>
        <p>
          <strong>A consistent offer and conversion path.</strong> Great marketing can only move
          people to the edge of a decision — the product, pricing, and landing page have to close it.
          A 5:1 ROI requires a compelling offer as much as it requires efficient media buying.
        </p>

        <!-- RELATED CALCULATORS -->
