---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';

const slug      = 'blog/marketing-budget-small-business';
const title     = 'How to Calculate a Marketing Budget: Small Business Guide';
const description = 'How to calculate a marketing budget: percentage of revenue, objective-based and CAC methods with worked examples, plus Gartner and SBA benchmarks for 2026.';
const published = 'July 7, 2026';
const readTime  = '8 min read';
const updatedLabel = 'October 2026';

const stageGuide = [
  { stage: 'Pre-revenue / Launch',      budget: '15–25% of target revenue', priority: 'Brand awareness, social proof, first customers', avoid: 'Investing heavily in SEO — too slow for early stage' },
  { stage: 'Early Growth ($0–$500K)',   budget: '12–20% of revenue',         priority: 'Paid acquisition, email list building, content foundation', avoid: 'Spreading budget across 5+ channels at once' },
  { stage: 'Scaling ($500K–$2M)',       budget: '8–14% of revenue',          priority: 'Double down on what works, build SEO/content moat', avoid: 'Copying enterprise tactics with startup budget' },
  { stage: 'Established ($2M–$10M)',    budget: '6–10% of revenue',          priority: 'Channel diversification, brand investment, retention', avoid: 'Cutting marketing in slow quarters — compounding loss' },
];

const channelAlloc = [  // planning framework, not survey data
  { channel: 'Paid Search / Google Ads',      pct: '30–40%', why: 'Captures high-intent searches. Fast results. Measurable.' },
  { channel: 'Social Media (paid + organic)',  pct: '20–25%', why: 'Builds brand, generates demand. TikTok/Instagram for B2C; LinkedIn for B2B.' },
  { channel: 'Content & SEO',                 pct: '15–20%', why: 'Long-term compounding asset. Results usually take 6–12 months to build.' },
  { channel: 'Email Marketing',               pct: '5–10%',  why: 'Low-cost channel, often quoted at $36–$42 per $1. Nurtures existing audience.' },
  { channel: 'Tools & Technology',            pct: '8–12%',  why: 'CRM, email platform, analytics, scheduling tools.' },
  { channel: 'Other / Testing',              pct: '5–10%',  why: 'Reserve for experimentation. Don\'t over-plan this bucket.' },
];

const faqItems = [
  { q: "How do you calculate a marketing budget?", a: "Multiply annual revenue by a benchmark percentage, then adjust for growth goals. The U.S. Small Business Administration suggests 7-8% of gross revenue for businesses under $5 million, and the 2026 Gartner CMO Spend Survey found budgets average 7.8% of revenue. A business with $800,000 in revenue at 8% budgets $64,000 a year, or $5,333 a month." },
  { q: "How much should a small business spend on marketing?", a: "The U.S. Small Business Administration suggests 7-8% of gross revenue for businesses under $5 million with an established product. Newer businesses and businesses in growth mode often plan higher, in the range of 12-20% of revenue, to build customer acquisition. The Marketing Budget Benchmarks page lists survey averages from Gartner and The CMO Survey for comparison." },
  { q: "What is the 7-8% marketing budget rule?", a: "The 7-8% rule is the U.S. Small Business Administration guidance that businesses with under $5 million in revenue and an established product spend 7-8% of gross revenue on marketing. It is a starting point, not a limit. The 2025 and 2026 Gartner CMO Spend Surveys found averages of 7.7% and 7.8%, which is consistent with the guidance." },
  { q: "How do I calculate a monthly marketing budget?", a: "Divide the annual budget by 12. At 8% of $800,000 in revenue, the annual budget is $64,000 and the monthly budget is $5,333. If sales are seasonal, weight the monthly amounts toward the months before peak demand instead of splitting the total evenly." },
  { q: "What is a realistic marketing budget for a startup?", a: "Pre-revenue startups often plan 15-25% of target revenue for marketing. For a $500,000 first-year revenue target, that is $75,000 to $125,000. The right figure depends on customer acquisition cost (CAC) and how competitive the market is, so test with the CAC Calculator before committing the full amount." },
  { q: "What is the most effective marketing for small businesses?", a: "Email, local SEO, Google Ads and content marketing are the usual starting channels. Email is commonly quoted at $36-$42 returned per $1 spent, based on Litmus (2018) and DMA (2019) survey results. Local SEO suits service businesses, Google Ads captures high-intent searches immediately, and content compounds over time. Start with one or two channels you can run well before adding more." },
  { q: "Should a small business hire a marketing agency or do it in-house?", a: "Below about $500,000 in revenue, in-house work with freelancer support is usually more cost-effective. Agency retainers commonly start at $2,000-$5,000 a month and make sense once the product is proven and revenue is consistent. A hybrid of freelancers for execution and in-house strategy often suits $500,000 to $2 million businesses." },
  { q: "How do I track if my marketing budget is being spent well?", a: "Set up GA4 with UTM parameters on all links, then track cost per lead, cost per acquisition and ROI by channel each month. Pause channels where CPA exceeds the margin on a sale and reinvest in channels below it. The most common mistake is spending without attribution." },
];

const articleSchema = {
  "@type": "Article", "headline": title, "description": description,
  "datePublished": "2026-07-07", "dateModified": "2026-10-08",
  "author": { "@type": "Person", "name": "Waseem Shahzad", "url": "https://freemarketingcalculator.com/about/" },
  "publisher": { "@id": "https://freemarketingcalculator.com/#org" },
  "mainEntityOfPage": `https://freemarketingcalculator.com/${slug}/`,
};
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
  { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://freemarketingcalculator.com/blog/" },
  { "@type": "ListItem", "position": 3, "name": "How to Calculate a Marketing Budget", "item": `https://freemarketingcalculator.com/${slug}/` }
]};
---

<Base title={title} description={description} slug={slug} schema={[articleSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="art-h1">
    <div class="container">
      <p class="eyebrow">Budget Planning · {readTime}</p>
      <h1 id="art-h1">How to Calculate a Marketing Budget: Small Business Guide</h1>
      <p class="citation">
        To calculate a marketing budget, multiply annual revenue by a benchmark percentage: the U.S. Small Business Administration suggests 7–8% of gross revenue for businesses under $5 million, and Gartner's 2026 survey found budgets average 7.8% of revenue. This guide shows three methods with worked examples, a channel split, and the mistakes that waste the most spend.
      </p>
      <div class="meta-badges">
        <span class="badge">📅 {published}</span>
        <span class="badge">🔄 Updated {updatedLabel}</span>
        <span class="badge">✓ {readTime}</span>
        <span class="badge">✓ For businesses under $10M</span>
      </div>
      <a href="/marketing-budget-calculator/" class="btn-hero-cta">Try the Budget Calculator <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
    </div>
