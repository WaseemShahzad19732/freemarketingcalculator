---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';

const slug      = 'blog/digital-marketing-metrics-guide';
const title     = 'Digital Marketing Metrics: CPM, CPC, CTR, ROAS, CPA (2026)';
const description = 'CPM, CPC, CTR, ROAS, CPA — every digital marketing metric explained in plain English. Formulas, 2026 benchmarks, and when to use each one.';
const published = 'July 7, 2026';
const readTime  = '8 min read';
const updated   = 'October 8, 2026';

const metrics = [
  {
    name: 'CPM',
    full: 'Cost Per Mille (Cost Per 1,000 Impressions) — CPM Formula',
    answer: 'CPM is the price an advertiser pays for every 1,000 ad impressions, so a $500 spend that delivers 100,000 impressions equals a $5.00 CPM.',
    calc: { href: '/cpm-calculator/', label: 'Calculate CPM with the free CPM calculator' },
    formula: 'CPM = (Total Ad Spend ÷ Impressions) × 1,000',
    example: '$500 spend, 100,000 impressions → ($500 ÷ 100,000) × 1,000 = $5.00 CPM',
    use: 'Measuring the efficiency of brand awareness campaigns. Comparing reach across platforms.',
    avoid: 'Judging direct-response campaign performance — a low CPM is meaningless if nobody converts.',
    benchmarks: [
      { platform: 'Google Display Network', value: '$2–$4' },
      { platform: 'Facebook / Instagram',   value: '$7–$11' },
      { platform: 'LinkedIn',               value: '$30–$45' },
      { platform: 'TikTok',                 value: '$8–$12' },
      { platform: 'YouTube',                value: '$8–$14' },
      { platform: 'Twitter / X',            value: '$5–$8' },
    ],
  },
  {
    name: 'CPC',
    full: 'Cost Per Click',
    answer: 'CPC is the average price paid for one ad click, so $500 spent on 250 clicks equals a $2.00 CPC.',
    calc: { href: '/cpc-calculator/', label: 'Calculate CPC with the free CPC calculator' },
    formula: 'CPC = Total Ad Spend ÷ Total Clicks',
    example: '$500 spend, 250 clicks → $500 ÷ 250 = $2.00 CPC',
    use: 'Evaluating paid search and social campaigns. Comparing ad creative or audience efficiency.',
    avoid: 'Optimising CPC alone — a low CPC with low conversion rate is worse than a high CPC with high conversion rate.',
    benchmarks: [
      { platform: 'Google Ads (Search)',    value: 'Above $5 (2025 avg)' },
      { platform: 'Google Ads (Display)',   value: '$0.50–$1.50' },
      { platform: 'Facebook / Instagram',   value: '$0.70–$1.92 (2025)' },
      { platform: 'LinkedIn',               value: '$4.00–$8.00' },
      { platform: 'TikTok',                 value: '$0.80–$1.20' },
      { platform: 'Twitter / X',            value: '$0.30–$0.60' },
    ],
  },
  {
    name: 'CTR',
    full: 'Click-Through Rate',
    answer: 'CTR is the percentage of ad impressions that produce a click, so 250 clicks from 100,000 impressions equals a 0.25% CTR.',
    calc: { href: '/digital-marketing-calculator/', label: 'Calculate CTR with the digital marketing calculator' },
    formula: 'CTR = (Clicks ÷ Impressions) × 100',
    example: '250 clicks, 100,000 impressions → (250 ÷ 100,000) × 100 = 0.25% CTR',
    use: 'Measuring ad creative relevance. A/B testing headlines and images. Quality Score signals in Google Ads.',
    avoid: 'Using CTR as a primary success metric — a high CTR with poor conversion rate wastes budget.',
    benchmarks: [
      { platform: 'Google Ads (Search)',    value: '3–6%' },
      { platform: 'Google Ads (Display)',   value: '0.05–0.2%' },
      { platform: 'Facebook / Instagram',   value: '1.7–2.6% (2025)' },
      { platform: 'LinkedIn',               value: '0.3–0.6%' },
      { platform: 'Email Marketing',        value: '2–5%' },
      { platform: 'Twitter / X',            value: '0.8–1.5%' },
    ],
  },
  {
    name: 'ROAS',
    full: 'Return on Ad Spend',
    answer: 'ROAS is the revenue earned for every dollar of ad spend, so $22,000 of revenue from $5,000 of spend equals a 4.4× ROAS.',
    calc: { href: '/roas-calculator/', label: 'Calculate ROAS with the free ROAS calculator' },
    formula: 'ROAS = Revenue Generated ÷ Ad Spend',
    example: '$22,000 revenue, $5,000 spend → $22,000 ÷ $5,000 = 4.4× ROAS',
    use: 'Optimising paid campaigns within a channel. Comparing ad sets and audiences. Setting budget allocation.',
    avoid: 'Confusing ROAS with ROI — ROAS ignores agency fees, creative costs, and COGS. A 4× ROAS campaign can still lose money.',
    benchmarks: [
      { platform: 'Google Shopping',        value: '4–8×' },
      { platform: 'Google Search Ads',      value: '3–6×' },
      { platform: 'Facebook Ads (eComm)',   value: '3–6×' },
      { platform: 'Facebook Ads (Lead Gen)',value: '2–4×' },
      { platform: 'YouTube Ads',            value: '2–4×' },
      { platform: 'Display Remarketing',    value: '5–10×' },
    ],
  },
  {
    name: 'CPA',
    full: 'Cost Per Acquisition (Cost Per Conversion)',
    answer: 'CPA is the average advertising cost of one conversion, so $5,000 spent to win 90 conversions equals a $55.56 CPA.',
    calc: { href: '/digital-marketing-calculator/', label: 'Calculate CPA with the digital marketing calculator' },
    formula: 'CPA = Total Ad Spend ÷ Number of Conversions',
    example: '$5,000 spend, 90 conversions → $5,000 ÷ 90 = $55.56 CPA',
    use: 'Setting bid strategies. Evaluating campaign profitability against average order value. Comparing acquisition efficiency across channels.',
    avoid: 'Ignoring customer lifetime value (LTV) — a high CPA is acceptable if LTV is high enough. Always compare CPA to LTV, not just AOV.',
    benchmarks: [
      { platform: 'Google Ads (all sectors)', value: '$45–$80' },
      { platform: 'Facebook Ads',             value: '$18–$55' },
      { platform: 'B2B LinkedIn Ads',         value: '$75–$200' },
      { platform: 'Email Marketing',          value: '$5–$25' },
      { platform: 'Organic SEO',              value: '$10–$40' },
      { platform: 'Industry avg (eComm)',     value: '$30–$60' },
    ],
  },
];

const faqItems = [
  {
    q: 'What is CPM in digital marketing?',
    a: 'CPM stands for Cost Per Mille — the cost to show your ad 1,000 times. Formula: CPM = (Ad Spend ÷ Impressions) × 1,000. It measures the cost efficiency of brand awareness campaigns. Facebook averages $7–$11 CPM; LinkedIn averages $30–$45 CPM.',
  },
  {
    q: 'What is the full form of CTR, CPC, CPA and ROAS?',
    a: 'CTR stands for click-through rate, CPC for cost per click, CPA for cost per acquisition (also called cost per conversion) and ROAS for return on ad spend. CPM, the fifth core metric, stands for cost per mille, meaning cost per 1,000 impressions. Each metric is a ratio of spend, impressions, clicks, conversions or revenue. The quick-reference box at the top of this guide lists the formula for each.',
  },
  {
    q: 'How are CPM, CTR and CPC related?',
    a: 'CPC equals CPM divided by the number of clicks per 1,000 impressions. With CPM in dollars and CTR in percent, CPC = CPM ÷ (CTR × 10). A $5.00 CPM with a 0.25% CTR produces 2.5 clicks per 1,000 impressions and a $2.00 CPC. Raising CTR therefore lowers CPC without changing CPM.',
  },
  {
    q: 'What is a good CTR for digital marketing?',
    a: 'A good CTR depends on the channel. Google Search ads average 3–6% CTR, display ads 0.05–0.2%, Facebook ads 1.7–2.6% and email 2–5%. WordStream\'s 2025 data shows a 2.59% CTR for Facebook leads campaigns and 1.71% for traffic campaigns. Compare your CTR to the average for your platform and campaign type, not to a universal benchmark.',
  },
  {
    q: 'What is the difference between ROAS and ROI?',
    a: 'ROAS (Return on Ad Spend) = Revenue ÷ Ad Spend. It measures how much revenue each ad dollar generates. ROI (Return on Investment) = (Revenue − All Costs) ÷ All Costs × 100. ROI accounts for all costs — agency fees, creative, COGS — not just media spend. Use ROAS to optimise campaigns; use ROI to decide if the channel is worth investing in at all.',
  },
  {
    q: 'What is CPA in marketing?',
    a: 'CPA (Cost Per Acquisition) is how much you spend to acquire one customer or conversion. Formula: CPA = Total Spend ÷ Conversions. Google Ads CPA averages $45–$80 across industries, and WordStream by LocaliQ reports a $70.11 average Google Ads cost per lead in 2025 against $27.66 for Facebook leads campaigns. Whether a CPA is acceptable depends on average order value and customer lifetime value.',
  },
  {
    q: 'What does a 4× ROAS mean?',
    a: 'A 4× ROAS means you generated $4 in revenue for every $1 spent on advertising. It\'s often cited as a break-even benchmark for eCommerce businesses with 25% profit margins. However, 4× ROAS does not guarantee profitability — you must also account for COGS, fulfilment, and overhead costs.',
  },
  {
    q: 'How are CPC and ROAS related?',
    a: 'ROAS equals average order value multiplied by conversion rate, divided by CPC. A $2.00 CPC, a 4% conversion rate and an $80 average order value give $3.20 of revenue per click, so ROAS is 1.6×. Lowering CPC or raising conversion rate or order value raises ROAS. This is why CPC alone never shows whether a campaign is profitable.',
  },
  {
    q: 'How do you calculate CPA from CPC and conversion rate?',
    a: 'CPA equals CPC divided by conversion rate. A $2.00 CPC with a 4% conversion rate gives a CPA of $50, because 25 clicks are needed per conversion. Doubling the conversion rate to 8% halves the CPA to $25. Improving the landing page therefore lowers CPA as effectively as lowering bids.',
  },
  {
    q: 'Which metric is most important in digital marketing?',
    a: 'It depends on your objective. For brand awareness: CPM and reach. For ad relevance: CTR. For campaign-level optimisation: ROAS. For overall profitability: ROI. For acquisition cost evaluation: CPA. No single metric tells the full story — use CPM and CTR to diagnose, CPA and ROAS to optimise, and ROI to decide.',
  },
];

const articleSchema = {
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": "2026-07-07",
  "dateModified": "2026-10-08",
  "author": { "@type": "Person", "name": "Waseem Shahzad", "url": "https://freemarketingcalculator.com/about/" },
  "publisher": { "@id": "https://freemarketingcalculator.com/#org" },
  "mainEntityOfPage": `https://freemarketingcalculator.com/${slug}/`,
};
const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } }))
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://freemarketingcalculator.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": "Digital Marketing Metrics Guide", "item": `https://freemarketingcalculator.com/${slug}/` }
  ]
};
---

<Base title={title} description={description} slug={slug} schema={[articleSchema, faqSchema, breadcrumbSchema]}>

  <section class="page-hero" aria-labelledby="art-h1">
    <div class="container">
      <p class="eyebrow">Metrics & Analytics · {readTime}</p>
      <h1 id="art-h1">Digital Marketing Metrics Explained: CPM, CPC, CTR, ROAS, CPA</h1>
      <p class="citation">
        The five core digital marketing metrics are CPM (cost per mille), CPC (cost per click),
        CTR (click-through rate), ROAS (return on ad spend) and CPA (cost per acquisition).
        Each answers one question: reach cost, click cost, ad relevance, revenue per ad dollar, and cost per customer.
      </p>
      <div class="meta-badges">
        <span class="badge">📅 {published}</span>
        <span class="badge">🔄 Updated {updated}</span>
        <span class="badge">✓ {readTime}</span>
        <span class="badge">✓ 5 metrics covered</span>
      </div>
      <a href="/digital-marketing-calculator/" class="btn-hero-cta">Try the Digital Marketing Calculator <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="article-layout">
      <article class="article-body prose">

        <!-- Quick reference -->
        <div class="definition-box" style="margin-top: var(--space-8);">
          <div class="definition-box__label">Quick Reference — All 5 Formulas</div>
          <p style="font-family: monospace; font-size: var(--text-sm); line-height: 2.2; color: var(--navy);">
            <strong>CPM</strong> = (Ad Spend ÷ Impressions) × 1,000<br/>
            <strong>CPC</strong> = Ad Spend ÷ Clicks<br/>
            <strong>CTR</strong> = (Clicks ÷ Impressions) × 100<br/>
            <strong>ROAS</strong> = Revenue ÷ Ad Spend<br/>
            <strong>CPA</strong> = Ad Spend ÷ Conversions
          </p>
        </div>

        
        <div class="definition-box" style="margin-top: var(--space-6);">
          <div class="definition-box__label">Key Takeaways</div>
          <ul style="margin: var(--space-2) 0 0 var(--space-5); color: var(--text-mid); line-height: 1.8;">
            <li>CPM prices reach, CPC prices clicks, CTR measures ad relevance, ROAS measures revenue per ad dollar, and CPA measures the cost of one customer.</li>
            <li>Use CPM and CTR to diagnose a campaign, CPA and ROAS to optimise it, and ROI to decide whether a channel is worth funding.</li>
            <li>WordStream's 2025 Facebook benchmarks show a 2.59% CTR, a $1.92 CPC and a $27.66 cost per lead for leads campaigns.</li>
            <li>WordStream by LocaliQ reports a $70.11 average Google Ads cost per lead in 2025, up 5.13% from 2024.</li>
            <li>ROAS ignores COGS and fees, so a 4× ROAS campaign can still lose money.</li>
          </ul>
        </div>

        <section style="margin-top: var(--space-10);" aria-labelledby="quick-reference-heading">
          <h2 id="quick-reference-heading">Digital Marketing Metrics at a Glance</h2>
          <p>The table lists each metric's full form, the question it answers and the free calculator for it.</p>
          <div class="bench-table-wrap">
            <table class="bench-table">
              <thead><tr><th scope="col">Metric</th><th scope="col">Full form</th><th scope="col">Question it answers</th><th scope="col">Calculate it</th></tr></thead>
              <tbody>
                <tr><td><strong>CPM</strong></td><td>Cost per mille (cost per 1,000 impressions)</td><td>What does reach cost?</td><td><a href="/cpm-calculator/">CPM calculator</a></td></tr>
                <tr style="background: var(--off-white)"><td><strong>CPC</strong></td><td>Cost per click</td><td>What does one click cost?</td><td><a href="/cpc-calculator/">CPC calculator</a></td></tr>
                <tr><td><strong>CTR</strong></td><td>Click-through rate</td><td>Is the ad relevant enough to earn clicks?</td><td><a href="/digital-marketing-calculator/">Digital marketing calculator</a></td></tr>
                <tr style="background: var(--off-white)"><td><strong>CPA</strong></td><td>Cost per acquisition (cost per conversion)</td><td>What does one customer or conversion cost?</td><td><a href="/digital-marketing-calculator/">Digital marketing calculator</a></td></tr>
                <tr><td><strong>ROAS</strong></td><td>Return on ad spend</td><td>How much revenue does each ad dollar earn?</td><td><a href="/roas-calculator/">ROAS calculator</a></td></tr>
                <tr style="background: var(--off-white)"><td><strong>Conversion rate</strong></td><td>Conversions ÷ visitors × 100</td><td>What share of visitors take the target action?</td><td><a href="/conversion-rate-calculator/">Conversion rate calculator</a></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <p style="margin-top: var(--space-6);">
          Each metric below follows the same pattern: a one-sentence definition, the formula,
          a worked example, when to use it, when it misleads, and platform benchmarks.
        </p>

        <!-- EACH METRIC -->
        {metrics.map((m, idx) => (
          <section aria-labelledby={`metric-${m.name}`} style="margin-top: var(--space-10);">

            <div style="display:flex; align-items:center; gap: var(--space-3); margin-bottom: var(--space-4);">
              <div style={`width:48px; height:48px; background: var(--teal); border-radius: var(--radius); display:flex; align-items:center; justify-content:center; font-size: var(--text-xl); font-weight:800; color: var(--navy); flex-shrink:0;`}>
                {idx + 1}
              </div>
              <div>
                <h2 id={`metric-${m.name}`} style="margin:0; font-size: var(--text-2xl);">
                  {m.name} — {m.full}
                </h2>
              </div>
            </div>

            <p>{m.answer}</p>

            <div class="formula-box" style="margin: var(--space-4) 0;">
              <p class="formula-title">Formula</p>
              <p class="formula-text">{m.formula}</p>
              <div class="formula-example"><strong>Example:</strong> {m.example}</div>
            </div>

            <p><strong>Use {m.name} when:</strong> {m.use}</p>
            <p><strong>Don't rely on {m.name} alone:</strong> {m.avoid}</p>
            <p><a href={m.calc.href}>{m.calc.label} →</a></p>

            <h3 style="font-size: var(--text-lg); font-weight:700; color:var(--navy); margin: var(--space-4) 0 var(--space-3);">
              {m.name} Benchmarks by Platform — 2026
            </h3>
            <div class="bench-table-wrap">
              <table class="bench-table">
                <thead>
                  <tr>
                    <th scope="col">Platform</th>
                    <th scope="col">Average {m.name}</th>
                  </tr>
                </thead>
                <tbody>
                  {m.benchmarks.map((b, i) => (
                    <tr style={i % 2 !== 0 ? 'background: var(--off-white)' : ''}>
                      <td>{b.platform}</td>
                      <td><strong>{b.value}</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

          </section>
        ))}


        <!-- Named-source benchmarks -->
        <section style="margin-top: var(--space-10);" aria-labelledby="named-benchmarks-heading">
          <h2 id="named-benchmarks-heading">2025 Benchmark Data From Named Sources</h2>
          <p>
            WordStream's 2025 benchmark reports put the average Facebook leads campaign at a 2.59% CTR and a
            $27.66 cost per lead, and the average Google Ads cost per lead at $70.11. The table lists each
            figure with its change from 2024.
          </p>
          <div class="bench-table-wrap">
            <table class="bench-table">
              <thead><tr><th scope="col">Source and campaign type</th><th scope="col">Metric</th><th scope="col">2025 average</th><th scope="col">2024</th></tr></thead>
              <tbody>
                <tr><td>WordStream, Facebook leads campaigns</td><td>CTR</td><td><strong>2.59%</strong></td><td>2.58%</td></tr>
                <tr style="background: var(--off-white)"><td>WordStream, Facebook leads campaigns</td><td>CPC</td><td><strong>$1.92</strong></td><td>$1.88</td></tr>
                <tr><td>WordStream, Facebook leads campaigns</td><td>Conversion rate</td><td><strong>7.72%</strong></td><td>8.67%</td></tr>
                <tr style="background: var(--off-white)"><td>WordStream, Facebook leads campaigns</td><td>Cost per lead</td><td><strong>$27.66</strong></td><td>$22.87</td></tr>
                <tr><td>WordStream, Facebook traffic campaigns</td><td>CTR</td><td><strong>1.71%</strong></td><td>1.57%</td></tr>
                <tr style="background: var(--off-white)"><td>WordStream, Facebook traffic campaigns</td><td>CPC</td><td><strong>$0.70</strong></td><td>$0.77</td></tr>
                <tr><td>WordStream by LocaliQ, Google Ads</td><td>Cost per lead</td><td><strong>$70.11</strong></td><td>$66.69 (+5.13%)</td></tr>
                <tr style="background: var(--off-white)"><td>WordStream by LocaliQ, Google Ads</td><td>CPC</td><td><strong>Above $5</strong></td><td>$4.66</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Sources: <a href="https://www.wordstream.com/blog/facebook-ads-benchmarks-2025" rel="noopener">WordStream, Facebook Ads Benchmarks 2025</a>
            (campaign data from April 2024 to June 2025; WordStream describes its figures as medians) and
            <a href="https://searchengineland.com/google-ads-costs-keep-rising-but-conversion-rates-improved-in-2025-477927" rel="noopener">Search Engine Land's coverage of the WordStream by LocaliQ 2025 Google Ads report</a>
            (more than 16,000 campaigns, published May 18, 2026). The platform ranges in the tables above are
            typical ranges; where a named 2025 figure differs, use the named figure.
          </p>
        </section>

        <!-- TASK 12: Full campaign example -->
        <section style="margin-top: var(--space-10);" aria-labelledby="example-heading">
          <h2 id="example-heading">Full Campaign Example — All 5 Metrics at Once</h2>
          <p>
            One example campaign shows how the five metrics relate: all five are calculated from the same five inputs of spend,
            impressions, clicks, conversions and revenue.
          </p>
          <div class="formula-box">
            <p class="formula-title">Campaign: Google Search — Q3 2026</p>
            <p class="formula-text" style="line-height:2.2;">
              Ad spend: $5,000 | Impressions: 500,000 | Clicks: 4,500 | Conversions: 90 | Revenue: $22,000
            </p>
            <div class="formula-example">
              <strong>CPM</strong> = ($5,000 ÷ 500,000) × 1,000 = <strong>$10.00</strong><br/>
              <strong>CPC</strong> = $5,000 ÷ 4,500 = <strong>$1.11</strong><br/>
              <strong>CTR</strong> = (4,500 ÷ 500,000) × 100 = <strong>0.9%</strong><br/>
              <strong>CPA</strong> = $5,000 ÷ 90 = <strong>$55.56</strong><br/>
              <strong>ROAS</strong> = $22,000 ÷ $5,000 = <strong>4.4×</strong>
            </div>
          </div>
          <p>
            Reading this campaign: the CTR of 0.9% is slightly below the Google Search average (3–6%)
            suggesting the ad creative could be improved. However the ROAS of 4.4× is solid — the
            campaign is profitable. The CPA of $55.56 needs to be compared against the average order
            value or customer LTV to confirm profitability at the unit level.
          </p>
        </section>

        <!-- TASK 13: Which metric to optimise first -->
        <section style="margin-top: var(--space-10);" aria-labelledby="optimise-heading">
          <h2 id="optimise-heading">Which Metric Should You Optimise First?</h2>
          <p>Fix metrics in this order: CTR first, then CPC, then CPA, then ROAS. Each poor metric points to a different problem and a different fix:</p>
          <div class="bench-table-wrap" style="margin: var(--space-4) 0;">
            <table class="bench-table">
              <thead><tr><th scope="col">If this metric is poor</th><th scope="col">The problem is</th><th scope="col">The fix</th></tr></thead>
              <tbody>
                <tr><td><strong>High CPM</strong></td><td>Audience too competitive or narrow</td><td>Broaden audience targeting, try a different placement</td></tr>
                <tr style="background:var(--off-white)"><td><strong>Low CTR</strong></td><td>Ad creative not resonating</td><td>Test new headlines, images, CTAs — A/B test creatives</td></tr>
                <tr><td><strong>High CPC</strong></td><td>Low Quality Score or high competition</td><td>Improve ad relevance, raise bids on high-intent terms</td></tr>
                <tr style="background:var(--off-white)"><td><strong>High CPA</strong></td><td>Landing page not converting clicks</td><td>Optimise landing page — CTA, load speed, form length</td></tr>
                <tr><td><strong>Low ROAS</strong></td><td>Revenue per customer is too low</td><td>Improve offer, raise AOV, refine audience to buyers</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            The order matters: fix creative first (CTR), then bidding (CPC), then landing page (CPA), then offer (ROAS). 
            Optimising ROAS before fixing a broken landing page is wasted effort.
          </p>
        </section>

        <!-- ROAS vs ROI section -->
        <section style="margin-top: var(--space-10);" aria-labelledby="roas-vs-roi">
          <h2 id="roas-vs-roi">ROAS vs ROI — The Most Confused Metrics in Marketing</h2>
          <p>
            ROAS divides revenue by ad spend only, while ROI divides profit by all costs, so ROAS guides campaign optimisation
            and ROI guides investment decisions.
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin: var(--space-6) 0;">
            <div style="background: var(--teal-faint); border: 1px solid rgba(0,196,179,.3); border-radius: var(--radius-lg); padding: var(--space-5);">
              <p style="font-weight:800; color:var(--navy); font-size:var(--text-xl); margin-bottom: var(--space-2);">ROAS</p>
              <p style="font-size: var(--text-sm); color: var(--text-mid); margin-bottom: var(--space-3);">Revenue ÷ Ad Spend</p>
              <p style="font-size: var(--text-sm); color: var(--text-mid); line-height:1.6;">Only counts media spend in the denominator. Ignores agency fees, creative costs, COGS. Used for <strong>campaign-level optimisation</strong>.</p>
            </div>
            <div style="background: var(--off-white); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5);">
              <p style="font-weight:800; color:var(--navy); font-size:var(--text-xl); margin-bottom: var(--space-2);">ROI</p>
              <p style="font-size: var(--text-sm); color: var(--text-mid); margin-bottom: var(--space-3);">(Revenue − All Costs) ÷ All Costs × 100</p>
              <p style="font-size: var(--text-sm); color: var(--text-mid); line-height:1.6;">Accounts for all costs including COGS, overhead, agency fees. Used for <strong>investment decisions</strong>.</p>
            </div>
          </div>

          <p>
            A campaign showing 6× ROAS can still lose money if the gross margin is 15% and
            agency fees add 40% to the media cost. Always use ROI — not ROAS — when deciding
            whether a channel is worth investing in at all.
          </p>
        </section>

        <!-- How to read a metrics dashboard -->
        <section style="margin-top: var(--space-10);" aria-labelledby="dashboard-heading">
          <h2 id="dashboard-heading">How to Read a Campaign Performance Dashboard</h2>
          <p>
            Read a campaign report in five steps: impressions and CPM, CTR, CPC, CPA, then ROAS. This order finds a problem
            at the earliest stage of the funnel where it appears.
          </p>
          <p>
            <strong>1. Impressions and CPM</strong> — Is the campaign reaching enough people at a
            reasonable cost? Low impressions usually mean budget is too low or audience targeting
            is too narrow.
          </p>
          <p>
            <strong>2. CTR</strong> — Are people engaging with the ad? A low CTR (&lt;0.5% on
            display, &lt;2% on search) means the creative or messaging isn't resonating. Fix the
            ad before increasing budget.
          </p>
          <p>
            <strong>3. CPC</strong> — How much is each click costing? Compare to your industry
            benchmark. High CPC on search usually means high competition for your keywords or
            low Quality Score.
          </p>
          <p>
            <strong>4. CPA</strong> — How much is each conversion costing? Compare to your average
            order value. If CPA is higher than AOV, the campaign is losing money on every sale.
          </p>
          <p>
            <strong>5. ROAS</strong> — Is the campaign generating enough revenue relative to spend?
            This is your campaign scorecard. Target ROAS depends on your margin.
          </p>
          <p>
            A campaign with great CTR but terrible CPA has a landing page problem, not an ad problem.
            A campaign with low CTR but acceptable CPA may still be worth running — not every click
            has to be earned cheaply if the ones that do convert are valuable.
          </p>
        </section>

