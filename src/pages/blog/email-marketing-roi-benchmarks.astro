---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/FAQ.astro';

const slug      = 'blog/email-marketing-roi-benchmarks';
const title     = 'Email Marketing ROI: Is $36 for Every $1 Still True in 2026?';
const description = 'Email marketing ROI is commonly quoted at $36–$42 per $1 (3,600–4,200%). See the named sources, Mailchimp benchmarks and how to calculate your own ROI.';
const published = 'July 7, 2026';
const updated   = 'October 8, 2026';
const updatedISO = '2026-10-08';
const readTime  = '7 min read';

const emailTypes = [
  { type: 'Welcome / Onboarding Sequence', avgOpen: '50–60%', avgCTR: '14–18%', roi: 'Highest of the triggered types' },
  { type: 'Abandoned Cart',               avgOpen: '40–50%', avgCTR: '8–12%',  roi: 'Very High — recovers 5–10% of abandoned carts' },
  { type: 'Post-Purchase / Thank You',    avgOpen: '40–55%', avgCTR: '8–10%',  roi: 'High — cross-sell and review requests' },
  { type: 'Re-Engagement / Win-Back',     avgOpen: '12–25%', avgCTR: '3–6%',   roi: 'Moderate — depends on list quality' },
  { type: 'Promotional / Sales',         avgOpen: '15–25%', avgCTR: '2–5%',   roi: 'Variable — peaks during sale periods' },
  { type: 'Newsletter / Content',        avgOpen: '18–28%', avgCTR: '2–4%',   roi: 'Lower direct ROI — builds long-term LTV' },
  { type: 'Transactional (receipts etc)',avgOpen: '45–65%', avgCTR: '10–15%', roi: 'Very High — highest open rates of any email type' },
];

const faqItems = [
  { q: 'What is the average email marketing ROI?', a: 'Email marketing ROI is most commonly quoted at $36–$42 for every $1 spent, a 3,600–4,200% return. Primary sources checked for this article report $38 per $1 (Litmus, 2018) and £42 per £1 (DMA Marketer Email Tracker, 2019). Litmus reported in its 2026 findings that the top 8% of programmes reach 45:1 or higher.' },
  { q: 'Is the $36:$1 email ROI benchmark accurate?', a: 'The $36–$42 range is consistent with the primary sources Litmus and the DMA have published, but those are self-reported survey results from marketers who measure ROI, not audited averages. Results vary with attribution method, cost definition and list quality. Use the benchmark for budget justification and calculate campaign-level ROI from your own tracked revenue and costs.' },
  { q: 'What is a good email open rate?', a: 'Mailchimp reports an average open rate of 35.63% and a click rate of 2.62% across all users, with industry averages from 29.81% (ecommerce) to 40.55% (government). Apple Mail Privacy Protection, introduced in September 2021, pre-loads emails and inflates open rates. Click rate and click-to-open rate are more reliable engagement signals than open rate.' },
  { q: 'How do I calculate email marketing ROI?', a: 'Email ROI = (Revenue from email − Email marketing cost) ÷ Email marketing cost × 100. Include every cost: platform subscription, design time, copywriting and list management. Attribute revenue to email using UTM parameters tracked in GA4, or enter the numbers into the free Email Marketing ROI Calculator for an instant result.' },
  { q: 'Why is my email ROI lower than the $36:$1 average?', a: 'Four causes are common: measuring only direct-click revenue and missing assisted conversions, sending to an unengaged list that hurts deliverability, sending one broadcast to the whole list instead of segments, and weak subject lines. Counting only the platform fee understates cost in some studies, so confirm which costs a benchmark includes before comparing your result with it.' },
  { q: 'What email metrics should I track?', a: 'Track delivery rate, click rate, click-to-open rate, conversion rate, revenue per email sent and unsubscribe rate. Mailchimp reports an average click rate of 2.62% and an unsubscribe rate of 0.22% across all users, which gives a baseline for comparison. Open rate matters less since Apple Mail Privacy Protection began inflating it in 2021.' },
  { q: 'What is the difference between the DMA and Litmus email ROI figures?', a: 'The DMA Marketer Email Tracker reports ROI in pounds, with the 2019 edition at just over £42 for every £1 spent among UK marketers. Litmus reports in dollars from a global survey of email professionals, with 38:1 in 2018. Currency, sample, year and cost definition all differ, so the numbers are comparable only as rough indicators.' },
  { q: 'Does email marketing have a higher ROI than other channels?', a: 'Email is widely reported as one of the highest-ROI channels. First Page Sage reports 261% for B2B email and 298% for B2C email using a revenue-based method over multi-year campaigns, which is far lower than the survey-based 3,600–4,200% figure. The gap comes from different methods: survey figures reflect self-reported programme returns, while First Page Sage measures revenue against full programme cost.' },
];

const articleSchema = {
  "@type": "Article", "headline": title, "description": description,
  "datePublished": "2026-07-07", "dateModified": updatedISO,
  "author": { "@type": "Person", "name": "Waseem Shahzad", "url": "https://freemarketingcalculator.com/about/" },
  "publisher": { "@id": "https://freemarketingcalculator.com/#org" },
  "mainEntityOfPage": `https://freemarketingcalculator.com/${slug}/`,
};
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
  { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://freemarketingcalculator.com/blog/" },
  { "@type": "ListItem", "position": 3, "name": "Email Marketing ROI Benchmarks", "item": `https://freemarketingcalculator.com/${slug}/` }
]};
---

<Base title={title} description={description} slug={slug} schema={[articleSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="art-h1">
    <div class="container">
      <p class="eyebrow">Email Marketing · {readTime}</p>
      <h1 id="art-h1">Email Marketing ROI: Is $36 for Every $1 Still True in 2026?</h1>
      <p class="citation">Email marketing ROI is commonly quoted at $36–$42 for every $1 spent (3,600–4,200%). Litmus reported 38:1 in 2018 and the DMA reported £42 per £1 in 2019. This article lists the named sources, Mailchimp benchmarks and how to calculate your own return.</p>
      <div class="meta-badges">
        <span class="badge">📅 {published}</span>
        <span class="badge">🔄 Updated {updated}</span>
        <span class="badge">✓ {readTime}</span>
      </div>
      <a href="/email-marketing-roi-calculator/" class="btn-hero-cta">Calculate Your Email ROI <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="article-layout">
      <article class="article-body prose">

        <div class="definition-box" style="margin-top: var(--space-8);">
          <div class="definition-box__label">Definition</div>
          <p>
            <strong>Email marketing ROI</strong> is the profit earned from email divided by the cost of
            running it. It is commonly quoted at <strong>$36–$42 for every $1 spent</strong>, a
            3,600–4,200% return, because sending to 10,000 subscribers costs roughly the same
            as sending to 1,000 and every recipient has opted in.
          </p>
        </div>
        <div class="definition-box" style="margin-top: var(--space-4);">
          <div class="definition-box__label">Key Takeaways</div>
          <ul style="margin: var(--space-2) 0 0 var(--space-5); color: var(--text-mid); line-height: 1.8;">
            <li>Email ROI is commonly quoted at $36–$42 per $1; Litmus reported 38:1 in 2018 and the DMA £42 per £1 in 2019.</li>
            <li>Mailchimp's December 2023 data shows a 35.63% average open rate and a 2.62% average click rate.</li>
            <li>First Page Sage's revenue-based method gives a much lower 261% for B2B email and 298% for B2C.</li>
            <li>Include platform, creative, copy and staff time in costs, or the calculated ROI is inflated.</li>
            <li>Use click rate rather than open rate, since Apple Mail Privacy Protection inflates opens.</li>
          </ul>
        </div>

        
        <p style="margin-top: var(--space-4);">
          <strong>Calculate your own email marketing ROI:</strong> Use our
          <a href="/email-marketing-roi-calculator/" style="color: var(--teal-dark); font-weight:700;">free Email Marketing ROI Calculator</a> —
          enter list size, open rate, click rate, and platform cost to get your full ROMI.
        </p>

        <h2 id="source-of-36">Where Does the $36:$1 Email ROI Number Come From?</h2>
        <p>
          The $36–$42 per $1 range is a widely repeated summary of survey-based figures, and the
          primary sources checked for this article report $38 per $1 (Litmus, 2018) and £42 per £1
          (DMA, 2019). No edition of the Litmus report that states exactly $36 was located, so the
          benchmark is attributed below only to the figures that could be verified.
        </p>
        <div class="bench-table-wrap" style="margin: var(--space-4) 0;">
          <table class="bench-table">
            <thead><tr><th scope="col">Source</th><th scope="col">Year</th><th scope="col">Reported Figure</th><th scope="col">Notes</th></tr></thead>
            <tbody>
              <tr><td><a href="https://www.litmus.com/press/litmus-research-finds-email-marketing-roi-is-38-to-1" target="_blank" rel="noopener noreferrer nofollow">Litmus press release</a></td><td>2018</td><td>$38 per $1 (38:1)</td><td>Survey of email marketers</td></tr>
              <tr style="background:var(--off-white)"><td><a href="https://dma.org.uk/article/marketer-email-tracker-2019" target="_blank" rel="noopener noreferrer nofollow">DMA Marketer Email Tracker</a></td><td>2019</td><td>Just over £42 per £1</td><td>UK marketers; pounds, not dollars</td></tr>
              <tr><td><a href="https://www.litmus.com/state-of-email-reports" target="_blank" rel="noopener noreferrer nofollow">Litmus State of Email reports</a></td><td>2026 findings</td><td>Top 8% of programmes at 45:1 or higher</td><td>Advanced AI adopters 75% more likely to exceed 45:1</td></tr>
              <tr style="background:var(--off-white)"><td><a href="https://firstpagesage.com/seo-blog/marketing-roi-by-channel/" target="_blank" rel="noopener noreferrer nofollow">First Page Sage</a></td><td>Ongoing</td><td>261% (B2B), 298% (B2C)</td><td>Revenue-based method, multi-year campaigns</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          The variance between sources reflects differences in method. Some studies count only platform
          costs in the denominator while others include creative and strategy; some measure direct-click
          revenue while others use multi-touch attribution. Survey respondents are marketers who measure
          ROI, which skews results upward compared with programmes that do not.
        </p>

        <h2 id="by-industry">Email Marketing Benchmarks by Industry</h2>
        <p>Mailchimp's average open rate is 35.63% and its average click rate is 2.62% across all users, with industry averages ranging from 29.81% to 40.55% for opens. Mailchimp published no per-industry ROI figures, so the table shows engagement benchmarks only.</p>
        <span class="bench-date">Mailchimp data as of December 2023</span>
        <div class="bench-table-wrap" style="margin-top: var(--space-4);">
          <table class="bench-table">
            <thead>
              <tr>
                <th scope="col">Industry</th>
                <th scope="col">Avg Open Rate</th>
                <th scope="col">Avg Click Rate</th>
                <th scope="col">Unsubscribe Rate</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>All users</td><td><strong>35.63%</strong></td><td>2.62%</td><td>0.22%</td></tr>
              <tr style="background: var(--off-white)"><td>Government</td><td>40.55%</td><td>4.58%</td><td>n/a</td></tr>
              <tr><td>Non-profits</td><td>40.04%</td><td>3.27%</td><td>0.18%</td></tr>
              <tr style="background: var(--off-white)"><td>Education + training</td><td>35.64%</td><td>3.02%</td><td>0.18%</td></tr>
              <tr><td>Business + finance</td><td>31.35%</td><td>2.78%</td><td>0.15%</td></tr>
              <tr style="background: var(--off-white)"><td>Ecommerce</td><td>29.81%</td><td>1.74%</td><td>0.19%</td></tr>
              <tr><td>Vitamin supplements</td><td>27.34%</td><td>1.19%</td><td>n/a</td></tr>
            </tbody>
          </table>
        </div>
        <p class="bench-source">Source: <a href="https://mailchimp.com/resources/email-marketing-benchmarks/" target="_blank" rel="noopener noreferrer nofollow">Mailchimp Email Marketing Benchmarks</a>, campaigns sent to at least 1,000 subscribers, data last updated December 2023. Mailchimp notes that Apple's privacy changes may affect open-rate accuracy.</p>

        <h2 id="by-campaign-type">Email ROI by Campaign Type</h2>
        <p>
          Triggered emails such as welcome, abandoned-cart and transactional messages generally earn higher
          engagement than batch newsletters because they respond to an action the recipient just took.
          The ranges below are illustrative planning ranges, not survey results.
        </p>
        <div class="bench-table-wrap" style="margin-top: var(--space-4);">
          <table class="bench-table">
            <thead>
              <tr>
                <th scope="col">Email Type</th>
                <th scope="col">Avg Open Rate</th>
                <th scope="col">Avg CTR</th>
                <th scope="col">ROI Relative to Average</th>
              </tr>
            </thead>
            <tbody>
              {emailTypes.map((row, i) => (
                <tr style={i % 2 !== 0 ? 'background: var(--off-white)' : ''}>
                  <td>{row.type}</td>
                  <td>{row.avgOpen}</td>
                  <td>{row.avgCTR}</td>
                  <td><strong>{row.roi}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bench-source">Illustrative planning ranges for triggered versus batch email, not survey results. For measured benchmarks see the Mailchimp table above and the <a href="https://www.klaviyo.com/products/email-marketing/benchmarks" target="_blank" rel="noopener noreferrer nofollow">Klaviyo benchmarks page</a>.</p>

        <h2 id="why-high-roi">Why Email Reports a Higher ROI Than Paid Channels</h2>
        <p>
          Email reports a high ROI because it has near-zero marginal cost per recipient, an audience the
          sender owns and an opt-in intent signal. Three structural advantages explain the gap with paid channels:
        </p>
        <p>
          <strong>Zero incremental cost per recipient.</strong> Once your email platform and
          template are set up, sending to 10,000 subscribers costs roughly the same as
          sending to 100. Paid advertising scales linearly — every additional impression costs money.
          Email's marginal cost is effectively zero, which is why its ROI ceiling is so high.
        </p>
        <p>
          <strong>You own the audience.</strong> Your email list is an asset you control.
          Algorithm changes, platform shutdowns, and rising CPMs don't affect it. A well-maintained
          list of 10,000 engaged subscribers has more durable value than the equivalent paid
          audience — which disappears the moment you stop spending.
        </p>
        <p>
          <strong>Opt-in intent signal.</strong> Everyone on your list chose to hear from you.
          This makes email conversion rates structurally higher than most other channels, where
          you're interrupting people who didn't ask for your message.
        </p>

        <h2 id="apple-mpp">Apple Mail Privacy Protection and Open Rates</h2>
        <p>
          Apple Mail Privacy Protection (MPP) makes open rates unreliable because it pre-loads email content automatically. Apple introduced MPP in September 2021, and it pre-loads
          email content for all Apple Mail users — triggering an "open" in your ESP's tracking
          even if the person never actually opened the email.
        </p>
        <p>
          The larger the share of Apple Mail users on a list, the more inflated the reported open rate.
          This doesn't affect ROI calculations if you're tracking revenue via UTM parameters —
          but it makes open rate an unreliable engagement signal for list hygiene decisions.
        </p>
        <p>
          <strong>Use click rate (CTR) and click-to-open rate (CTOR) as your primary
          engagement metrics</strong> in the post-MPP era. If your click rate stays flat while
          open rate jumps, the opens are almost certainly bot-triggered.
        </p>

        <h2 id="improve">How to Improve Your Email Marketing ROI</h2>
        <p>
          Four levers raise email ROI most reliably: segmentation, automated trigger sequences, list hygiene and subject line testing.
        </p>
        <p>
          <strong>List segmentation</strong> is the single highest-leverage activity. Campaign Monitor
          has reported that segmented campaigns generate up to 760% more revenue than broadcast emails (an older, widely cited figure).
          At minimum, segment by: purchase history, engagement level (active vs. lapsed),
          and acquisition source.
        </p>
        <p>
          <strong>Automated trigger sequences</strong> — welcome series, abandoned cart,
          post-purchase, win-back — generate the highest ROI of any email type with the least
          ongoing effort. If you have none of these set up, start here before optimising your newsletter.
        </p>
        <p>
          <strong>List hygiene</strong> removes the unengaged subscribers who drag down
          deliverability. Subscribers who haven't opened or clicked in 12+ months reduce
          your sender reputation and push your emails toward spam for active subscribers.
          A smaller, engaged list consistently outperforms a large, stale one.
        </p>
        <p>
          <strong>Subject line testing</strong> has the highest ROI of any creative optimisation.
          A widely cited Convince & Convert statistic says 47% of recipients decide to open based on the subject line.
          A subject line A/B test on an existing list requires no additional spend, though with Apple MPP
          inflating opens, judge winners by clicks.
        </p>


        <!-- TASK 14: Email ROI by list size -->
        <section style="margin-top: var(--space-10);" aria-labelledby="roi-list-size">
          <h2 id="roi-list-size">Email Marketing ROI by List Size — Planning Ranges</h2>
          <p>
            Small lists usually earn a lower ROI than the $36–$42 headline because fixed creative and
            platform costs are spread over fewer subscribers and segmentation options are limited. The ranges
            below are illustrative planning ranges, not survey results.
          </p>
          <div class="bench-table-wrap" style="margin: var(--space-4) 0;">
            <table class="bench-table">
              <thead>
                <tr>
                  <th scope="col">List Size</th>
                  <th scope="col">Realistic Monthly ROI</th>
                  <th scope="col">Avg Platform Cost</th>
                  <th scope="col">Notes</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Under 500</td><td>$8–$15:$1</td><td>$0–$15/mo</td><td>Building phase — low volume, limited segmentation</td></tr>
                <tr style="background:var(--off-white)"><td>500–2,000</td><td>$20–$30:$1</td><td>$15–$35/mo</td><td>Engagement improves with basic segmentation</td></tr>
                <tr><td>2,000–10,000</td><td>$30–$42:$1</td><td>$35–$100/mo</td><td>Near industry average — automation becomes viable</td></tr>
                <tr style="background:var(--off-white)"><td>10,000–50,000</td><td>$40–$55:$1</td><td>$100–$350/mo</td><td>Scale benefits kick in — segmentation and A/B testing</td></tr>
                <tr><td>50,000+</td><td>$50–$80:$1</td><td>$350–$1,200/mo</td><td>Full automation, advanced segmentation, highest ROI</td></tr>
              </tbody>
            </table>
          </div>
          <p class="bench-source">Illustrative planning ranges for programmes with consistent sending, basic segmentation and clean list hygiene; they are not drawn from a published survey. Platform costs are typical list-price ranges and vary by provider.</p>
        </section>

        <!-- TASK 15: What does $36:$1 include? -->
        <section style="margin-top: var(--space-10);" aria-labelledby="cost-breakdown">
          <h2 id="cost-breakdown">What Costs Should an Email ROI Calculation Include?</h2>
          <p>
            Benchmark ROI figures are only comparable when the cost definition matches, and a complete
            email ROI includes every cost in the denominator, not just the platform subscription fee.
            The table shows the costs a complete calculation counts.
          </p>
          <div class="bench-table-wrap" style="margin: var(--space-4) 0;">
            <table class="bench-table">
              <thead><tr><th scope="col">Cost Type</th><th scope="col">Include in ROI?</th><th scope="col">Typical Monthly Cost</th></tr></thead>
              <tbody>
                <tr><td>Email platform subscription</td><td>✅ Yes</td><td>$15–$500/mo depending on list size</td></tr>
                <tr style="background:var(--off-white)"><td>Copywriting / content creation</td><td>✅ Yes</td><td>$200–$2,000/mo (in-house or agency)</td></tr>
                <tr><td>Design / creative</td><td>✅ Yes</td><td>$100–$500/mo</td></tr>
                <tr style="background:var(--off-white)"><td>List management / hygiene</td><td>✅ Yes</td><td>$0–$150/mo (tools)</td></tr>
                <tr><td>Strategy and management time</td><td>✅ Yes</td><td>3–8 hours/month at staff rate</td></tr>
                <tr style="background:var(--off-white)"><td>Email automation setup</td><td>Amortise over 12 months</td><td>One-time cost</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            <strong>Key takeaway:</strong> If you're only dividing revenue by your platform fee,
            your calculated ROI will be artificially high. For an honest ROI number,
            include all staff time, creative costs, and tools — not just the Mailchimp invoice.
          </p>
        </section>

        <!-- Calculator CTA -->
        <div style="background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%); border-radius: var(--radius-lg); padding: var(--space-8); margin: var(--space-8) 0; text-align: center; color: white;">
          <p style="font-size: var(--text-xl); font-weight: 800; margin-bottom: var(--space-2);">Calculate Your Email Marketing ROI</p>
          <p style="color: rgba(255,255,255,.75); margin-bottom: var(--space-6);">Enter your list size, open rate, click rate, conversion rate, and platform cost. Get your full ROMI with benchmarks.</p>
          <a href="/email-marketing-roi-calculator/" style="display:inline-block; background:var(--teal); color:var(--navy); font-weight:800; padding:var(--space-3) var(--space-8); border-radius:var(--radius); text-decoration:none; font-size:var(--text-lg);">
            Use the Free Email ROI Calculator →
          </a>
        </div>

        <!-- Related -->
        <div style="background: var(--off-white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-8);">
          <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-4);">Related Tools & Articles</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3);">
            <a href="/email-marketing-roi-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">✉️ Email ROI Calculator</a>
            <a href="/marketing-roi-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">📈 Marketing ROI Calculator</a>
            <a href="/conversion-rate-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">🔄 Conversion Rate Calculator</a>
            <a href="/blog/what-is-a-good-marketing-roi/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">📖 What Is a Good Marketing ROI?</a>
          </div>
        </div>

        <div style="display:flex; align-items:flex-start; gap: var(--space-4); padding: var(--space-6); background: var(--teal-faint); border-radius: var(--radius-lg); margin-top: var(--space-8); border: 1px solid rgba(0,196,179,.2);">
          <div style="width:44px; height:44px; background: var(--teal); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-weight:800; color:var(--navy); font-size: var(--text-lg);">W</div>
          <div>
            <p style="font-weight:700; color:var(--navy); margin-bottom: 4px;">Waseem Shahzad</p>
            <p style="font-size: var(--text-sm); color: var(--text-mid); line-height:1.5;">Named sources: Litmus (2018 press release and State of Email reports), DMA Marketer Email Tracker 2019, Mailchimp Email Marketing Benchmarks (December 2023) and First Page Sage. Planning ranges are labelled as such. <a href="/about/" style="color: var(--teal-dark);">About →</a></p>
          </div>
        </div>

      </article>

      <aside class="article-sidebar">
        <div class="toc-box">
          <p class="toc-title">In this article</p>
          <nav><ul class="toc-list">
            <li><a href="#source-of-36">Where $36:$1 Comes From</a></li>
            <li><a href="#by-industry">Benchmarks by Industry</a></li>
