---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'marketing-budget-calculator';
const title       = 'Marketing Budget Calculator — Free Online Tool (2026)';
const description = 'Free marketing budget calculator — enter your revenue and industry to get an instant budget recommendation with 9-sector benchmarks and channel allocation breakdown.';

// ── Industry planning benchmarks used by the calculator (planning ranges, not survey results) ──
const industries = [
  { name: 'SaaS / Software',        pct: 15, range: '12–18%', notes: 'High for growth-stage' },
  { name: 'Consumer Goods',         pct: 14, range: '10–18%', notes: 'Brand-heavy spending' },
  { name: 'Retail / E-commerce',    pct: 10, range: '7–12%',  notes: 'Driven by paid ads'   },
  { name: 'Healthcare / Pharma',    pct: 9,  range: '6–12%',  notes: 'Compliance limits channels' },
  { name: 'Financial Services',     pct: 9,  range: '8–12%',  notes: 'High CPA environment' },
  { name: 'B2B Services',           pct: 7,  range: '5–9%',   notes: 'Content & events led' },
  { name: 'Nonprofit',              pct: 6,  range: '4–8%',   notes: 'Donor acquisition focus' },
  { name: 'Manufacturing',          pct: 4,  range: '2–6%',   notes: 'Lower % vs. B2C'      },
  { name: 'Industrial / Engineering', pct: 3, range: '1–5%', notes: 'Relationship-driven'   },
];

const faqItems = [
  {
    q: 'What percentage of revenue should go to marketing?',
    a: 'The 2026 Gartner CMO Spend Survey of 401 CMOs found marketing budgets average <strong>7.8% of company revenue</strong>. The CMO Survey (Spring 2026) reports 7.0% for B2B product firms, 7.2% for B2C services, 10.1% for B2B services and 12.0% for B2C product firms. Early-stage businesses in aggressive growth mode often spend more than these averages.'
  },
  {
    q: 'How do I calculate my marketing budget?',
    a: 'Multiply projected annual revenue by the benchmark percentage for your industry. A B2B services company with $2,000,000 in revenue and a 7% benchmark gets $2,000,000 × 7% = $140,000 a year, or about $11,667 a month. Multiply by 1.25 for a growth year or 1.6 for an aggressive year, as the calculator does.'
  },
  {
    q: 'What is a realistic marketing budget for a small business?',
    a: 'The U.S. Small Business Administration recommends spending <strong>7–8% of gross revenue</strong> on marketing for businesses under $5 million in revenue. Businesses under $1 million often spend a higher share, because acquiring first customers costs more per dollar of revenue. Enter your revenue in the calculator above to turn the percentage into a monthly figure.'
  },
  {
    q: 'How much do B2B companies spend on marketing?',
    a: 'The CMO Survey (Spring 2026) reports B2B product firms spending 7.0% of revenue and B2B services firms spending 10.1%, according to the Highlights and Insights Report. The calculator uses 7% as its B2B services planning benchmark and 8% for the “Other” option. Companies with many small deals tend to spend toward the top of the range, and enterprise sellers with long sales cycles toward the bottom.'
  },
  {
    q: 'How much should a manufacturing company spend on marketing?',
    a: 'This calculator uses a planning benchmark of <strong>4% of revenue for manufacturing</strong>, with a typical range of 2–6%. The CMO Survey reports 7.0% for B2B product firms generally, so manufacturers selling directly to buyers may plan higher. A $25 million manufacturer at 4% would budget $1,000,000 a year, or about $83,333 a month.'
  },
  {
    q: 'What percentage of revenue do consumer goods companies spend on marketing?',
    a: 'This calculator uses a planning benchmark of <strong>14% of revenue for consumer goods</strong>, with a typical range of 10–18%. The CMO Survey reports 12.0% for B2C product firms. An $8 million consumer goods brand at 14% would budget $1,120,000 a year, rising to $1,400,000 in a growth year with the 1.25 multiplier.'
  },
  {
    q: 'How should I split my marketing budget across channels?',
    a: 'A common allocation for a growing B2B company is 35–40% paid advertising, 20–25% content and SEO, 15% events, 10–15% tools and technology, and 10% brand and creative. These are planning splits, not survey results, so adjust them to the channels that bring in customers. Gartner’s 2026 survey found paid media at 31.4% of marketing budgets on average.'
  },
  {
    q: 'Is the marketing budget calculator free?',
    a: 'Yes. The calculator is free, needs no signup or email, and includes a free Google Sheets template. Results use the industry planning benchmarks in the table on this page.'
  }
];

// ── JSON-LD schema ──
const webAppSchema = {
  "@type": "WebApplication",
  "@id": "https://freemarketingcalculator.com/marketing-budget-calculator/#app",
  "name": "Marketing Budget Calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
  "creator": { "@id": "https://freemarketingcalculator.com/#org" },
  "url": "https://freemarketingcalculator.com/marketing-budget-calculator/",
  "description": "Free marketing budget calculator with industry benchmarks for B2B, SaaS, retail, manufacturing, and 8 more sectors.",
  "featureList": ["Free to use", "No signup required", "12 industry benchmarks", "Google Sheets download"]
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a.replace(/<[^>]+>/g, '')  // strip HTML for schema
    }
  }))
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
    { "@type": "ListItem", "position": 2, "name": "Marketing Budget Calculator", "item": "https://freemarketingcalculator.com/marketing-budget-calculator/" }
  ]
};
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your annual revenue (or projected revenue for early-stage businesses)." },
{ "@type": "HowToStep", "position": 2, "text": "Select your industry from the dropdown." },
{ "@type": "HowToStep", "position": 3, "text": "Choose your growth stage: Maintain, Grow, or Aggressive." },
{ "@type": "HowToStep", "position": 4, "text": "Click Calculate \u2014 your annual, monthly, and weekly budget appear with a suggested channel allocation." }
] };
---

<Base
  title={title}
  description={description}
  slug={slug}
  schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}
>

  <!-- ═══ HERO ═══ -->
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Marketing Budget Calculator</h1>

      <!--
        CITATION SENTENCE — AI Overview extraction bait.
        Plain text, ≤60 words, third-person, states inputs + outputs.
        This is the sentence LLMs and Google AI Overview extract.
      -->
      <p class="citation">
        Enter your annual revenue and industry to get a recommended
        marketing budget as a percentage of revenue, with benchmarks
        across 9 industry sectors. Instant results, no signup.
      </p>

      <div class="meta-badges">
        <span class="badge">✓ Free forever</span>
        <span class="badge">✓ No email required</span>
        <span class="badge">✓ Updated October 2026</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">

    <!-- ═══ CALCULATOR CARD ═══ -->
    <!--
      GOOGLE POLICY NOTE:
      - Calculator is fully visible above fold on mobile (no scrolling needed)
      - Calculate button has clear separation from all ad units
      - Ad unit appears AFTER result panel only
    -->
    <div class="calc-card" id="calculator" aria-label="Marketing budget calculator tool">
      <div class="calc-card__header">
        <div class="calc-card__header-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/>
            <path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
        <div>
          <div class="calc-card__title">Marketing Budget Calculator</div>
          <div class="calc-card__subtitle">Based on revenue and industry benchmarks</div>
        </div>
      </div>

      <div class="calc-card__body">

        <!-- Inputs -->
        <div class="field-group">

          <div class="field">
            <label for="revenue">Annual Revenue (or projected)</label>
            <div class="input-wrap">
              <span class="input-prefix">$</span>
              <input
                type="number"
                id="revenue"
                class="has-prefix"
                placeholder="e.g. 2000000"
                min="0"
                step="10000"
                aria-describedby="revenue-hint"
              />
            </div>
            <p class="hint" id="revenue-hint">Use projected revenue if your business is early-stage</p>
          </div>

          <div class="field">
            <label for="industry">Your Industry</label>
            <select id="industry" aria-describedby="industry-hint">
              <option value="" disabled selected>Select your industry…</option>
              {industries.map(ind => (
                <option value={ind.pct}>{ind.name} — typical {ind.range}</option>
              ))}
              <option value="8">Other — using B2B average (8%)</option>
            </select>
            <p class="hint" id="industry-hint">Planning benchmarks; sources and survey averages are listed below</p>
          </div>

          <div class="field">
            <label for="growth-stage">Growth Stage</label>
            <div class="mode-toggle" role="group" aria-label="Growth stage">
              <button type="button" class="active" data-multiplier="1" id="maintain">Maintain</button>
              <button type="button" data-multiplier="1.25" id="grow">Grow</button>
              <button type="button" data-multiplier="1.6" id="aggressive">Aggressive</button>
            </div>
            <p class="hint">Grow adds ~25%; Aggressive adds ~60% to the benchmark</p>
          </div>
        </div>

        <!--
          CALCULATE BUTTON
          Google policy: this button must NOT be adjacent to any ad unit.
          The nearest ad unit is .ad-slot--post-result, BELOW the result panel.
        -->
        <button class="btn-calc" id="calc-btn" type="button" aria-controls="result-panel">
          Calculate My Budget
        </button>

        <!-- Result panel — hidden until calculation runs -->
        <div class="result-panel" id="result-panel" aria-live="polite" aria-label="Budget calculation results">
          <div class="result-panel__label">Recommended Annual Marketing Budget</div>
          <div class="result-panel__primary" id="result-budget">$0</div>

          <div class="result-panel__grid">
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="result-monthly">$0</span>
              <span class="result-panel__stat-label">Per month</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="result-pct">0%</span>
              <span class="result-panel__stat-label">of revenue</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="result-weekly">$0</span>
              <span class="result-panel__stat-label">Per week</span>
            </div>
          </div>

          <div class="result-verdict" id="result-verdict" aria-live="polite"></div>
        </div>

      </div><!-- /.calc-card__body -->
    </div><!-- /.calc-card -->

    <!--
      AD UNIT 1 — Post result
      POLICY: placed below the calculator card, never adjacent to the Calculate button.
      Container min-height reserved in CSS to prevent CLS.
    -->

    <!-- ═══ DEFINITION ═══ -->
    <!--
      Plain HTML definition — LLM / AIO extractable
      Marked as a definition block for semantic clarity
    -->
    <div class="definition-box" aria-label="Definition">
      <div class="definition-box__label">Definition</div>
      <p>
        A <strong>marketing budget</strong> is the total financial resource allocated to
        promote a company's products or services over a set period — typically one year.
        It is most commonly expressed as a percentage of projected or actual revenue,
        and covers all spending on advertising, content, events, tools, and personnel
        dedicated to marketing activities.
      </p>
    </div>

    <!-- ═══ FORMULA BLOCK ═══ -->
    <!--
      Formula in plain <p> tags — NOT inside JavaScript.
      This is what AI Overviews extract. Do not move inside script tags.
    -->
    <div class="formula-box" aria-label="Marketing budget formula">
      <p class="formula-title">Formula</p>
      <p class="formula-text">
        Recommended Budget = Annual Revenue × Industry Benchmark %
      </p>
      <div class="formula-example">
        <strong>Example:</strong> A B2B services company with $2,000,000 annual revenue
        using the 7% benchmark → $2,000,000 × 7% = <strong>$140,000 annual marketing budget</strong>
        ($11,667/month).
      </div>
    </div>

    <!-- ═══ BENCHMARK TABLE ═══ -->
    <!--
      Plain HTML table — AI Overview extractable.
      This table is missing from every current top-10 competitor result.
    -->
    <section class="bench-section" aria-labelledby="bench-heading">
      <h2 id="bench-heading">Marketing Budget by Industry — 2026 Planning Benchmarks</h2>
      <span class="bench-date">Updated October 2026</span>

      <div class="bench-table-wrap">
        <table class="bench-table">
          <caption class="sr-only">Planning benchmarks for marketing budget as a percentage of revenue, by industry, 2026</caption>
          <thead>
            <tr>
              <th scope="col">Industry</th>
              <th scope="col">Typical Range</th>
              <th scope="col">Budget / $1M Revenue</th>
              <th scope="col">Notes</th>
            </tr>
          </thead>
          <tbody>
            {industries.map(ind => (
              <tr>
                <td>{ind.name}</td>
                <td>{ind.range}</td>
                <td>${(ind.pct * 10000).toLocaleString()}</td>
                <td>{ind.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="bench-source">
        The percentages in this table are the calculator's planning benchmarks; they are not taken from a single
        published survey. Compare them with the survey averages in the next section, and note that actual spend
        varies by company size, growth stage and competitive landscape.
      </p>
    </section>

    <section class="bench-section" aria-labelledby="survey-heading">
      <h2 id="survey-heading">Published Survey Averages for Marketing Budget</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">Marketing budgets average 7.8% of company revenue in the 2026 Gartner CMO Spend Survey, and the Spring 2026 CMO Survey reports 7.0% to 12.0% depending on business model. Use these as reference points when checking the planning benchmarks above.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead>
            <tr><th scope="col">Source</th><th scope="col">Segment</th><th scope="col">Marketing Budget (% of Revenue)</th></tr>
          </thead>
          <tbody>
            <tr><td><a href="https://www.gartner.com/en/newsroom/press-releases/2026-05-11-gartner-2026-cmo-spend-survey-finds-cmos-allocate-15-point-3-percent-of-marketing-budgets-to-ai-but-only-30-percent-are-ready-to-scale-ai-capabilities" target="_blank" rel="noopener noreferrer nofollow">Gartner CMO Spend Survey 2026</a></td><td>All respondents (401 CMOs)</td><td><strong>7.8%</strong></td></tr>
            <tr style="background:var(--off-white)"><td><a href="https://www.gartner.com/en/newsroom/press-releases/2025-05-12-gartner-2025-cmo-spend-survey-reveals-marketing-budgets-have-flatlined-at-seven-percent-of-overall-company-revenue" target="_blank" rel="noopener noreferrer nofollow">Gartner CMO Spend Survey 2025</a></td><td>All respondents (402 CMOs)</td><td>7.7%</td></tr>
            <tr><td rowspan="5"><a href="https://cmosurvey.org/wp-content/uploads/2026/04/The_CMO_Survey-Highlights_and_Insights_Report-2026.pdf" target="_blank" rel="noopener noreferrer nofollow">The CMO Survey, Spring 2026</a> (Highlights and Insights Report, slide 53; 308 respondents)</td><td>All respondents</td><td>9.0%</td></tr>
            <tr style="background:var(--off-white)"><td>B2C product</td><td>12.0%</td></tr>
            <tr><td>B2B services</td><td>10.1%</td></tr>
            <tr style="background:var(--off-white)"><td>B2C services</td><td>7.2%</td></tr>
            <tr><td>B2B product</td><td>7.0%</td></tr>
            <tr style="background:var(--off-white)"><td>U.S. Small Business Administration</td><td>Businesses under $5M revenue</td><td>7–8% of gross revenue (guidance)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Gartner figures are survey averages across industries; the CMO Survey figures come from its Spring 2026 Highlights and Insights Report (308 respondents, fielded January 7–29, 2026). The CMO Survey's 9.0% overall average is higher than Gartner's 7.8% because the two surveys sample different respondents. Neither source publishes the individual industry rows in the planning table above.</p>
    </section>

    <!-- ═══ AD UNIT 2 ═══ — Mid content, between table and FAQ -->

    <!-- ═══ INDUSTRY DEEP-DIVES (long-tail keyword sections) ═══ -->
    <section class="prose content-section" aria-label="Industry-specific marketing budget guidance">
      <h2>How Much Should B2B Companies Spend on Marketing?</h2>
      <p>
        B2B product firms spend 7.0% of revenue on marketing and B2B services firms spend 10.1%,
        according to the Spring 2026 CMO Survey. This calculator's
        B2B services planning benchmark is 7% with a 5–9% range, and its generic “Other” option uses 8%.
        Companies with a high volume of smaller deals tend to sit toward the top of the range,
        while enterprise sellers with long sales cycles sit toward the bottom.
      </p>

      <h2 id="manufacturing-budget">Marketing Budget for Manufacturing Companies</h2>
      <p>
        This calculator plans manufacturing marketing at <strong>4% of revenue</strong>, with a typical
        range of 2–6%. Manufacturers sell on specifications, trade shows, technical content and
        distributor relationships, which usually need less advertising spend than consumer brands.
        The CMO Survey's 7.0% for B2B product firms is a higher reference point for manufacturers that sell directly to buyers.
      </p>
      <div class="formula-box">
        <p class="formula-title">Manufacturing worked example</p>
        <div class="formula-example"><strong>Example:</strong> A manufacturer with $25,000,000 in revenue at the 4% benchmark budgets $25,000,000 × 4% = <strong>$1,000,000 a year</strong> ($83,333 a month). The 2–6% range runs from $500,000 to $1,500,000.</div>
      </div>

      <h2 id="industrial-budget">Marketing Budget for Industrial and Engineering Firms</h2>
      <p>
        Industrial and engineering firms are planned at <strong>3% of revenue</strong>, with a range of 1–5%.
        Sales in this segment are relationship-driven, so budgets concentrate on trade shows, catalogues,
        technical documentation and a small amount of search advertising.
      </p>
      <div class="formula-box">
        <p class="formula-title">Industrial worked example</p>
        <div class="formula-example"><strong>Example:</strong> An engineering firm with $10,000,000 in revenue at the 3% benchmark budgets $10,000,000 × 3% = <strong>$300,000 a year</strong> ($25,000 a month). The 1–5% range runs from $100,000 to $500,000.</div>
      </div>

      <h2 id="consumer-goods-budget">Marketing Budget for Consumer Goods Brands</h2>
      <p>
        Consumer goods brands are planned at <strong>14% of revenue</strong>, with a range of 10–18%, because
        brand building and retail promotion drive most of the spend. The CMO Survey's 12.0% for B2C product firms
        is a published reference point inside that range.
      </p>
      <div class="formula-box">
        <p class="formula-title">Consumer goods worked example</p>
        <div class="formula-example"><strong>Example:</strong> A consumer brand with $8,000,000 in revenue at the 14% benchmark budgets $8,000,000 × 14% = <strong>$1,120,000 a year</strong>. In a growth year the 1.25 multiplier lifts that to <strong>$1,400,000</strong>.</div>
      </div>

      <h2>SaaS and Software Marketing Budget</h2>
      <p>
        This calculator plans SaaS at <strong>15% of revenue</strong>, with a range of 12–18%, and growth-stage
        companies often go higher because marketing is treated as a growth investment. Mature SaaS businesses
        usually move toward the lower end as customer acquisition cost falls with brand strength.
      </p>

      <h2>How to Split Your Marketing Budget</h2>
      <p>
        Once you have a total budget figure, a practical allocation for most B2B companies:
        <strong>35–40% paid advertising</strong> (search, LinkedIn, retargeting),
        <strong>20–25% content and SEO</strong>,
        <strong>15% events and sponsorships</strong>,
        <strong>10–15% tools and marketing technology</strong>,
        and <strong>10% brand and creative production</strong>.
        These are planning splits rather than survey results, so adjust them to your primary customer acquisition channel.
      </p>
    </section>

    <!-- ═══ FAQ ═══ -->

    <!-- TASK 23: Related guide link -->
    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">📖 How to Set a Marketing Budget for a Small Business →</p>
      <a href="/blog/marketing-budget-small-business/" style="background: var(--teal); color: var(--navy); font-weight: 700; font-size: var(--text-sm); padding: var(--space-2) var(--space-5); border-radius: var(--radius); text-decoration:none; white-space:nowrap;">Read now →</a>
    </div>

    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-4) 0 var(--space-6); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">💸 Ad Spend Meaning: Definition, ROAS Formula & 2026 Benchmarks →</p>
      <a href="/blog/what-is-ad-spend/" style="background: var(--teal); color: var(--navy); font-weight: 700; font-size: var(--text-sm); padding: var(--space-2) var(--space-5); border-radius: var(--radius); text-decoration:none; white-space:nowrap;">Read now →</a>
    </div>


    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Marketing Budget Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Enter your annual revenue (or projected revenue for early-stage businesses). 2. Select your industry from the dropdown — planning benchmarks are pre-loaded. 3. Choose your growth stage: Maintain, Grow (+25%), or Aggressive (+60%). 4. Click Calculate — your annual, monthly, and weekly budget appear with a suggested channel allocation.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Example: A B2B services company with $2M revenue selects 'B2B Services' (7% benchmark) and 'Grow' stage. Recommended budget = $2M × 7% × 1.25 = $175,000/year ($14,583/month).
      </div>
    </div>

    <div style="background: var(--off-white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-6); margin: var(--space-8) 0;">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-3);">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">For survey figures and planning ranges by industry, see <a href="/marketing-budget-benchmarks/">Marketing Budget Benchmarks</a>. The <a href="/social-media-budget-calculator/">Social Media Budget Calculator</a> splits the paid and organic social share, and the <a href="/blog/inbound-marketing-cost/">Inbound Marketing Cost Guide</a> prices inbound programs. To split the digital share across channels, use the <a href="/digital-marketing-budget-calculator/">Digital Marketing Budget Calculator</a>.</p>
