---
import Base from '../layouts/Base.astro';
import { categories, guides, toolIcons, catIcons, calculatorCount } from '../data/calculators.js';

const slug        = '';
const title       = 'Free Marketing Calculators: ROI, Budget & Salary (2026)';
const description = 'Free marketing calculators for ROI, budget planning, conversion rate, email ROI, salary benchmarks, and campaign metrics. Instant results, no signup required.';

const iconTrend = toolIcons.trend;

const websiteSchema = {
  "@type": "WebPage",
  "name": "Free Marketing Calculators",
  "url": "https://freemarketingcalculator.com/",
  "description": "Free marketing calculators for ROI, budget, salary, conversion rate, email ROI, and more.",
  "publisher": { "@id": "https://freemarketingcalculator.com/#org" }
};
---

<Base title={title} description={description} slug={slug} schema={[websiteSchema]}>
  <section class="page-hero home-hero" aria-labelledby="home-h1">
    <div class="container home-hero-grid">
      <div>
        <p class="eyebrow">Free Marketing Tools — 2026</p>
        <h1 id="home-h1">Marketing Calculators</h1>
        <p class="citation">{calculatorCount} free marketing calculators for ROI, ROAS, CAC, budget planning, conversion rates, email performance, salary benchmarks, <a href="/blog/digital-marketing-metrics-guide/">CPM, CPC</a>, and more. Instant results. No signup. No email gate.</p>
        <p class="citation">The calculators cover five jobs: measuring return (ROI, CAC, email, automation, conversion rate), planning spend (budget, digital channel split, social media, inbound), pricing ads (ROAS, CPM, CPC, CPV, digital metrics), checking pay, and valuing an agency. Each page lists its formula, a worked example and sourced benchmarks.</p>
        <div class="hero-actions">
          <a href="#calculators" class="btn-hero-cta">Browse calculators <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a href="#guides" class="btn-secondary">Read the guides</a>
        </div>
        <ul class="trust-row">
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>{calculatorCount} calculators</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Free forever</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>Updated October 2026</li>
        </ul>
      </div>

      <!-- Live working mini ROI calculator -->
      <div class="live-calc-card">
        <div class="live-calc-card__header">
          <span class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconTrend}></svg></span>
          <div>
            <div class="live-calc-card__title">Marketing ROI Calculator</div>
            <div class="live-calc-card__sub">Live preview — type your own numbers</div>
          </div>
        </div>
        <div class="live-calc-card__body">
          <div class="hero-calc-inputs">
            <div class="field">
              <label for="hero-spend">Ad spend ($)</label>
              <input type="number" id="hero-spend" inputmode="decimal" value="12000" />
            </div>
            <div class="field">
              <label for="hero-revenue">Revenue ($)</label>
              <input type="number" id="hero-revenue" inputmode="decimal" value="37000" />
            </div>
          </div>
          <div class="live-calc-card__result" aria-live="polite">
            <div class="live-calc-card__result-label">Return on investment</div>
            <div class="live-calc-card__result-value" id="hero-roi">208%</div>
            <div class="live-calc-card__stats">
              <div><div class="live-calc-card__stat-value" id="hero-profit">$25,000</div><div class="live-calc-card__stat-label">Net profit</div></div>
              <div><div class="live-calc-card__stat-value" id="hero-multiple">3.1x</div><div class="live-calc-card__stat-label">Return multiple</div></div>
            </div>
          </div>
          <a href="/marketing-roi-calculator/" class="btn-calc">Open full calculator →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="home-section container" id="calculators">
    <nav class="quickjump" aria-label="Jump to category">
      {categories.map(cat => (
        <a href={`#cat-${cat.id}`} class="quickjump-pill">{cat.navName}</a>
      ))}
    </nav>

    {categories.map(cat => (
      <section class="cat-block" id={`cat-${cat.id}`} aria-labelledby={`cat-${cat.id}-h`}>
        <div class="mega__head">
          <span class="icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={catIcons[cat.icon]}></path></svg></span>
          <h2 id={`cat-${cat.id}-h`} class="cat-title">{cat.title}</h2>
        </div>
        <p class="cat-subtitle">{cat.subtitle}</p>
        <ul class="tool-grid">
          {cat.tools.map(tool => (
            <li>
              <a href={tool.href} class={`tool-card${tool.badge === 'popular' ? ' tool-card--popular' : ''}`}>
                <div class="tool-card__icon-row">
                  <div class="tool-card__icon-box">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={toolIcons[tool.icon]}></svg>
                  </div>
                  {tool.badge === 'popular' && <span class="tool-card__badge tool-card__badge--popular">Most popular</span>}
                  {tool.badge === 'new' && <span class="tool-card__badge tool-card__badge--new">New</span>}
                </div>
                <div class="tool-card__name">{tool.name}</div>
                <p class="tool-card__desc">{tool.desc}</p>
                <span class="tool-card__metric">{tool.metric}</span>
                <span class="tool-card__cta">Calculate →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="home-section container" id="guides" aria-labelledby="guides-h2">
    <div class="section-head">
      <div>
        <h2 id="guides-h2">Guides &amp; Benchmarks</h2>
        <p>Formulas, sourced benchmarks and worked examples behind the calculators</p>
      </div>
      <a href="/blog/">All guides →</a>
    </div>
    <ul class="tool-grid">
      {guides.map(g => (
        <li>
          <a href={g.href} class="tool-card">
            <span class="tool-card__tag">{g.tag}</span>
            <div class="tool-card__name">{g.name}</div>
            <p class="tool-card__desc">{g.desc}</p>
            <span class="tool-card__cta">Read guide →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
(function () {
  'use strict';

  var spendEl = document.getElementById('hero-spend');
  var revEl = document.getElementById('hero-revenue');
  var roiEl = document.getElementById('hero-roi');
  var profitEl = document.getElementById('hero-profit');
  var multEl = document.getElementById('hero-multiple');

  function calc() {
    var spend = parseFloat(spendEl.value);
    var rev = parseFloat(revEl.value);
    if (!(spend > 0) || isNaN(rev)) {
      roiEl.textContent = '—';
      profitEl.textContent = '—';
      multEl.textContent = '—';
      return;
    }
    var roi = ((rev - spend) / spend) * 100;
    roiEl.textContent = Math.round(roi) + '%';
    profitEl.textContent = '$' + Math.round(rev - spend).toLocaleString();
    multEl.textContent = (rev / spend).toFixed(1) + 'x';
  }

  if (spendEl && revEl) {
    spendEl.addEventListener('input', calc);
    revEl.addEventListener('input', calc);
    calc();
  }
})();
</script>
