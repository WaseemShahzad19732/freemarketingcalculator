---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'social-media-budget-calculator';
const title       = 'Social Media Budget Calculator — By Platform and Goal 2026';
const description = 'Calculate your social media marketing budget by platform and campaign goal. Benchmarks for paid and organic across Facebook, Instagram, TikTok, and LinkedIn.';

const platforms = [
  { name: 'Facebook / Instagram', cpm: 8.5,  cpc: 0.90, best: 'B2C, Retail, eCommerce' },
  { name: 'LinkedIn',             cpm: 35.0, cpc: 5.50, best: 'B2B, SaaS, Recruiting' },
  { name: 'TikTok',               cpm: 9.5,  cpc: 1.00, best: 'Gen Z, Consumer brands' },
  { name: 'Twitter / X',          cpm: 6.0,  cpc: 0.40, best: 'News, Tech, Finance' },
  { name: 'Pinterest',            cpm: 5.0,  cpc: 0.15, best: 'Home, Fashion, Food' },
  { name: 'YouTube',              cpm: 10.0, cpc: 2.00, best: 'Video, Brand awareness' },
];

const faqItems = [
  { q: 'How much should I spend on social media marketing?', a: 'The Gartner 2025 CMO Spend Survey of 402 CMOs found digital channels take 61.1% of total marketing spend and social advertising takes 12.2% of digital spend. That works out to about 7.5% of the total marketing budget, or roughly $7,450 of a $100,000 budget. Treat that as a reference point, not a target, and raise it if social channels bring in customers at a lower cost than other channels.' },
  { q: 'What is CPM in social media?', a: 'CPM (Cost Per Mille) is the cost to show your ad 1,000 times. This calculator uses planning CPMs of $8.50 for Facebook and Instagram, $35 for LinkedIn and $9.50 for TikTok, which are indicative values rather than survey averages. Check the CPM in your own ad account, because it changes with audience, season and creative.' },
  { q: 'How does the calculator estimate clicks and reach?', a: 'Impressions equal budget divided by CPM times 1,000. Unique reach divides impressions by an assumed frequency of 2.5. Clicks apply a goal-based click-through rate of 0.8% for awareness, 1.8% for traffic, 1.2% for leads and 1.5% for conversions, the same on every platform. Replace these with the click-through rates reported in your own account when you have them.' },
  { q: 'How do I calculate how many impressions my budget will get?', a: 'Impressions = (Budget ÷ CPM) × 1,000. A $1,000 budget on Facebook ($9 CPM) gets approximately 111,000 impressions.' },
  { q: 'Which social media platform has the best ROI?', a: 'For B2C and eCommerce, Facebook and Instagram typically deliver the strongest ROI. For B2B, LinkedIn generates higher-quality leads despite its higher CPM. TikTok offers strong reach for younger demographics at lower cost.' },
  { q: 'Is this calculator free?', a: 'Yes — completely free, no signup, no email required.' },
];

const webAppSchema = { "@type": "WebApplication", "name": title, "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/social-media-budget-calculator/", "description": "Recommends paid and organic social media budget by platform and campaign goal, with CPM benchmarks for Facebook, Instagram, TikTok, LinkedIn, and Pinterest.", "featureList": ["Platform CPM benchmarks", "Impressions & reach calculator", "Budget allocation by goal"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" }, { "@type": "ListItem", "position": 2, "name": "Social Media Budget Calculator", "item": "https://freemarketingcalculator.com/social-media-budget-calculator/" }] };
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your monthly ad budget." },
{ "@type": "HowToStep", "position": 2, "text": "Select your primary platform." },
{ "@type": "HowToStep", "position": 3, "text": "Choose your campaign goal: awareness, traffic, leads, or conversions." },
{ "@type": "HowToStep", "position": 4, "text": "Click Calculate Reach to see estimated impressions, unique reach, and clicks." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Social Media Budget Calculator</h1>
      <p class="citation">Recommends paid and organic social media budget by platform and campaign goal, with 2026 CPM benchmarks for Facebook, Instagram, TikTok, LinkedIn, Pinterest, and YouTube.</p>
      <div class="meta-badges">
        <span class="badge">✓ 6 platforms</span>
        <span class="badge">✓ 2026 CPM benchmarks</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        </div>
        <div><div class="calc-card__title">Social Media Budget Calculator</div><div class="calc-card__subtitle">Enter your budget to see reach estimates by platform</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field-group">
          <div class="field"><label for="sm-budget">Monthly Ad Budget ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="sm-budget" class="has-prefix" placeholder="e.g. 2000" min="0"/></div></div>
          <div class="field"><label for="sm-platform">Primary Platform</label>
            <select id="sm-platform">
              <option value="8.5">Facebook / Instagram (planning CPM $8.50)</option>
              <option value="35">LinkedIn (planning CPM $35.00)</option>
              <option value="9.5">TikTok (planning CPM $9.50)</option>
              <option value="6">Twitter / X (planning CPM $6.00)</option>
              <option value="5">Pinterest (planning CPM $5.00)</option>
              <option value="10">YouTube (planning CPM $10.00)</option>
            </select>
          </div>
          <div class="field"><label for="sm-goal">Campaign Goal</label>
            <select id="sm-goal">
              <option value="awareness">Brand Awareness (CPM optimised)</option>
              <option value="traffic">Website Traffic (CPC optimised)</option>
              <option value="leads">Lead Generation</option>
              <option value="conversions">Conversions / Sales</option>
            </select>
          </div>
        </div>
        <button class="btn-calc" id="sm-calc-btn" type="button">Calculate Reach</button>
        <div class="result-panel" id="sm-result" aria-live="polite">
          <div class="result-panel__label">Estimated Monthly Impressions</div>
          <div class="result-panel__primary" id="sm-impressions">0</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sm-reach">0</span><span class="result-panel__stat-label">Est. unique reach</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sm-clicks">0</span><span class="result-panel__stat-label">Est. clicks</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sm-cpm-shown">$0</span><span class="result-panel__stat-label">CPM used</span></div>
          </div>
          <div class="result-verdict" id="sm-verdict"></div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">Formula</div>
      <p><strong>Impressions = (Budget ÷ CPM) × 1,000</strong><br/>
      Estimated Reach ≈ Impressions ÷ Average Frequency (typically 2–3×)<br/>
      Example: $1,000 ÷ $8.50 CPM × 1,000 = ~117,647 impressions</p>
    </div>

    <section class="bench-section">
      <h2>Social Media CPM and CPC: 2026 Planning Values</h2>
      <span class="bench-date">Updated October 2026</span>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th>Platform</th><th>Planning CPM</th><th>Planning CPC</th><th>Best For</th></tr></thead>
          <tbody>
            {platforms.map(p => (<tr><td>{p.name}</td><td>${p.cpm.toFixed(2)}</td><td>${p.cpc.toFixed(2)}</td><td>{p.best}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="bench-source">Planning values used by the calculator, not figures from a single published survey. CPM and CPC vary by industry, audience, season and ad quality, so use the rates in your own ad account when you have them. For the CPM formula, see <a href="/blog/what-is-cpm/">What Is CPM?</a></p>
    </section>


    <section class="bench-section" aria-labelledby="social-share-heading">
      <h2 id="social-share-heading">How Much of the Marketing Budget Goes to Social Advertising?</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">Social advertising takes 12.2% of digital marketing spend, and digital channels take 61.1% of total marketing spend, according to the <a href="https://www.businesswire.com/news/home/20250602746568/en/Gartner-Survey-Finds-Digital-Channels-Account-for-61.1-of-Total-Marketing-Spend" target="_blank" rel="noopener noreferrer nofollow">Gartner 2025 CMO Spend Survey</a> (402 CMOs, fielded February to March 2025).</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th scope="col">Measure</th><th scope="col">Share</th><th scope="col">On a $100,000 marketing budget</th></tr></thead>
          <tbody>
            <tr><td>Digital channels (share of total marketing spend)</td><td><strong>61.1%</strong></td><td>$61,100</td></tr>
            <tr style="background:var(--off-white)"><td>Social advertising (share of digital spend)</td><td><strong>12.2%</strong></td><td>$7,454</td></tr>
            <tr><td>Paid search (share of digital spend)</td><td>13.9%</td><td>$8,493</td></tr>
            <tr style="background:var(--off-white)"><td>Digital display (share of digital spend)</td><td>12.5%</td><td>$7,638</td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Dollar amounts are calculated from the published shares; social advertising is about 7.5% of total marketing spend (61.1% × 12.2%). To set the total first, see the <a href="/marketing-budget-calculator/">Marketing Budget Calculator</a> and the <a href="/marketing-budget-benchmarks/">budget benchmarks</a>.</p>
    </section>

    <section class="bench-section" aria-labelledby="social-example-heading">
      <h2 id="social-example-heading">Social Budget Worked Example: $3,000 on Facebook vs LinkedIn</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">A $3,000 lead generation budget buys about 352,941 impressions on Facebook at an $8.50 CPM but only about 85,714 on LinkedIn at a $35 CPM, which is 4.1 times fewer. The comparison below uses the calculator's lead generation click-through rate of 1.2% on both platforms.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th scope="col">Step</th><th scope="col">Facebook / Instagram</th><th scope="col">LinkedIn</th></tr></thead>
          <tbody>
            <tr><td>Budget</td><td>$3,000</td><td>$3,000</td></tr>
            <tr style="background:var(--off-white)"><td>Planning CPM</td><td>$8.50</td><td>$35.00</td></tr>
            <tr><td>Impressions ($3,000 ÷ CPM × 1,000)</td><td><strong>352,941</strong></td><td><strong>85,714</strong></td></tr>
            <tr style="background:var(--off-white)"><td>Estimated unique reach (÷ 2.5 frequency)</td><td>141,176</td><td>34,286</td></tr>
            <tr><td>Clicks at 1.2% CTR</td><td><strong>4,235</strong></td><td><strong>1,029</strong></td></tr>
            <tr style="background:var(--off-white)"><td>Cost per click ($3,000 ÷ clicks)</td><td>$0.71</td><td>$2.92</td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">The calculator applies the same click-through rate to every platform, so the table shows reach and cost per click, not lead quality. B2B audiences on LinkedIn are priced at a premium for job-title targeting; compare cost per qualified lead with the <a href="/cac-calculator/">CAC Calculator</a> before shifting budget.</p>
    </section>

    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Social Media Budget Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Enter your monthly ad budget. 2. Select your primary platform — each has a different average CPM pre-loaded. 3. Choose your campaign goal (awareness, traffic, leads, conversions). 4. Click Calculate Reach to see estimated impressions, unique reach, and clicks.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Example: $2,000 budget on Facebook ($8.50 CPM). Impressions = ($2,000 ÷ $8.50) × 1,000 = 235,294 impressions. Estimated unique reach ≈ 94,000 users at 2.5× average frequency.
      </div>
    </div>

    <div style="background: var(--off-white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-6); margin: var(--space-8) 0;">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-3);">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">Social budgets are usually a share of the total marketing budget. The <a href="/blog/marketing-budget-small-business/">Small Business Marketing Budget Guide</a> explains how to set that total, the <a href="/marketing-budget-calculator/">Marketing Budget Calculator</a> suggests a percentage of revenue, and the <a href="/cpm-calculator/">CPM Calculator</a> converts a paid budget into impressions.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3);"><a href="/blog/marketing-budget-small-business/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Small Business Marketing Budget Guide →</a><a href="/marketing-budget-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Marketing Budget Calculator →</a><a href="/marketing-budget-benchmarks/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Marketing Budget Benchmarks →</a><a href="/cpm-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">CPM Calculator →</a></div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script>
(function(){
  'use strict';
  const btn = document.getElementById('sm-calc-btn');
  const result = document.getElementById('sm-result');
  if (!btn) return;
  btn.addEventListener('click', () => {
    const budget   = parseFloat(document.getElementById('sm-budget').value) || 0;
    const cpm      = parseFloat(document.getElementById('sm-platform').value) || 8.5;
    const goal     = document.getElementById('sm-goal').value;
    if (!budget) return;
    const impressions = (budget / cpm) * 1000;
    const freq        = 2.5;
    const reach       = Math.round(impressions / freq);
    const ctr         = goal === 'traffic' ? 0.018 : goal === 'leads' ? 0.012 : goal === 'conversions' ? 0.015 : 0.008;
    const clicks      = Math.round(impressions * ctr);
    document.getElementById('sm-impressions').textContent = Math.round(impressions).toLocaleString();
    document.getElementById('sm-reach').textContent       = reach.toLocaleString();
    document.getElementById('sm-clicks').textContent      = clicks.toLocaleString();
    document.getElementById('sm-cpm-shown').textContent   = '$' + cpm.toFixed(2);
    document.getElementById('sm-verdict').textContent     = '📊 Budget of $' + budget.toLocaleString() + ' at $' + cpm + ' CPM = ' + Math.round(impressions).toLocaleString() + ' impressions, ~' + reach.toLocaleString() + ' unique users reached';
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
