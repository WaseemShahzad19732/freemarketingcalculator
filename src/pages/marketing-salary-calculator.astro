---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'marketing-salary-calculator';
const title       = 'Marketing Salary Calculator — By Role, Level and Location 2026';
const description = 'Marketing salary calculator by role, level and US city, with a marketing manager salary comparison by city and the BLS median pay. Free, no signup.';

// Salary data: [entry, mid, senior, director, exec] in $K
const salaryData: Record<string, number[]> = {
  'marketing-manager':        [55, 72, 90, 110, 135],
  'digital-marketing-manager':[52, 68, 85, 105, 125],
  'content-marketer':         [45, 60, 78, 95,  115],
  'seo-specialist':           [48, 63, 82, 100, 118],
  'paid-media-manager':       [52, 68, 88, 108, 128],
  'marketing-director':       [90, 115, 140, 165, 190],
  'vp-marketing':             [120, 150, 180, 210, 250],
  'cmo':                      [150, 190, 235, 285, 350],
  'product-marketing-manager':[65, 85, 108, 132, 155],
  'email-marketing-specialist':[45, 58, 74, 90, 108],
};

// Location multipliers
const locationMult: Record<string, number> = {
  'national': 1.0, 'new-york': 1.35, 'san-francisco': 1.45,
  'los-angeles': 1.25, 'chicago': 1.10, 'austin': 1.05,
  'seattle': 1.20, 'boston': 1.18, 'miami': 1.02, 'remote': 0.95,
};

const faqItems = [
  { q: 'What is the average marketing manager salary in the US?', a: 'The U.S. Bureau of Labor Statistics reports a median annual wage of $166,790 for marketing managers in May 2025, with the lowest 10% earning under $90,260 and the highest 10% earning over $293,610. This calculator estimates a national mid-level marketing manager at about $72,000 base salary, which is lower because its tiers include entry and mid-level roles and use different data. Treat the BLS figure as the reference for the managerial occupation and the calculator as a planning estimate.' },
  { q: 'How much does a CMO make?', a: 'This calculator estimates a CMO base salary between $150,000 for an entry-tier title and $350,000 for an executive-tier title at the national average. Total compensation for chief marketing officers usually includes bonuses and equity, which the calculator excludes. Company size and industry drive the largest differences.' },
  { q: 'What is the highest paying marketing job?', a: 'CMO and VP of Marketing are the highest-paid roles in this calculator, with executive-tier CMO base salary estimated at $350,000 and VP of Marketing at $250,000. Marketing director and product marketing manager roles follow. Equity at technology companies can raise total compensation well above base salary.' },
  { q: 'How much do digital marketing specialists earn?', a: 'This calculator estimates specialist base salaries from $45,000 for an entry-level email marketing specialist to $118,000 for an executive-tier SEO specialist. Mid-level SEO specialists are estimated at $63,000 and mid-level paid media managers at $68,000. Specialisation, seniority and city shift the result.' },
  { q: 'How does marketing manager salary compare by city?', a: 'In this calculator, a mid-level marketing manager earns an estimated $104,000 in San Francisco, $97,000 in New York, $72,000 at the US national average and $68,000 fully remote. The city multipliers run from 1.45 for San Francisco to 0.95 for remote roles. The marketing manager salary comparison table on this page lists all ten markets with low, midpoint and high estimates.' },
  { q: 'How does this calculator estimate salary?', a: 'The calculator takes a base salary for the chosen role and seniority level, multiplies it by a location factor, and then shows a low estimate at 85% and a high estimate at 118% of that midpoint. The results are base-salary estimates and exclude bonuses, equity and benefits. They are planning figures, not survey results.' },
  { q: 'Is the BLS marketing manager median the same as this calculator?', a: 'No. The BLS median of $166,790 for marketing managers comes from the Occupational Employment and Wage Statistics programme for May 2025, while the calculator uses its own role-by-level estimates and city multipliers. The two differ in scope and method, so the BLS figure and the calculator output should not be averaged together.' },
  { q: 'Is this calculator free?', a: 'Yes, the calculator is completely free, with no signup and no email required.' },
];

const webAppSchema = { "@type": "WebApplication", "name": title, "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/marketing-salary-calculator/", "description": "Estimates marketing salary range by role, seniority level, and US location — covering managers, directors, VPs, CMOs, and channel specialists.", "featureList": ["10 marketing roles", "5 seniority levels", "10 US locations"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" }, { "@type": "ListItem", "position": 2, "name": "Marketing Salary Calculator", "item": "https://freemarketingcalculator.com/marketing-salary-calculator/" }] };
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Select your marketing role from the dropdown." },
{ "@type": "HowToStep", "position": 2, "text": "Choose your seniority level: Entry, Mid, Senior, Director, or Executive." },
{ "@type": "HowToStep", "position": 3, "text": "Select your US city, or choose National Average or Fully Remote." },
{ "@type": "HowToStep", "position": 4, "text": "Click Get Salary Range \u2014 your low, midpoint, and high estimates appear." }
] };

const salaryJSON = JSON.stringify(salaryData);
const locationJSON = JSON.stringify(locationMult);
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Marketing Salary Calculator</h1>
      <p class="citation">Estimates marketing salary range by role, seniority level and US location, with a marketing manager salary comparison across 10 US markets. The U.S. Bureau of Labor Statistics reports a $166,790 median for marketing managers (May 2025).</p>
      <div class="meta-badges">
        <span class="badge">🔄 Updated October 2026</span>
        <span class="badge">✓ 10 roles covered</span>
        <span class="badge">✓ City-level adjustments</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <div><div class="calc-card__title">Marketing Salary Calculator</div><div class="calc-card__subtitle">Select your role, level, and location</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field-group">
          <div class="field"><label for="sal-role">Marketing Role</label>
            <select id="sal-role">
              <option value="marketing-manager">Marketing Manager</option>
              <option value="digital-marketing-manager">Digital Marketing Manager</option>
              <option value="content-marketer">Content Marketer / Strategist</option>
              <option value="seo-specialist">SEO Specialist</option>
              <option value="paid-media-manager">Paid Media Manager (PPC/SEM)</option>
              <option value="email-marketing-specialist">Email Marketing Specialist</option>
              <option value="product-marketing-manager">Product Marketing Manager</option>
              <option value="marketing-director">Marketing Director</option>
              <option value="vp-marketing">VP of Marketing</option>
              <option value="cmo">Chief Marketing Officer (CMO)</option>
            </select>
          </div>
          <div class="field"><label for="sal-level">Seniority Level</label>
            <select id="sal-level">
              <option value="0">Entry-level (0–2 years)</option>
              <option value="1" selected>Mid-level (3–5 years)</option>
              <option value="2">Senior (6–10 years)</option>
              <option value="3">Director / Lead (10–15 years)</option>
              <option value="4">Executive / C-suite (15+ years)</option>
            </select>
          </div>
          <div class="field"><label for="sal-location">US Location</label>
            <select id="sal-location">
              <option value="national">US National Average</option>
              <option value="new-york">New York City, NY</option>
              <option value="san-francisco">San Francisco / Bay Area, CA</option>
              <option value="los-angeles">Los Angeles, CA</option>
              <option value="chicago">Chicago, IL</option>
              <option value="austin">Austin, TX</option>
              <option value="seattle">Seattle, WA</option>
              <option value="boston">Boston, MA</option>
              <option value="miami">Miami, FL</option>
              <option value="remote">Fully Remote</option>
            </select>
          </div>
        </div>
        <button class="btn-calc" id="sal-calc-btn" type="button">Get Salary Range</button>
        <div class="result-panel" id="sal-result" aria-live="polite">
          <div class="result-panel__label">Estimated Annual Salary Range</div>
          <div class="result-panel__primary" id="sal-primary">$0K – $0K</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sal-low">$0</span><span class="result-panel__stat-label">Low estimate</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sal-mid">$0</span><span class="result-panel__stat-label">Midpoint</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="sal-high">$0</span><span class="result-panel__stat-label">High estimate</span></div>
          </div>
          <div class="result-verdict" id="sal-verdict"></div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">About This Data</div>
      <p>The ranges in this calculator are planning estimates of base salary by role, seniority level and US city. They exclude bonuses, equity and benefits, and they are not survey results. The U.S. Bureau of Labor Statistics (BLS) publishes the official wage statistics for the managerial occupations shown below, and its figures are higher than this calculator's marketing manager estimates.</p>
    </div>
    <div class="definition-box" style="margin-top: var(--space-4);">
      <div class="definition-box__label">Key Takeaways</div>
      <ul style="margin: var(--space-2) 0 0 var(--space-5); color: var(--text-mid); line-height: 1.8;">
        <li>BLS reports a $166,790 median wage for marketing managers in May 2025.</li>
        <li>This calculator estimates a national mid-level marketing manager at about $72,000 base salary.</li>
        <li>San Francisco adds an estimated 45% to the national figure and New York 35%; remote roles subtract 5%.</li>
        <li>All figures are base salary and exclude bonuses, equity and benefits.</li>
      </ul>
    </div>

    <section class="bench-section" aria-labelledby="bls-heading" style="margin-top: var(--space-8);">
      <h2 id="bls-heading">BLS Marketing Manager Pay — May 2025</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">The U.S. Bureau of Labor Statistics reports a median annual wage of $166,790 for marketing managers and $133,660 for advertising and promotions managers in May 2025. The table shows the wage distribution and the projected growth for each occupation.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead>
            <tr><th scope="col">Occupation</th><th scope="col">Median Wage</th><th scope="col">Lowest 10%</th><th scope="col">Highest 10%</th><th scope="col">Job Growth 2025–35</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Marketing managers</strong></td><td>$166,790</td><td>Under $90,260</td><td>Over $293,610</td><td>7%</td></tr>
            <tr style="background:var(--off-white)"><td><strong>Advertising and promotions managers</strong></td><td>$133,660</td><td>Under $63,300</td><td>Over $286,240</td><td>−4%</td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Source: <a href="https://www.bls.gov/ooh/management/advertising-promotions-and-marketing-managers.htm" target="_blank" rel="noopener noreferrer nofollow">U.S. Bureau of Labor Statistics, Occupational Outlook Handbook: Advertising, Promotions, and Marketing Managers</a>. The calculator's estimates use a different scope and method, so the two should be compared as separate references.</p>
    </section>


    <!-- TASK 8: Salary comparison table -->
    <section class="bench-section" aria-labelledby="salary-compare-heading" style="margin-top: var(--space-8);">
      <h2 id="salary-compare-heading">Marketing Salary Comparison by Role — 2026</h2>
      <span class="bench-date">Updated October 2026</span>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Entry Level</th>
              <th scope="col">Mid-Level</th>
              <th scope="col">Senior</th>
              <th scope="col">Director+</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Marketing Manager</strong></td>
              <td>$55–68K</td><td>$68–88K</td><td>$88–110K</td><td>$110–135K</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Digital Marketing Manager</strong></td>
              <td>$52–65K</td><td>$65–85K</td><td>$85–108K</td><td>$105–128K</td>
            </tr>
            <tr>
              <td><strong>SEO Specialist</strong></td>
              <td>$48–60K</td><td>$60–80K</td><td>$80–102K</td><td>$100–120K</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Paid Media Manager</strong></td>
              <td>$52–65K</td><td>$65–88K</td><td>$88–112K</td><td>$108–132K</td>
            </tr>
            <tr>
              <td><strong>Content Marketer</strong></td>
              <td>$45–58K</td><td>$58–75K</td><td>$75–95K</td><td>$95–118K</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Email Marketing Specialist</strong></td>
              <td>$45–56K</td><td>$56–72K</td><td>$72–92K</td><td>$90–110K</td>
            </tr>
            <tr>
              <td><strong>Product Marketing Manager</strong></td>
              <td>$65–80K</td><td>$80–105K</td><td>$105–132K</td><td>$130–158K</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Marketing Director</strong></td>
              <td>—</td><td>$90–115K</td><td>$115–145K</td><td>$145–190K</td>
            </tr>
            <tr>
              <td><strong>VP of Marketing</strong></td>
              <td>—</td><td>$120–150K</td><td>$150–185K</td><td>$185–255K</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>CMO</strong></td>
              <td>—</td><td>$150–200K</td><td>$200–275K</td><td>$275–400K+</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Calculator estimates of US national base salary by role and level; these are planning figures, not survey results. They do not include bonuses, equity or benefits. For official wage statistics see the BLS table above.</p>
    </section>

    <!-- Marketing Manager salary comparison by city -->
    <section class="bench-section" aria-labelledby="salary-city-compare-heading" style="margin-top: var(--space-8);">
      <h2 id="salary-city-compare-heading">Marketing Manager Salary Comparison by City — 2026</h2>
      <span class="bench-date">Updated October 2026</span>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">A mid-level marketing manager earns an estimated $72K base salary at the US national average in this calculator, ranging from $104K in San Francisco to $68K fully remote. The table covers the 10 US markets this calculator supports and uses the mid-level (3–5 years) tier.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead>
            <tr>
              <th scope="col">City</th>
              <th scope="col">Low Estimate</th>
              <th scope="col">Midpoint</th>
              <th scope="col">High Estimate</th>
              <th scope="col">vs National</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>San Francisco, CA</strong></td>
              <td>$88K</td>
              <td><strong>$104K</strong></td>
              <td>$123K</td>
              <td>+45%</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>New York, NY</strong></td>
              <td>$82K</td>
              <td><strong>$97K</strong></td>
              <td>$114K</td>
              <td>+35%</td>
            </tr>
            <tr>
              <td><strong>Los Angeles, CA</strong></td>
              <td>$76K</td>
              <td><strong>$90K</strong></td>
              <td>$106K</td>
              <td>+25%</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Seattle, WA</strong></td>
              <td>$73K</td>
              <td><strong>$86K</strong></td>
              <td>$101K</td>
              <td>+20%</td>
            </tr>
            <tr>
              <td><strong>Boston, MA</strong></td>
              <td>$72K</td>
              <td><strong>$85K</strong></td>
              <td>$100K</td>
              <td>+18%</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Chicago, IL</strong></td>
              <td>$67K</td>
              <td><strong>$79K</strong></td>
              <td>$93K</td>
              <td>+10%</td>
            </tr>
            <tr>
              <td><strong>Austin, TX</strong></td>
              <td>$65K</td>
              <td><strong>$76K</strong></td>
              <td>$90K</td>
              <td>+5%</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Miami, FL</strong></td>
              <td>$62K</td>
              <td><strong>$73K</strong></td>
              <td>$86K</td>
              <td>+2%</td>
            </tr>
            <tr>
              <td><strong>US National Average</strong></td>
              <td>$61K</td>
              <td><strong>$72K</strong></td>
              <td>$85K</td>
              <td>+0%</td>
            </tr>
            <tr style="background:var(--off-white)">
              <td><strong>Fully Remote</strong></td>
              <td>$58K</td>
              <td><strong>$68K</strong></td>
              <td>$80K</td>
              <td>-5%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Calculated from the $72K national mid-level marketing manager base and the calculator's location multipliers (low = 85%, high = 118% of midpoint). Compare with the <a href="#bls-heading">BLS median</a> and use the calculator above for your exact role, seniority and city.</p>
    </section>


    <!-- TASK 23: Related guide link -->
    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">📖 Marketing Salaries in 2026 — read the full marketing salary guide by role and city →</p>
      <a href="/blog/marketing-salary-guide/" style="background: var(--teal); color: var(--navy); font-weight: 700; font-size: var(--text-sm); padding: var(--space-2) var(--space-5); border-radius: var(--radius); text-decoration:none; white-space:nowrap;">Read now →</a>
    </div>


    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Marketing Salary Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Select your marketing role from the dropdown (10 roles available, from Email Marketing Specialist to CMO). 2. Choose your seniority level (Entry / Mid / Senior / Director / Executive). 3. Select your US city or choose 'US National Average' or 'Fully Remote'. 4. Click Get Salary Range — your low, midpoint, and high estimates appear with the location adjustment explained.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Senior Digital Marketing Manager in New York City. National midpoint $85K × 1.35 NYC multiplier = $114,750 midpoint. Range: $98K–$135K.
      </div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script define:vars={{ salaryJSON, locationJSON }}>
(function(){
  'use strict';
  const salaryData   = JSON.parse(salaryJSON);
  const locationMult = JSON.parse(locationJSON);
  const btn = document.getElementById('sal-calc-btn');
  const result = document.getElementById('sal-result');
  if (!btn) return;
  btn.addEventListener('click', () => {
    const role     = document.getElementById('sal-role').value;
    const level    = parseInt(document.getElementById('sal-level').value);
    const location = document.getElementById('sal-location').value;
    const base     = (salaryData[role] || [60,75,95,115,140])[level];
    const mult     = locationMult[location] || 1.0;
    const mid      = Math.round(base * mult);
    const low      = Math.round(mid * 0.85);
    const high     = Math.round(mid * 1.18);
    document.getElementById('sal-primary').textContent = '$' + low + 'K – $' + high + 'K';
    document.getElementById('sal-low').textContent     = '$' + low + 'K';
    document.getElementById('sal-mid').textContent     = '$' + mid + 'K';
    document.getElementById('sal-high').textContent    = '$' + high + 'K';
    const locLabel = document.getElementById('sal-location').options[document.getElementById('sal-location').selectedIndex].text;
    document.getElementById('sal-verdict').textContent = '📍 ' + locLabel + ' adjustment applied (' + (mult >= 1 ? '+' : '') + Math.round((mult - 1) * 100) + '% vs national average)';
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
