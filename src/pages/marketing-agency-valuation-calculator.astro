---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'marketing-agency-valuation-calculator';
const title       = 'Marketing Agency Valuation Calculator — Free M&A Tool (2026)';
const description = 'Free marketing agency valuation calculator: estimate your agency value from revenue, EBITDA margin and client retention using sourced 2026 valuation multiples.';

const multiples = [
  { type: 'Full-service agency',       revMult: '0.4–1.0×', ebitdaMult: '3–7×',  fps: '4.9× (digital marketing)' },
  { type: 'SEO / Content agency',      revMult: '0.4–1.0×', ebitdaMult: '3–7×',  fps: '—' },
  { type: 'Paid media / PPC agency',   revMult: '0.4–1.0×', ebitdaMult: '3–7×',  fps: '5.0× (performance marketing)' },
  { type: 'Social media agency',       revMult: '0.4–1.0×', ebitdaMult: '3–7×',  fps: '5.3×' },
  { type: 'Tech-enabled / SaaS hybrid',revMult: '0.4–1.0×', ebitdaMult: '4–9×',  fps: '—' },
  { type: 'Creative / Brand agency',   revMult: '0.4–1.0×', ebitdaMult: '3–7×',  fps: '4.6×' },
];

const faqItems = [
  { q: 'How much is a digital marketing agency worth?', a: 'A digital marketing agency is typically worth 3 to 7 times its adjusted EBITDA, according to FE International (May 2026), with larger and more specialised agencies reaching 8 to 12 times. Revenue multiples run 0.4 to 1.0 times trailing revenue and serve as a sanity check. An agency with $600,000 of EBITDA is worth about $1.8 million to $3.0 million at 3x to 5x.' },
  { q: 'What multiple do marketing agencies sell for?', a: 'FE International reports 2.5x to 4x EBITDA for agencies under $500,000 of EBITDA and 7x to 12x above $5 million. First Page Sage reports 4.9x for digital marketing agencies with $1M to $3M of EBITDA (Q1 2025). Retainer revenue above 60% adds 1x to 2x, and a client above 30% to 40% of revenue subtracts 1.5x to 2x.' },
  { q: 'What factors increase agency valuation?', a: 'Retainer revenue above 60%, sustained growth of 15% or more, specialisation, a strong leadership bench and low client concentration all raise the multiple. FE International puts the retainer premium at 1x to 2x. Documented processes that do not depend on the founder also help.' },
  { q: 'What is EBITDA for a marketing agency?', a: 'EBITDA (earnings before interest, taxes, depreciation and amortisation) is operating profit before non-cash expenses. For agencies, calculate: revenue − staff costs − contractor costs − software and tools − office and overhead = EBITDA. Buyers value the adjusted figure, which adds back owner pay above a market salary and one-off costs.' },
  { q: 'Why does the calculator show such a wide range?', a: 'The range runs from the lowest result to the highest result across the revenue method and the EBITDA method. Revenue multiples are a floor or sanity check, while EBITDA multiples reflect profitability, so the two can differ widely. For agencies with positive EBITDA, treat the EBITDA method as the main estimate.' },
  { q: 'How does client retention change the estimate?', a: 'The calculator applies a 10% premium to the multiples when retention is 90% or higher and a 10% discount when retention is below 70%. This is a simplified adjustment, not a published rule. Real buyers weigh retainer share, contract length and client concentration more heavily.' },
  { q: 'Is this calculator free?', a: 'Yes. The calculator is completely free, with no signup and no email required.' },
];

const webAppSchema = { "@type": "WebApplication", "name": title, "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/marketing-agency-valuation-calculator/", "description": "Estimates a digital marketing agency market value using annual recurring revenue, EBITDA margin, client retention rate, and service mix with current industry multiples.", "featureList": ["Revenue multiple valuation", "EBITDA multiple valuation", "2026 M&A benchmark multiples"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" }, { "@type": "ListItem", "position": 2, "name": "Marketing Agency Valuation Calculator", "item": "https://freemarketingcalculator.com/marketing-agency-valuation-calculator/" }] };
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your agency's annual revenue." },
{ "@type": "HowToStep", "position": 2, "text": "Enter your EBITDA margin percentage." },
{ "@type": "HowToStep", "position": 3, "text": "Enter your client retention rate and select your agency type." },
{ "@type": "HowToStep", "position": 4, "text": "Click Calculate \u2014 you get both revenue method and EBITDA method valuations with a range." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Marketing Agency Valuation Calculator</h1>
      <p class="citation">Estimates a digital marketing agency's market value by entering annual revenue, EBITDA margin, client retention rate, and service type — outputs a valuation range using sourced 2026 valuation multiples. Most agencies sell for 3 to 7 times adjusted EBITDA.</p>
      <div class="meta-badges">
        <span class="badge">✓ Revenue & EBITDA methods</span>
        <span class="badge">✓ 2026 M&A multiples</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div><div class="calc-card__title">Agency Valuation Calculator</div><div class="calc-card__subtitle">Enter your agency financials for an estimated range</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field-group">
          <div class="field"><label for="ag-revenue">Annual Revenue ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="ag-revenue" class="has-prefix" placeholder="e.g. 1500000" min="0"/></div></div>
          <div class="field"><label for="ag-ebitda">EBITDA Margin (%)</label><div class="input-wrap"><input type="number" id="ag-ebitda" class="has-suffix" placeholder="e.g. 22" min="0" max="100" step="0.5"/><span class="input-suffix">%</span></div><p class="hint">Profit after staff, contractors, tools, and overhead — before tax, interest and depreciation</p></div>
          <div class="field"><label for="ag-retention">Client Retention Rate (%)</label><div class="input-wrap"><input type="number" id="ag-retention" class="has-suffix" placeholder="e.g. 85" min="0" max="100"/><span class="input-suffix">%</span></div></div>
          <div class="field"><label for="ag-type">Agency Type</label>
            <select id="ag-type">
              <option value="full-service">Full-service agency</option>
              <option value="seo">SEO / Content agency</option>
              <option value="paid">Paid media / PPC agency</option>
              <option value="social">Social media agency</option>
              <option value="tech">Tech-enabled / SaaS hybrid</option>
              <option value="creative">Creative / Brand agency</option>
            </select>
          </div>
        </div>
        <button class="btn-calc" id="ag-calc-btn" type="button">Calculate Valuation</button>
        <div class="result-panel" id="ag-result" aria-live="polite">
          <div class="result-panel__label">Estimated Agency Valuation Range</div>
          <div class="result-panel__primary" id="ag-primary">$0 – $0</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ag-rev-val">$0</span><span class="result-panel__stat-label">Revenue method</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ag-ebitda-val">$0</span><span class="result-panel__stat-label">EBITDA method</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ag-ebitda-amt">$0</span><span class="result-panel__stat-label">Annual EBITDA</span></div>
          </div>
          <div class="result-verdict" id="ag-verdict"></div>
        </div>
      </div>
    </div>

    <div class="formula-box">
      <p class="formula-title">Valuation Methods</p>
      <p class="formula-text">Revenue Method: Agency Value = Annual Revenue × Revenue Multiple<br/>EBITDA Method: Agency Value = EBITDA × EBITDA Multiple</p>
      <div class="formula-example"><strong>Example:</strong> $1.5M revenue, 22% EBITDA ($330K), full-service agency → Revenue method: $1.5M × 0.7× (midpoint of 0.4–1.0×) = $1.05M | EBITDA method: $330K × 5× (midpoint of 3–7×) = $1.65M</div>
    </div>

    <section class="bench-section" aria-labelledby="mult-heading">
      <h2 id="mult-heading">Marketing Agency Valuation Multiples — 2026</h2>
      <span class="bench-date">Updated October 2026</span>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">Most digital marketing agencies sell for 3 to 7 times adjusted EBITDA, and the multiple rises with size: 2.5x to 4x under $500,000 of EBITDA and 7x to 12x above $5 million. The calculator uses 3–7x (4–9x for tech-enabled agencies) and 0.4–1.0x revenue.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th>Adjusted EBITDA</th><th>EBITDA Multiple</th></tr></thead>
          <tbody>
            <tr><td>Under $500,000</td><td>2.5x–4x</td></tr>
            <tr style="background:var(--off-white)"><td>$500,000–$1 million</td><td>3x–5x</td></tr>
            <tr><td>$1 million–$2.5 million</td><td>4x–6.5x</td></tr>
            <tr style="background:var(--off-white)"><td>$2.5 million–$5 million</td><td>5.5x–8.5x</td></tr>
            <tr><td>$5 million and above</td><td>7x–12x</td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Source: <a href="https://www.feinternational.com/blog/digital-marketing-agency-valuation" target="_blank" rel="noopener noreferrer nofollow">FE International, May 20, 2026</a> (bands validated by FE against PitchBook deal data). Revenue multiple of 0.4x–1.0x of trailing revenue is from the same source.</p>
      <h3 style="margin-top: var(--space-6);">Calculator ranges by agency type</h3>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th>Agency Type</th><th>Revenue Multiple</th><th>EBITDA Multiple</th><th>First Page Sage (Q1 2025, $1–3M EBITDA)</th></tr></thead>
          <tbody>{multiples.map(m => (<tr><td>{m.type}</td><td>{m.revMult}</td><td>{m.ebitdaMult}</td><td>{m.fps}</td></tr>))}</tbody>
        </table>
      </div>
      <p class="bench-source">Calculator ranges are planning ranges built on the FE International figures; the tech-enabled range adds FE's 1x–2x premium for demonstrated AI integration. First Page Sage figures are averages "based on M&amp;A deals and advisor input" as published in the <a href="https://legacyadvisors.io/2022-2025-u-s-digital-marketing-advertising-ma-report/" target="_blank" rel="noopener noreferrer nofollow">Legacy Advisors report</a>; no sample size is disclosed. Full comparison: <a href="/blog/marketing-agency-valuation-multiples/">marketing agency valuation multiples guide</a>.</p>
    </section>


    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Agency Valuation Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Enter your agency's annual revenue. 2. Enter your EBITDA margin % (revenue minus all staff, contractor, tool, and overhead costs — before tax and depreciation). 3. Enter your client retention rate. 4. Select your agency type (6 types with different valuation multiples). 5. Click Calculate — you get both revenue method and EBITDA method valuations with a range.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Example: $1.5M revenue, 22% EBITDA margin ($330K), 85% retention, full-service agency. Revenue method midpoint: $1.5M × 0.7× = $1.05M. EBITDA method midpoint: $330K × 5× = $1.65M. Range: $600K (revenue at 0.4×) to $2.31M (EBITDA at 7×).
      </div>
    </div>

    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">📖 Marketing Agency Valuation Multiples: 2026 benchmarks by size and type →</p>
      <a href="/blog/marketing-agency-valuation-multiples/" class="btn-inline">Read now →</a>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script>
(function(){
  'use strict';
  const btn = document.getElementById('ag-calc-btn');
  const result = document.getElementById('ag-result');
  if (!btn) return;

  const typeMultiples: Record<string, [number, number, number, number]> = {
    'full-service': [0.4, 1.0, 3, 7],
    'seo':          [0.4, 1.0, 3, 7],
    'paid':         [0.4, 1.0, 3, 7],
    'social':       [0.4, 1.0, 3, 7],
    'tech':         [0.4, 1.0, 4, 9],
    'creative':     [0.4, 1.0, 3, 7],
  };

  function fmt(n: number) {
    if (n >= 1000000) return '$' + (n/1000000).toFixed(2) + 'M';
    if (n >= 1000) return '$' + Math.round(n/1000) + 'K';
    return '$' + Math.round(n).toLocaleString();
  }

  btn.addEventListener('click', () => {
    const rev       = parseFloat((document.getElementById('ag-revenue') as HTMLInputElement).value) || 0;
    const margin    = parseFloat((document.getElementById('ag-ebitda') as HTMLInputElement).value) / 100 || 0;
    const retention = parseFloat((document.getElementById('ag-retention') as HTMLInputElement).value) || 80;
    const type      = (document.getElementById('ag-type') as HTMLSelectElement).value;
    if (!rev) return;
    const ebitda = rev * margin;
    const [revLo, revHi, ebitdaLo, ebitdaHi] = typeMultiples[type] || [0.4, 1.0, 3, 7];

    // Retention bonus: +10% to multiple if >90%, -10% if <70%
    const retBonus = retention >= 90 ? 1.1 : retention < 70 ? 0.9 : 1.0;

    const revVal    = (rev * ((revLo + revHi) / 2)) * retBonus;
    const ebitdaVal = ebitda > 0 ? (ebitda * ((ebitdaLo + ebitdaHi) / 2)) * retBonus : 0;
    const low       = Math.min(rev * revLo, ebitda > 0 ? ebitda * ebitdaLo : Infinity) * retBonus;
    const high      = Math.max(rev * revHi, ebitda > 0 ? ebitda * ebitdaHi : 0) * retBonus;

    document.getElementById('ag-primary').textContent   = fmt(low) + ' – ' + fmt(high);
    document.getElementById('ag-rev-val').textContent   = fmt(revVal);
    document.getElementById('ag-ebitda-val').textContent = ebitda > 0 ? fmt(ebitdaVal) : 'N/A (no profit)';
    document.getElementById('ag-ebitda-amt').textContent = fmt(ebitda);
    document.getElementById('ag-verdict').textContent   =
      retention >= 90 ? '✅ High retention (90%+) adds ~10% premium to valuation' :
      retention < 70  ? '⚠️ Low retention (<70%) reduces valuation by ~10% — improve client stickiness first' :
      '📊 Average retention — focus on retainer mix and EBITDA margin to maximise value';

    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
