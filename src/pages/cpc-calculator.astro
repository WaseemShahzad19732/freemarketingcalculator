---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'cpc-calculator';
const title       = 'CPC Calculator — Free Cost Per Click Tool (2026)';
const description = 'Free CPC calculator — calculate cost per click, total spend, or total clicks from any two values. See formulas, a worked example and a contribution-based break-even CPC.';



const faqItems = [
  { q: 'How do you calculate cost per click?', a: 'Divide ad spend by clicks for the same campaign and time period. For example, $500 divided by 250 clicks is $2 per click. Spend equals CPC multiplied by clicks; clicks equal spend divided by CPC.' },
  { q: 'What is a good CPC for my business?', a: 'Compare CPC with the contribution earned per click: conversion rate times contribution per order. A cheap click can still lose money if few visitors buy. Use the same click and conversion definitions and attribution window throughout.' },
  { q: 'How do you calculate break-even CPC?', a: 'Break-even CPC equals click-to-sale conversion rate times contribution per sale before advertising. At a $200 order value, 60% contribution margin and 3% conversion rate, the ceiling is $3.60. This covers advertising and the variable costs included in the margin, but excludes any uncounted overhead.' },
  { q: 'What is the difference between CPC and CPM?', a: 'CPC is spend per click; CPM is spend per thousand impressions. They can both be reported for the same campaign regardless of its billing model. CPC equals CPM divided by ten times CTR expressed as a percentage.' },
  { q: 'Is the CPC calculator free?', a: 'Yes. All three modes are free and require no signup.' },
];

const webAppSchema = { "@type": "WebApplication", "name": "CPC Calculator", "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/cpc-calculator/", "description": "Free CPC calculator with three modes — calculate CPC from spend and clicks, total spend from CPC and clicks, or total clicks from spend and CPC. Includes a break-even CPC example.", "featureList": ["CPC from spend + clicks", "Spend from CPC + clicks", "Clicks from spend + CPC", "Contribution-based CPC ceiling"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
  { "@type": "ListItem", "position": 2, "name": "CPC Calculator", "item": "https://freemarketingcalculator.com/cpc-calculator/" }
]};
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Select what you want to calculate: CPC, Total Spend, or Total Clicks." },
{ "@type": "HowToStep", "position": 2, "text": "Enter the two values you already know." },
{ "@type": "HowToStep", "position": 3, "text": "Click Calculate, then review the formula and assumptions below." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">CPC Calculator</h1>
      <p class="citation">Calculate Cost Per Click, total ad spend, or total clicks from any two values. Compare the result with a break-even ceiling based on your conversion rate and contribution margin.</p>
      <div class="meta-badges">
        <span class="badge">✓ 3 calculation modes</span>
        <span class="badge">✓ Break-even example</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">CPC Formula</div>
      <p><strong>CPC = Total Ad Spend ÷ Total Clicks</strong></p>
      <p style="margin-top: var(--space-2);">Example: $500 spend, 250 clicks → CPC = $500 ÷ 250 = <strong>$2.00 per click</strong></p>
      <p style="margin-top: var(--space-2);">Reverse: <strong>Clicks = Spend ÷ CPC</strong> &nbsp;|&nbsp; <strong>Spend = CPC × Clicks</strong></p>
    </div>

    <div class="calc-card" id="calculator" style="margin-top: var(--space-6);">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 15l6 6m-6-6v4.8m0-4.8h4.8"/><path d="M9 19.8V15m0 0H4.2M9 15l-6 6"/><path d="M15 4.2V9m0 0h4.8M15 9l6-6"/><path d="M9 4.2V9m0 0H4.2M9 9L3 3"/></svg>
        </div>
        <div><div class="calc-card__title">CPC Calculator</div><div class="calc-card__subtitle">Choose what you want to calculate</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field">
          <label>Calculate</label>
          <div class="mode-toggle" role="group">
            <button type="button" class="active" id="cpc-mode-cpc">CPC</button>
            <button type="button" id="cpc-mode-spend">Total Spend</button>
            <button type="button" id="cpc-mode-clicks">Total Clicks</button>
          </div>
        </div>

        <div id="cpc-inputs-cpc" class="field-group">
          <div class="field"><label for="cpc-spend">Total Ad Spend ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpc-spend" class="has-prefix" placeholder="e.g. 1000" min="0"/></div></div>
          <div class="field"><label for="cpc-clicks">Total Clicks</label><input type="number" id="cpc-clicks" placeholder="e.g. 450" min="0"/></div>
        </div>
        <div id="cpc-inputs-spend" class="field-group" style="display:none">
          <div class="field"><label for="cpc-rate">CPC Rate ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpc-rate" class="has-prefix" placeholder="e.g. 2.50" min="0" step="0.01"/></div></div>
          <div class="field"><label for="cpc-clicks-b">Target Clicks</label><input type="number" id="cpc-clicks-b" placeholder="e.g. 500" min="0"/></div>
        </div>
        <div id="cpc-inputs-clicks" class="field-group" style="display:none">
          <div class="field"><label for="cpc-spend-c">Total Ad Spend ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpc-spend-c" class="has-prefix" placeholder="e.g. 1200" min="0"/></div></div>
          <div class="field"><label for="cpc-rate-c">CPC Rate ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="cpc-rate-c" class="has-prefix" placeholder="e.g. 2.50" min="0" step="0.01"/></div></div>
        </div>

        <button class="btn-calc" id="cpc-calc-btn" type="button">Calculate</button>
        <div class="result-panel" id="cpc-result" aria-live="polite">
          <div class="result-panel__label" id="cpc-result-label">Cost Per Click (CPC)</div>
          <div class="result-panel__primary" id="cpc-primary">$0.00</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpc-s1">—</span><span class="result-panel__stat-label" id="cpc-l1">Ad spend</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpc-s2">—</span><span class="result-panel__stat-label" id="cpc-l2">Clicks</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="cpc-s3">—</span><span class="result-panel__stat-label" id="cpc-l3">Profitability</span></div>
          </div>
          <div class="result-verdict" id="cpc-verdict"></div>
          <p style="font-size: var(--text-xs); color: var(--text-light); margin-top: var(--space-2);">CPC alone cannot establish profitability. Use the contribution-based method below.</p>
        </div>
      </div>
    </div>

    <section class="bench-section" aria-labelledby="cpc-ceiling">
      <h2 id="cpc-ceiling">Maximum Allowable CPC: Use Contribution, Not Revenue</h2>
      <p>Break-even CPC = order value × contribution margin before ads × click-to-sale conversion rate. Contribution margin should account for product cost, payment fees, shipping subsidies and other variable costs. Use decimal rates: 60% = 0.60 and 3% = 0.03.</p>
      <div class="definition-box"><p><strong>$200 × 0.60 × 0.03 = $3.60 per click.</strong> At $2.88 CPC, the expected contribution after ads is $0.72 per click before fixed overhead. The $2.88 scenario reserves 20% of the $3.60 contribution; it is an example, not a recommended universal bidding rule.</p></div>
      <div class="bench-table-wrap"><table class="bench-table">
        <thead><tr><th scope="col">Illustrative conversion rate</th><th scope="col">Contribution per $200 sale</th><th scope="col">Break-even CPC</th></tr></thead>
        <tbody><tr><td>1%</td><td>$120</td><td>$1.20</td></tr><tr><td>3%</td><td>$120</td><td>$3.60</td></tr><tr><td>5%</td><td>$120</td><td>$6.00</td></tr></tbody>
      </table></div>
      <p>For a lead campaign, replace contribution per sale with lead-to-customer rate × contribution per customer. Count repeat purchases only when measured over a defined payback period. Use the <a href="/conversion-rate-calculator/">conversion rate calculator</a> to check the denominator and the <a href="/roas-calculator/">ROAS calculator</a> to compare revenue return.</p>
      <p class="bench-source">Method: original arithmetic scenarios, reviewed October 22, 2026. These are not platform or industry survey averages. Compare like-for-like campaign dates, networks and click definitions using your own ad account.</p>
    </section>

    <div class="related-box">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-4);">Related Calculators</p>
      <div class="link-grid">
        <a href="/cpm-calculator/" class="link-tile">🌐 CPM Calculator</a>
        <a href="/digital-marketing-calculator/" class="link-tile">📊 All 5 Metrics at Once</a>
        <a href="/conversion-rate-calculator/" class="link-tile">🔄 Conversion Rate Calculator</a>
        <a href="/marketing-roi-calculator/" class="link-tile">📈 Marketing ROI Calculator</a>
      </div>
    </div>

    <div class="related-box">
      <p class="related-box__label">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">Cost per click depends on CPM and click-through rate: CPC = CPM ÷ (CTR % × 10). The <a href="/blog/what-is-cpm/">What Is CPM?</a> guide shows the worked example, and the <a href="/blog/digital-marketing-metrics-guide/">Digital Marketing Metrics Guide</a> covers CPC next to CPA and ROAS.</p>
      <div class="link-grid"><a href="/blog/what-is-cpm/" class="link-tile">What Is CPM? →</a><a href="/blog/digital-marketing-metrics-guide/" class="link-tile">Digital Marketing Metrics Guide →</a><a href="/blog/what-is-ad-spend/" class="link-tile">What Is Ad Spend? →</a><a href="/roas-calculator/" class="link-tile">ROAS Calculator →</a></div>
    </div>

    <FAQ items={faqItems} title="CPC Calculator — FAQ" />
  </div>
</Base>

<script>
import { validateCalculator } from '../scripts/calc-validation.js';
(function(){
  'use strict';
  const modeBtns = { cpc: document.getElementById('cpc-mode-cpc'), spend: document.getElementById('cpc-mode-spend'), clicks: document.getElementById('cpc-mode-clicks') };
  const modeInputs = { cpc: document.getElementById('cpc-inputs-cpc'), spend: document.getElementById('cpc-inputs-spend'), clicks: document.getElementById('cpc-inputs-clicks') };
  const btn = document.getElementById('cpc-calc-btn');
  const result = document.getElementById('cpc-result');
  if (!btn) return;
  let mode = 'cpc';

  Object.entries(modeBtns).forEach(([m, b]) => {
    b.addEventListener('click', () => {
      mode = m;
      Object.values(modeBtns).forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      Object.values(modeInputs).forEach(i => i.style.display = 'none');
      modeInputs[m].style.display = 'grid';
    });
  });

  function getVerdict(cpc) {
    return 'Compare this CPC with conversion rate × contribution per sale. The result alone does not establish profit.';
  }

  btn.addEventListener('click', () => {
    if (!validateCalculator(btn)) return;
    const p = document.getElementById('cpc-primary');
    const rl = document.getElementById('cpc-result-label');
    const s1 = document.getElementById('cpc-s1'), l1 = document.getElementById('cpc-l1');
    const s2 = document.getElementById('cpc-s2'), l2 = document.getElementById('cpc-l2');
    const s3 = document.getElementById('cpc-s3');
    const v = document.getElementById('cpc-verdict');

    if (mode === 'cpc') {
      const spend = parseFloat(document.getElementById('cpc-spend').value) || 0;
      const clicks = parseFloat(document.getElementById('cpc-clicks').value) || 0;
      
      const cpc = spend / clicks;
      rl.textContent = 'Cost Per Click (CPC)';
      p.textContent = '$' + cpc.toFixed(2);
      s1.textContent = '$' + spend.toLocaleString(); l1.textContent = 'Ad spend';
      s2.textContent = clicks.toLocaleString(); l2.textContent = 'Clicks';
      s3.textContent = 'Needs margin';
      v.textContent = getVerdict(cpc);
    } else if (mode === 'spend') {
      const rate = parseFloat(document.getElementById('cpc-rate').value) || 0;
      const clicks = parseFloat(document.getElementById('cpc-clicks-b').value) || 0;
      
      const spend = rate * clicks;
      rl.textContent = 'Total Spend Required';
      p.textContent = '$' + spend.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
      s1.textContent = '$' + rate.toFixed(2); l1.textContent = 'CPC rate';
      s2.textContent = clicks.toLocaleString(); l2.textContent = 'Target clicks';
      s3.textContent = 'Needs margin';
      v.textContent = '💰 ' + clicks.toLocaleString() + ' clicks at $' + rate + ' CPC = $' + spend.toLocaleString('en-US', {minimumFractionDigits:2});
    } else {
      const spend = parseFloat(document.getElementById('cpc-spend-c').value) || 0;
      const rate = parseFloat(document.getElementById('cpc-rate-c').value) || 0;
      
      const clicks = Math.floor(spend / rate);
      rl.textContent = 'Expected Clicks';
      p.textContent = clicks.toLocaleString();
      s1.textContent = '$' + spend.toLocaleString(); l1.textContent = 'Ad spend';
      s2.textContent = '$' + rate.toFixed(2); l2.textContent = 'CPC rate';
      s3.textContent = 'Needs margin';
      v.textContent = '🖱️ $' + spend.toLocaleString() + ' ÷ $' + rate + ' CPC = ' + clicks.toLocaleString() + ' estimated clicks';
    }
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
