---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'cac-calculator';
const title       = 'CAC Calculator — Free Customer Acquisition Cost Tool (2026)';
const description = 'Free CAC calculator: divide sales and marketing spend by new customers, add an optional payback period, and compare with planning ranges by industry.';

const faqItems = [
  {
    q: 'How do you calculate Customer Acquisition Cost (CAC)?',
    a: '<strong>CAC = Total Sales & Marketing Expenses ÷ Number of New Customers Acquired</strong>. For example: $50,000 spent on marketing & sales to acquire 250 new customers = $50,000 ÷ 250 = <strong>$200 CAC</strong>.'
  },
  {
    q: 'What is the difference between Blended CAC and Paid CAC?',
    a: '<strong>Blended CAC</strong> includes all marketing expenses, sales salaries, tools, and overhead divided by total customers (organic + paid). <strong>Paid CAC</strong> measures direct ad spend divided only by customers acquired through paid channels.'
  },
  {
    q: 'What is a good LTV:CAC ratio?',
    a: 'A healthy benchmark for SaaS and subscription businesses is <strong>3:1 (LTV:CAC)</strong> — meaning customer lifetime value is 3x higher than acquisition cost. Anything below 1:1 means you lose money acquiring customers.'
  },
  {
    q: 'Why is paid CAC often higher than blended CAC?',
    a: 'Blended CAC spreads total sales and marketing spend across every new customer, including those who arrived through organic search, referrals or word of mouth. Paid CAC divides only ad spend by customers from paid channels, so it carries no organic customers to dilute it. For example, $50,000 of total spend and 250 customers gives a $200 blended CAC, while $30,000 of ad spend and 100 paid customers gives a $300 paid CAC.'
  },
  {
    q: 'What is a good CAC payback period?',
    a: 'A good CAC payback period is one that sits well inside the time a customer stays, so that gross profit from the customer exceeds acquisition cost several times over. Published SaaS payback benchmarks differ by source and by sales motion, with longer paybacks accepted for mid-market and enterprise deals than for self-serve products. This site does not quote a single benchmark because the available figures are not consistently sourced; use the payback input in the calculator and compare it with your own customer lifetime.'
  },
  {
    q: 'What is CAC Payback Period?',
    a: 'The payback period measures how many months it takes for a customer to generate enough gross profit to pay back their acquisition cost. Formula: <strong>Payback Months = CAC ÷ (ARPU × Gross Margin %)</strong>.'
  }
];

const industryBenchmarks = [
  { industry: 'ECommerce & Retail', typical: '$45', range: '$20–$100', bar: 25 },
  { industry: 'B2B SaaS (SMB)', typical: '$390', range: '$200–$800', bar: 55 },
  { industry: 'Enterprise Software', typical: '$1,450', range: '$800–$3,500', bar: 90 },
  { industry: 'Financial Services / Fintech', typical: '$280', range: '$150–$600', bar: 48 },
  { industry: 'Healthcare & Wellness', typical: '$120', range: '$60–$300', bar: 35 },
  { industry: 'Real Estate & Property', typical: '$650', range: '$300–$1,500', bar: 70 }
];

const webAppSchema = {
  "@type": "WebApplication",
  "@id": "https://freemarketingcalculator.com/cac-calculator/#app",
  "name": "CAC Calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "creator": { "@id": "https://freemarketingcalculator.com/#org" },
  "url": "https://freemarketingcalculator.com/cac-calculator/",
  "description": "Free Customer Acquisition Cost (CAC) calculator that divides spend by new customers and optionally estimates the payback period from monthly revenue per customer and gross margin.",
  "featureList": ["CAC from spend and new customers", "Optional payback period", "Sourced SaaS CAC benchmarks", "Free, no signup"]
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a.replace(/<[^>]+>/g, '') }
  }))
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
    { "@type": "ListItem", "position": 2, "name": "CAC Calculator", "item": "https://freemarketingcalculator.com/cac-calculator/" }
  ]
};
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your total sales and marketing spend for the period." },
{ "@type": "HowToStep", "position": 2, "text": "Enter the number of new customers acquired in that period." },
{ "@type": "HowToStep", "position": 3, "text": "Click Calculate CAC to see your cost per acquisition. Optionally enter monthly revenue per customer and gross margin to see the payback period." }
] };
---

<Base
  title={title}
  description={description}
  slug={slug}
  schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}
>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">CAC Calculator — Customer Acquisition Cost</h1>
      <p class="citation">
        Calculate your Customer Acquisition Cost (CAC) from sales and marketing spend and new customers, add an optional payback period, and compare with planning ranges by industry.
      </p>
      <div class="meta-badges">
        <span class="badge">✓ CAC + payback period</span>
        <span class="badge">✓ Planning ranges</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator" aria-label="CAC calculator tool">
      <div class="calc-card__header">
        <div class="calc-card__header-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div>
          <div class="calc-card__title">CAC Calculator</div>
          <div class="calc-card__subtitle">Enter total spend & acquired customers</div>
        </div>
      </div>

      <div class="calc-card__body">
        <div class="field-group">
          <div class="field">
            <label for="cac-spend">Total Sales & Marketing Spend</label>
            <div class="input-wrap">
              <span class="input-prefix">$</span>
              <input type="number" id="cac-spend" class="has-prefix" placeholder="e.g. 50000" min="0" value="50000" />
            </div>
            <div class="range-wrap">
              <input type="range" id="cac-spend-slider" class="range-slider" min="1000" max="250000" step="1000" value="50000" />
            </div>
          </div>

          <div class="field">
            <label for="cac-customers">New Customers Acquired</label>
            <div class="input-wrap">
              <input type="number" id="cac-customers" placeholder="e.g. 250" min="1" value="250" />
            </div>
            <div class="range-wrap">
              <input type="range" id="cac-customers-slider" class="range-slider" min="10" max="2000" step="10" value="250" />
            </div>
          </div>
        </div>

        <div class="field-group">
          <div class="field">
            <label for="cac-arpu">Monthly Revenue per Customer (optional)</label>
            <div class="input-wrap">
              <span class="input-prefix">$</span>
              <input type="number" id="cac-arpu" class="has-prefix" placeholder="e.g. 60" min="0" />
            </div>
          </div>
          <div class="field">
            <label for="cac-margin">Gross Margin % (optional)</label>
            <div class="input-wrap">
              <input type="number" id="cac-margin" class="has-suffix" placeholder="e.g. 70" min="0" max="100" />
              <span class="input-suffix">%</span>
            </div>
          </div>
        </div>

        <button class="btn-calc" id="cac-calc-btn" type="button">Calculate CAC</button>

        <div class="result-panel" id="cac-result" aria-live="polite">
          <div class="result-panel__label">Customer Acquisition Cost (CAC)</div>
          <div class="result-panel__primary" id="cac-primary">$200.00</div>

          <div class="result-panel__grid">
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="cac-spend-display">$50,000</span>
              <span class="result-panel__stat-label">Total Spend</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="cac-count-display">250</span>
              <span class="result-panel__stat-label">Customers Acquired</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="cac-per-customer">$200.00</span>
              <span class="result-panel__stat-label">Cost per Customer</span>
            </div>
          </div>

          <div class="result-verdict" id="cac-verdict"></div>
          <div class="result-verdict" id="cac-payback" style="margin-top: var(--space-2);"></div>

          <div class="calc-action-bar">
            <button type="button" class="btn-tool-action" id="btn-share-link">🔗 Share Calculation Link</button>
            <button type="button" class="btn-tool-action" id="btn-print-summary">📄 Export Summary PDF</button>
          </div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">Definition</div>
      <p>
        <strong>Customer Acquisition Cost (CAC)</strong> is the total sales and marketing cost required to acquire a single new paying customer. It is a vital unit economic metric used to assess growth sustainability and marketing efficiency.
      </p>
    </div>

    <div class="formula-box">
      <p class="formula-title">CAC Formula</p>
      <p class="formula-text">CAC = Total Sales & Marketing Spend ÷ New Customers Acquired</p>
      <div class="formula-example">
        <strong>Example:</strong> $50,000 sales & marketing cost ÷ 250 customers = <strong>$200 CAC</strong>.
      </div>
    </div>

    <section class="bench-section">
      <h2>CAC by Industry: 2026 Planning Ranges</h2>
      <span class="bench-date">Updated October 2026</span>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead>
            <tr>
              <th>Industry</th>
              <th>Typical CAC</th>
              <th>Range</th>
              <th>Visual Benchmark</th>
            </tr>
          </thead>
          <tbody>
            {industryBenchmarks.map(row => (
              <tr>
                <td>{row.industry}</td>
                <td><strong>{row.typical}</strong></td>
                <td>{row.range}</td>
                <td>
                  <div class="bench-bar">
                    <div class="bench-bar__fill" style={`width: ${row.bar}%`}></div>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="bench-source">Planning ranges, not survey results. Actual CAC varies with price point, sales motion and channel mix, so replace these with your own figures from the calculator above.</p>
    </section>

    <section class="bench-section" aria-labelledby="cac-example-heading">
      <h2 id="cac-example-heading">CAC Worked Example: Blended CAC, Paid CAC and Payback</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">A business with $50,000 of sales and marketing spend and 250 new customers has a blended CAC of $200, and the same business can have a paid CAC of $300. The calculator divides any spend figure by any customer count, so run it once for each version.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th>Measure</th><th>Calculation</th><th>Result</th></tr></thead>
          <tbody>
            <tr><td>Blended CAC</td><td>$50,000 total spend ÷ 250 customers</td><td><strong>$200</strong></td></tr>
            <tr style="background:var(--off-white)"><td>Paid CAC</td><td>$30,000 ad spend ÷ 100 paid customers</td><td><strong>$300</strong></td></tr>
            <tr><td>Monthly gross profit per customer</td><td>$60 revenue × 70% margin</td><td><strong>$42</strong></td></tr>
            <tr style="background:var(--off-white)"><td>CAC payback</td><td>$200 ÷ $42</td><td><strong>4.8 months</strong></td></tr>
            <tr><td>LTV (20-month lifetime)</td><td>$42 × 20</td><td><strong>$840</strong></td></tr>
            <tr style="background:var(--off-white)"><td>LTV:CAC</td><td>$840 ÷ $200</td><td><strong>4.2:1</strong></td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">The 20-month customer lifetime is an illustrative assumption. Compare the LTV:CAC result with the 3:1 benchmark in the FAQ below, and check the return on the same spend with the <a href="/marketing-roi-calculator/">Marketing ROI Calculator</a>.</p>
    </section>

    <div style="background: var(--off-white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-6); margin: var(--space-8) 0;">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-3);">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">Customer acquisition cost is one of the metrics defined in the <a href="/blog/digital-marketing-metrics-guide/">Digital Marketing Metrics Guide</a>. To judge whether a CAC is sustainable, compare it with returns in the <a href="/marketing-roi-calculator/">Marketing ROI Calculator</a>, or work backwards from a revenue goal with the <a href="/inbound-marketing-calculator/">Inbound Marketing Calculator</a>.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3);"><a href="/blog/digital-marketing-metrics-guide/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Digital Marketing Metrics Guide →</a><a href="/marketing-roi-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Marketing ROI Calculator →</a><a href="/inbound-marketing-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Inbound Marketing Calculator →</a><a href="/conversion-rate-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Conversion Rate Calculator →</a></div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script type="module">
import { setupSliderSync, copyShareableURL, parseURLParams, printReport } from '../scripts/calc-utils.js';

(function() {
  'use strict';
  const spendInput     = document.getElementById('cac-spend');
  const customersInput = document.getElementById('cac-customers');
  const calcBtn        = document.getElementById('cac-calc-btn');
  const resultPanel    = document.getElementById('cac-result');
  const primaryEl      = document.getElementById('cac-primary');
  const spendDispEl    = document.getElementById('cac-spend-display');
  const countDispEl    = document.getElementById('cac-count-display');
  const perCustEl      = document.getElementById('cac-per-customer');
  const verdictEl      = document.getElementById('cac-verdict');
  const paybackEl      = document.getElementById('cac-payback');
  const arpuInput      = document.getElementById('cac-arpu');
  const marginInput    = document.getElementById('cac-margin');
  const shareBtn       = document.getElementById('btn-share-link');
  const printBtn       = document.getElementById('btn-print-summary');

  if (!calcBtn || !resultPanel) return;

  setupSliderSync('cac-spend', 'cac-spend-slider', calculate);
  setupSliderSync('cac-customers', 'cac-customers-slider', calculate);

  function calculate() {
    const spend     = parseFloat(spendInput.value) || 0;
    const customers = parseFloat(customersInput.value) || 0;
    if (customers <= 0) return;

    const cac = spend / customers;

    primaryEl.textContent   = `$${cac.toFixed(2)}`;
    spendDispEl.textContent = '$' + Math.round(spend).toLocaleString();
    countDispEl.textContent = customers.toLocaleString();
    perCustEl.textContent   = `$${cac.toFixed(2)}`;

    if (cac < 50)       verdictEl.textContent = '🟢 Low CAC — excellent unit economics for B2C/eCommerce';
    else if (cac < 350) verdictEl.textContent = '✅ Healthy CAC — standard range for SMB SaaS and B2B';
    else                verdictEl.textContent = '📊 High CAC — ensure LTV justifies acquisition cost';

    const arpu   = parseFloat(arpuInput.value) || 0;
    const margin = parseFloat(marginInput.value) || 0;
    if (arpu > 0 && margin > 0) {
      const monthlyProfit = arpu * (margin / 100);
      const months = cac / monthlyProfit;
      paybackEl.textContent = `⏱ CAC payback: ${months.toFixed(1)} months ($${cac.toFixed(2)} ÷ $${monthlyProfit.toFixed(2)} monthly gross profit per customer)`;
    } else {
      paybackEl.textContent = '';
    }

    resultPanel.classList.add('visible');
  }

  calcBtn.addEventListener('click', calculate);
  [spendInput, customersInput, arpuInput, marginInput].forEach(el => el.addEventListener('input', calculate));
  if (shareBtn) shareBtn.addEventListener('click', () => copyShareableURL({ spend: spendInput.value, cust: customersInput.value, arpu: arpuInput.value, gm: marginInput.value }));
  if (printBtn) printBtn.addEventListener('click', printReport);

  parseURLParams({ spend: spendInput, cust: customersInput, arpu: arpuInput, gm: marginInput });
  calculate();
})();
</script>
