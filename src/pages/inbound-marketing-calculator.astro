---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'inbound-marketing-calculator';
const title       = 'Inbound Marketing Calculator — Leads, Traffic and ROI 2026';
const description = 'Calculate how much traffic, leads, and MQLs your inbound marketing program needs. Enter revenue goals and conversion benchmarks to get monthly targets.';

const faqItems = [
  { q: 'How do I calculate inbound marketing goals?', a: 'Work backwards from revenue: divide revenue goal by average deal size to get customers needed. Divide customers by close rate to get SQLs. Divide SQLs by MQL-to-SQL rate to get MQLs. Divide MQLs by lead-to-MQL rate to get leads. Divide leads by CVR to get traffic.' },
  { q: 'What is a good inbound lead conversion rate?', a: 'The calculator defaults are planning ranges: visitor-to-lead 2-3%, lead-to-MQL 30-40%, MQL-to-SQL 20-30% and SQL-to-customer 20-30%. Unbounce 2024 Conversion Benchmark Report, covering 41,000+ landing pages, found median landing page conversion of 3.8% for SaaS and 6.1% for professional services. Whole-site visitor-to-lead rates are usually lower than landing page rates because most visitors never reach a conversion page.' },
  { q: 'How long does inbound marketing take to produce leads?', a: 'SEO-based inbound commonly takes 6-12 months to build meaningful traffic, and content marketing often shows early results in 3-6 months. Timelines depend on competition, publishing volume and domain authority. Because inbound content keeps working after it is published, the same investment can produce more leads in later months, but the size of that effect varies by business.' },
  { q: 'How much does it cost to generate the traffic this calculator shows?', a: 'Inbound programs typically cost $5,000-$20,000 per month when run by an agency, according to Protocol 80, with freelancer and in-house models priced differently. The Inbound Marketing Cost guide at freemarketingcalculator.com/blog/inbound-marketing-cost/ breaks down pricing by model and channel, with three sample budgets. Compare the traffic target with that cost to estimate cost per lead.' },
  { q: 'What is MQL vs SQL in inbound marketing?', a: 'MQL (Marketing Qualified Lead) meets criteria suggesting sales readiness (job title, company size, behaviour score). SQL (Sales Qualified Lead) has been reviewed by sales and accepted as a genuine opportunity. Both should be defined clearly in your CRM.' },
  { q: 'Is this calculator free?', a: 'Yes — completely free, no signup, no email required.' },
];

const webAppSchema = { "@type": "WebApplication", "name": title, "applicationCategory": "BusinessApplication", "operatingSystem": "Any", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "creator": { "@id": "https://freemarketingcalculator.com/#org" }, "url": "https://freemarketingcalculator.com/inbound-marketing-calculator/", "description": "Reverse-funnel calculator that converts a monthly revenue goal into required traffic, leads, MQLs, and SQLs using stage-by-stage conversion rate benchmarks.", "featureList": ["Reverse-funnel calculation", "MQL/SQL targets", "Traffic needed calculation"] };
const faqSchema = { "@type": "FAQPage", "mainEntity": faqItems.map(i => ({ "@type": "Question", "name": i.q, "acceptedAnswer": { "@type": "Answer", "text": i.a } })) };
const breadcrumbSchema = { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" }, { "@type": "ListItem", "position": 2, "name": "Inbound Marketing Calculator", "item": "https://freemarketingcalculator.com/inbound-marketing-calculator/" }] };
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your monthly revenue goal and average deal or contract value." },
{ "@type": "HowToStep", "position": 2, "text": "Fill in your funnel conversion rates: SQL-to-customer, MQL-to-SQL, lead-to-MQL, and visitor-to-lead." },
{ "@type": "HowToStep", "position": 3, "text": "Click Calculate \u2014 you get the exact monthly traffic, leads, MQLs, and SQLs needed to hit your goal." }
] };
---

<Base title={title} description={description} slug={slug} schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Marketing Tool</p>
      <h1 id="page-h1">Inbound Marketing Calculator</h1>
      <p class="citation">A reverse-funnel calculator: enter a monthly revenue goal and your funnel conversion rates to get the exact monthly traffic, leads, MQLs, and SQLs you need to hit your target.</p>
      <div class="meta-badges">
        <span class="badge">✓ Full funnel reverse calc</span>
        <span class="badge">✓ MQL & SQL targets</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator">
      <div class="calc-card__header">
        <div class="calc-card__header-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div><div class="calc-card__title">Inbound Marketing Funnel Calculator</div><div class="calc-card__subtitle">Start with your revenue goal — get your monthly targets</div></div>
      </div>
      <div class="calc-card__body">
        <div class="field-group">
          <div class="field"><label for="ib-revenue">Monthly Revenue Goal ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="ib-revenue" class="has-prefix" placeholder="e.g. 50000" min="0"/></div></div>
          <div class="field"><label for="ib-deal">Average Deal / Contract Value ($)</label><div class="input-wrap"><span class="input-prefix">$</span><input type="number" id="ib-deal" class="has-prefix" placeholder="e.g. 5000" min="0"/></div></div>
          <div class="field"><label for="ib-close">SQL → Customer Close Rate (%)</label><div class="input-wrap"><input type="number" id="ib-close" class="has-suffix" placeholder="e.g. 25" min="0" max="100"/><span class="input-suffix">%</span></div><p class="hint">Planning range: 20–30% for B2B</p></div>
          <div class="field"><label for="ib-mql-sql">MQL → SQL Rate (%)</label><div class="input-wrap"><input type="number" id="ib-mql-sql" class="has-suffix" placeholder="e.g. 25" min="0" max="100"/><span class="input-suffix">%</span></div><p class="hint">Planning range: 20–30%</p></div>
          <div class="field"><label for="ib-lead-mql">Lead → MQL Rate (%)</label><div class="input-wrap"><input type="number" id="ib-lead-mql" class="has-suffix" placeholder="e.g. 35" min="0" max="100"/><span class="input-suffix">%</span></div><p class="hint">Planning range: 30–40%</p></div>
          <div class="field"><label for="ib-visit-lead">Visitor → Lead CVR (%)</label><div class="input-wrap"><input type="number" id="ib-visit-lead" class="has-suffix" placeholder="e.g. 2.5" min="0" max="100" step="0.1"/><span class="input-suffix">%</span></div><p class="hint">Planning range: 2–3% for organic traffic</p></div>
        </div>
        <button class="btn-calc" id="ib-calc-btn" type="button">Calculate My Inbound Targets</button>
        <div class="result-panel" id="ib-result" aria-live="polite">
          <div class="result-panel__label">Monthly Traffic Needed</div>
          <div class="result-panel__primary" id="ib-traffic">0</div>
          <div class="result-panel__grid">
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ib-leads-needed">0</span><span class="result-panel__stat-label">Leads needed</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ib-mqls-needed">0</span><span class="result-panel__stat-label">MQLs needed</span></div>
            <div class="result-panel__stat"><span class="result-panel__stat-value" id="ib-sqls-needed">0</span><span class="result-panel__stat-label">SQLs needed</span></div>
          </div>
          <div class="result-verdict" id="ib-verdict"></div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">How the Reverse Funnel Works</div>
      <p>
        <strong>Customers needed</strong> = Revenue Goal ÷ Deal Value<br/>
        <strong>SQLs needed</strong> = Customers ÷ Close Rate<br/>
        <strong>MQLs needed</strong> = SQLs ÷ MQL-to-SQL Rate<br/>
        <strong>Leads needed</strong> = MQLs ÷ Lead-to-MQL Rate<br/>
        <strong>Traffic needed</strong> = Leads ÷ Visitor-to-Lead CVR
      </p>
    </div>


    <section class="bench-section" aria-labelledby="ib-example-heading">
      <h2 id="ib-example-heading">Inbound Funnel Worked Example: From $50,000 to 18,286 Visitors</h2>
      <p style="color: var(--text-mid); margin: var(--space-2) 0 var(--space-4);">A $50,000 monthly revenue goal with a $5,000 deal value needs 10 customers, which at the default funnel rates means about 18,286 visitors a month. The calculator rounds each stage up to a whole number.</p>
      <div class="bench-table-wrap">
        <table class="bench-table">
          <thead><tr><th scope="col">Stage</th><th scope="col">Calculation</th><th scope="col">Needed per month</th></tr></thead>
          <tbody>
            <tr><td>Customers</td><td>$50,000 ÷ $5,000</td><td><strong>10</strong></td></tr>
            <tr style="background:var(--off-white)"><td>SQLs</td><td>10 ÷ 25% close rate</td><td><strong>40</strong></td></tr>
            <tr><td>MQLs</td><td>40 ÷ 25% MQL-to-SQL</td><td><strong>160</strong></td></tr>
            <tr style="background:var(--off-white)"><td>Leads</td><td>160 ÷ 35% lead-to-MQL</td><td><strong>458</strong></td></tr>
            <tr><td>Visitors</td><td>457.1 ÷ 2.5% visitor-to-lead</td><td><strong>18,286</strong></td></tr>
          </tbody>
        </table>
      </div>
      <p class="bench-source">Raising visitor-to-lead conversion from 2.5% to 3.5% cuts the traffic needed from 18,286 to 13,062 visitors a month, a 29% reduction, without changing any other stage. Test your own rates with the <a href="/conversion-rate-calculator/">Conversion Rate Calculator</a>, then price the result with the <a href="/blog/inbound-marketing-cost/">Inbound Marketing Cost guide</a>.</p>
    </section>

    <!-- TASK 25: How to use this calculator -->
    <div class="definition-box" style="margin-top: var(--space-8);">
      <div class="definition-box__label">How to Use This Inbound Marketing Calculator</div>
      <p style="white-space: pre-line; line-height: 1.9;">1. Enter your monthly revenue goal. 2. Enter your average deal or contract value. 3. Fill in your funnel conversion rates: SQL-to-customer close rate, MQL-to-SQL rate, lead-to-MQL rate, and visitor-to-lead CVR. 4. Click Calculate — you get the exact monthly traffic, leads, MQLs, and SQLs needed to hit your goal.</p>
      <div class="formula-example" style="margin-top: var(--space-3);">
        <strong>Example:</strong> Example: $50,000/month revenue goal, $5,000 deal value. Customers needed = 10. At 25% close rate = 40 SQLs. At 25% MQL→SQL = 160 MQLs. At 35% lead→MQL = 458 leads. At 2.5% visitor→lead = 18,286 visitors/month needed.
      </div>
    </div>

    <div style="background: var(--teal-faint); border: 1.5px solid rgba(0,196,179,.25); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
      <p style="color: var(--navy); font-weight: 600; margin:0; font-size: var(--text-sm);">📖 How Much Does Inbound Marketing Cost? 2026 pricing by model and channel →</p>
      <a href="/blog/inbound-marketing-cost/" style="background: var(--teal); color: var(--navy); font-weight: 700; font-size: var(--text-sm); padding: var(--space-2) var(--space-5); border-radius: var(--radius); text-decoration:none; white-space:nowrap;">Read now →</a>
    </div>

    <div style="background: var(--off-white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-6); margin: var(--space-8) 0;">
      <p style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-mid); margin-bottom: var(--space-3);">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">Turning traffic into revenue depends on conversion rates and acquisition cost. Check your rates with the <a href="/conversion-rate-calculator/">Conversion Rate Calculator</a>, price each customer with the <a href="/cac-calculator/">CAC Calculator</a>, and see the <a href="/blog/digital-marketing-metrics-guide/">Digital Marketing Metrics Guide</a> for definitions.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-3);"><a href="/conversion-rate-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Conversion Rate Calculator →</a><a href="/cac-calculator/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">CAC Calculator →</a><a href="/blog/digital-marketing-metrics-guide/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Digital Marketing Metrics Guide →</a><a href="/marketing-budget-benchmarks/" style="display:block; padding: var(--space-3) var(--space-4); background: white; border-radius: var(--radius); border: 1px solid var(--border); text-decoration: none; color: var(--navy); font-weight: 600; font-size: var(--text-sm);">Marketing Budget Benchmarks →</a></div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script>
(function(){
  'use strict';
  const btn = document.getElementById('ib-calc-btn');
  const result = document.getElementById('ib-result');
  if (!btn) return;
  btn.addEventListener('click', () => {
    const revenue    = parseFloat((document.getElementById('ib-revenue') as HTMLInputElement).value) || 0;
    const deal       = parseFloat((document.getElementById('ib-deal') as HTMLInputElement).value) || 1;
    const closeRate  = parseFloat((document.getElementById('ib-close') as HTMLInputElement).value) / 100 || 0.25;
    const mqlSql     = parseFloat((document.getElementById('ib-mql-sql') as HTMLInputElement).value) / 100 || 0.25;
    const leadMql    = parseFloat((document.getElementById('ib-lead-mql') as HTMLInputElement).value) / 100 || 0.35;
    const visitLead  = parseFloat((document.getElementById('ib-visit-lead') as HTMLInputElement).value) / 100 || 0.025;
    if (!revenue) return;
    const customers = revenue / deal;
    const sqls      = customers / closeRate;
    const mqls      = sqls / mqlSql;
    const leads     = mqls / leadMql;
    const traffic   = leads / visitLead;
    document.getElementById('ib-traffic').textContent       = Math.ceil(traffic).toLocaleString();
    document.getElementById('ib-leads-needed').textContent  = Math.ceil(leads).toLocaleString();
    document.getElementById('ib-mqls-needed').textContent   = Math.ceil(mqls).toLocaleString();
    document.getElementById('ib-sqls-needed').textContent   = Math.ceil(sqls).toLocaleString();
    document.getElementById('ib-verdict').textContent       =
      '📊 To earn $' + revenue.toLocaleString() + '/month: ' + Math.ceil(traffic).toLocaleString() + ' visitors → ' + Math.ceil(leads) + ' leads → ' + Math.ceil(mqls) + ' MQLs → ' + Math.ceil(sqls) + ' SQLs → ' + Math.ceil(customers) + ' customers';
    result.classList.add('visible');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>
