---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';

const slug        = 'roas-calculator';
const title       = 'ROAS Calculator — Free Return on Ad Spend Tool (2026)';
const description = 'Calculate ROAS as a multiplier and percentage. Compare revenue return with contribution-margin break-even examples. Free, with no signup.';

const faqItems = [
  {
    q: 'How do you calculate ROAS?',
    a: '<strong>ROAS = (Revenue generated from ads ÷ Total ad spend) × 100</strong> (or expressed as a multiplier like 4x / 400%). For example: $20,000 ad revenue from $5,000 ad spend → $20,000 ÷ $5,000 = <strong>4.0x ROAS (400%)</strong>.'
  },
  {
    q: 'What is a good ROAS?',
    a: 'A good ROAS depends on contribution margin, attribution and payback period. A 25% contribution margin before ads requires 4x ROAS to cover advertising; a 20% margin requires 5x. Fixed costs and excluded variable costs can raise the requirement.'
  },
  {
    q: 'What is the difference between ROAS and ROI?',
    a: '<strong>ROAS</strong> measures revenue per dollar of direct ad spend (Revenue ÷ Ad Spend). <strong>ROI</strong> accounts for total costs including agency fees, software, COGS, and overhead ((Revenue − Total costs) ÷ Total costs × 100).'
  },
  {
    q: 'How do you calculate Target ROAS?',
    a: '<strong>Target ROAS = 1 ÷ Gross Margin %</strong>. If your gross profit margin is 25%, your break-even Target ROAS is 1 ÷ 0.25 = 400% (4.0x). Above 4.0x, contribution after advertising is positive only for the costs included in that margin; uncounted overhead can still eliminate profit.'
  }
];



const webAppSchema = {
  "@type": "WebApplication",
  "@id": "https://freemarketingcalculator.com/roas-calculator/#app",
  "name": "ROAS Calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "creator": { "@id": "https://freemarketingcalculator.com/#org" },
  "url": "https://freemarketingcalculator.com/roas-calculator/",
  "description": "Free return on ad spend calculator with multiplier, percentage and contribution-margin break-even examples.",
  "featureList": ["ROAS multiplier formula", "Break-even ROAS examples", "Contribution-margin comparison", "Free, no signup"]
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a.replace(/<[^>]+>/g, '') }
  }))
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freemarketingcalculator.com/" },
    { "@type": "ListItem", "position": 2, "name": "ROAS Calculator", "item": "https://freemarketingcalculator.com/roas-calculator/" }
  ]
};
const howToSchema = { "@type": "HowTo", "name": `How to Use ${title}`, "description": description, "step": [
{ "@type": "HowToStep", "position": 1, "text": "Enter your total ad spend." },
{ "@type": "HowToStep", "position": 2, "text": "Enter the revenue generated from those ads." },
{ "@type": "HowToStep", "position": 3, "text": "Click Calculate ROAS to see your return on ad spend as a percentage and multiplier." }
] };
---

<Base
  title={title}
  description={description}
  slug={slug}
  schema={[webAppSchema, howToSchema, faqSchema, breadcrumbSchema]}
>
  <section class="page-hero" aria-labelledby="page-h1">
    <div class="container">
      <p class="eyebrow">Free Advertising Tool</p>
      <h1 id="page-h1">ROAS Calculator — Return on Ad Spend</h1>
      <p class="citation">
        Calculate return on ad spend as a multiplier and percentage. Use the margin examples below to understand the revenue return needed to cover advertising.
      </p>
      <div class="meta-badges">
        <span class="badge">✓ Multiplier & % modes</span>
        <span class="badge">✓ 2026 Benchmarks</span>
        <span class="badge">✓ No signup</span>
      </div>
      <a href="#calculator" class="btn-hero-cta">Start Calculating <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></a>
    </div>
  </section>

  <div class="container">
    <div class="calc-card" id="calculator" aria-label="ROAS calculator tool">
      <div class="calc-card__header">
        <div class="calc-card__header-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <div>
          <div class="calc-card__title">ROAS Calculator</div>
          <div class="calc-card__subtitle">Enter ad spend & revenue generated</div>
        </div>
      </div>

      <div class="calc-card__body">
        <div class="field-group">
          <div class="field">
            <label for="ad-spend">Total Ad Spend</label>
            <div class="input-wrap">
              <span class="input-prefix">$</span>
              <input type="number" id="ad-spend" class="has-prefix" placeholder="e.g. 5000" min="0" value="5000" />
            </div>
            <div class="range-wrap">
              <input type="range" id="ad-spend-slider" class="range-slider" min="500" max="50000" step="500" value="5000" />
            </div>
          </div>

          <div class="field">
            <label for="ad-revenue">Revenue Generated from Ads</label>
            <div class="input-wrap">
              <span class="input-prefix">$</span>
              <input type="number" id="ad-revenue" class="has-prefix" placeholder="e.g. 20000" min="0" value="20000" />
            </div>
            <div class="range-wrap">
              <input type="range" id="ad-revenue-slider" class="range-slider" min="1000" max="200000" step="1000" value="20000" />
            </div>
          </div>
        </div>

        <button class="btn-calc" id="roas-calc-btn" type="button">Calculate ROAS</button>

        <div class="result-panel" id="roas-result" aria-live="polite">
          <div class="result-panel__label">Return on Ad Spend (ROAS)</div>
          <div class="result-panel__primary" id="roas-primary">400% (4.0x)</div>

          <div class="result-panel__grid">
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="roas-net-profit">$15,000</span>
              <span class="result-panel__stat-label">Revenue less ad spend</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="roas-multiplier">4.0x</span>
              <span class="result-panel__stat-label">ROAS Multiplier</span>
            </div>
            <div class="result-panel__stat">
              <span class="result-panel__stat-value" id="roas-per-dollar">$4.00</span>
              <span class="result-panel__stat-label">Return per $1 Spent</span>
            </div>
          </div>

          <div class="calc-chart-box">
            <div class="calc-chart-box__title">Ad Revenue Breakdown</div>
            <div class="calc-chart-bar-wrap">
              <div class="calc-chart-segment calc-chart-segment--cost" id="chart-spend-bar" style="width: 25%;"></div>
              <div class="calc-chart-segment calc-chart-segment--profit" id="chart-profit-bar" style="width: 75%;"></div>
            </div>
          </div>

          <div class="result-verdict" id="roas-verdict"></div>

          <div class="calc-action-bar">
            <button type="button" class="btn-tool-action" id="btn-share-link">🔗 Share Calculation Link</button>
            <button type="button" class="btn-tool-action" id="btn-print-summary">📄 Export Summary PDF</button>
          </div>
        </div>
      </div>
    </div>

    <div class="definition-box">
      <div class="definition-box__label">Definition</div>
      <p>
        <strong>Return on Ad Spend (ROAS)</strong> measures the gross revenue generated for every dollar spent on advertising.
        It is the fundamental metric used by performance marketers to evaluate ad campaign profitability on platforms like Google Ads, Meta Ads, and TikTok.
      </p>
    </div>

    <div class="formula-box">
      <p class="formula-title">ROAS Formula</p>
      <p class="formula-text">ROAS = (Ad Revenue ÷ Ad Spend) × 100</p>
      <div class="formula-example">
        <strong>Example:</strong> $20,000 revenue generated from a $5,000 Google Ads campaign = ($20,000 ÷ $5,000) × 100 = <strong>400% ROAS (4.0x)</strong>.
      </div>
    </div>

    <section class="bench-section" aria-labelledby="roas-margin"><h2 id="roas-margin">Break-Even ROAS by Contribution Margin</h2><p>Break-even ROAS = 1 ÷ contribution margin before advertising, written as a decimal. These arithmetic scenarios cover only the costs included in the margin. They are not ad-platform or industry averages.</p><div class="bench-table-wrap"><table class="bench-table"><thead><tr><th scope="col">Contribution margin before ads</th><th scope="col">Break-even revenue return</th></tr></thead><tbody><tr><td>20%</td><td>5x / 500%</td></tr><tr><td>25%</td><td>4x / 400%</td></tr><tr><td>40%</td><td>2.5x / 250%</td></tr><tr><td>60%</td><td>1.67x / about 167%</td></tr></tbody></table></div><p>At 4x ROAS, $1,000 ad spend generates $4,000 revenue. A 25% contribution margin leaves $1,000 before ads, exactly covering the spend. A 20% margin leaves only $800, a $200 shortfall before fixed overhead. Use contribution after product, payment and fulfilment costs; gross margin that excludes these costs can overstate the affordable ad spend.</p><p>Enter your own margin, or build it from revenue, shipping and fees, in the <a href="/break-even-roas-calculator/">break-even ROAS calculator</a>. It shows the threshold for your included costs rather than assuming a universal target.</p></section>

    <div class="related-box">
      <p class="related-box__label">Related Guides &amp; Calculators</p>
      <p style="color: var(--text-mid); margin-bottom: var(--space-4);">ROAS measures revenue per ad dollar, while ROMI and ROI include costs beyond ad spend. The <a href="/blog/romi-calculator-formula/">ROMI Formula Guide</a> explains the difference, <a href="/blog/what-is-ad-spend/">What Is Ad Spend?</a> defines what counts as ad spend, and the <a href="/marketing-roi-calculator/">Marketing ROI Calculator</a> adds cost of goods sold.</p>
      <div class="link-grid"><a href="/blog/what-is-ad-spend/" class="link-tile">What Is Ad Spend? →</a><a href="/blog/romi-calculator-formula/" class="link-tile">ROMI Formula Guide →</a><a href="/marketing-roi-calculator/" class="link-tile">Marketing ROI Calculator →</a><a href="/digital-marketing-calculator/" class="link-tile">Digital Marketing Calculator →</a></div>
    </div>

    <FAQ items={faqItems} />
  </div>
</Base>

<script type="module">
import { validateCalculator } from '../scripts/calc-validation.js';
import { setupSliderSync, copyShareableURL, parseURLParams, printReport } from '../scripts/calc-utils.js';

(function() {
  'use strict';
  const spendInput  = document.getElementById('ad-spend');
  const revInput    = document.getElementById('ad-revenue');
  const calcBtn     = document.getElementById('roas-calc-btn');
  const resultPanel = document.getElementById('roas-result');
  const primaryEl   = document.getElementById('roas-primary');
  const profitEl    = document.getElementById('roas-net-profit');
  const multEl      = document.getElementById('roas-multiplier');
  const perDollarEl = document.getElementById('roas-per-dollar');
  const verdictEl   = document.getElementById('roas-verdict');
  const spendBar    = document.getElementById('chart-spend-bar');
  const profitBar   = document.getElementById('chart-profit-bar');
  const shareBtn    = document.getElementById('btn-share-link');
  const printBtn    = document.getElementById('btn-print-summary');

  if (!calcBtn || !resultPanel) return;

  setupSliderSync('ad-spend', 'ad-spend-slider', calculate);
  setupSliderSync('ad-revenue', 'ad-revenue-slider', calculate);

  function calculate() {
    if (!validateCalculator(calcBtn)) return;
    const spend = parseFloat(spendInput.value) || 0;
    const rev   = parseFloat(revInput.value) || 0;
    if (spend <= 0) return;

    const roasPct  = (rev / spend) * 100;
    const mult     = (rev / spend).toFixed(2);
    const netProfit = rev - spend;

    primaryEl.textContent   = `${roasPct.toFixed(0)}% (${mult}x)`;
    profitEl.textContent    = (netProfit < 0 ? '-$' : '$') + Math.abs(Math.round(netProfit)).toLocaleString();
    multEl.textContent      = `${mult}x`;
    perDollarEl.textContent  = `$${mult}`;

    verdictEl.textContent = roasPct < 100 ? 'Ad spend exceeds attributed revenue, before other costs.' : 'Revenue return alone does not establish profit. Compare with contribution margin and fully loaded costs.';

    if (spendBar && profitBar) {
      const total = Math.max(rev, spend + 1);
      const spendPct = Math.min((spend / total) * 100, 95);
      spendBar.style.width  = spendPct + '%';
      profitBar.style.width = (100 - spendPct) + '%';
    }

    resultPanel.classList.add('visible');
  }

  calcBtn.addEventListener('click', calculate);
  [spendInput, revInput].forEach(el => el.addEventListener('input', calculate));
  if (shareBtn) shareBtn.addEventListener('click', () => copyShareableURL({ spend: spendInput.value, rev: revInput.value }));
  if (printBtn) printBtn.addEventListener('click', printReport);

  parseURLParams({ spend: spendInput, rev: revInput });
  calculate();
})();
</script>
